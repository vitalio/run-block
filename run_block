def offer_clipboard_copy(
    label: str,
    out_path: Path,
    ok: bool = True,
    rc: int | None = None,
    title_kind: str = "END STEP",
    extra_lines: list[str] | None = None,
    duration_s: float | None = None,
    op_timings: list[dict[str, object]] | None = None,
    failed_step: int | None = None,
    sdir: Path | None = None,
) -> None:
    if in_run_block():
        return
    mode = clipboard_mode()
    if mode == "never":
        return
    is_start_bundle = title_kind.strip() == "START SESSION"
    is_end_box = title_kind.strip() == "END STEP"
    edit_target = out_path
    copy_target = edit_target
    if is_end_box and edit_target.is_file():
        try:
            copy_target = resolve_clipboard_target(
                edit_target, edit_target.read_text(encoding="utf-8", errors="replace")
            )
        except OSError:
            copy_target = edit_target
    clip = clipboard_command(copy_target)
    if clip is None:
        return
    cmd, cmd_str = clip
    if mode == "auto":
        if copy_file_to_clipboard(cmd, copy_target):
            sys.stdout.write(f"✓ Copied {copy_target} to clipboard.\n")
        else:
            sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    if not sys.stdout.isatty():
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    orig_path = _orig_file_backup_path(edit_target)
    is_edited = _is_file_edited(edit_target, orig_path)
    resolved_sdir = sdir if sdir is not None else _resolve_session_dir(label, edit_target)
    step_script = None if is_start_bundle else _resolve_info_step_script(label, resolved_sdir, None, edit_target)
    prev_cols, prev_rows = _term_size()
    box, rule_width, cursor_offset = format_clipboard_box(
        label,
        copy_target,
        ok=ok,
        rc=rc,
        stats=stats_line(copy_target),
        title_kind=title_kind,
        extra_lines=extra_lines,
        cmd_str=cmd_str,
        edited=is_edited,
        error_source=edit_target,
        duration_s=duration_s,
        op_timings=op_timings,
        failed_step=failed_step,
        bundle_details=False,
        sdir=sdir,
        term_cols=prev_cols,
        term_rows=max(6, prev_rows - 1),
    )
    _, border_col = _block_colors(title_kind, has_exit=(rc is not None and rc != 0))
    bottom = _format_bottom_rule(rule_width, border_color=border_col)
    occ_lines = box.splitlines()
    prefixed_line2 = (
        occ_lines[-2] if len(occ_lines) >= 2 else _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
    )
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"\n{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()

            def _on_clip_edit(edited_path: Path) -> dict[str, object]:
                nonlocal copy_target, cmd, cmd_str, is_edited
                if is_start_bundle:
                    fn_refresh = globals().get("refresh_bundle_meta")
                    if callable(fn_refresh):
                        fn_refresh(edited_path)
                elif edited_path == edit_target:
                    try:
                        after_text = edited_path.read_text(encoding="utf-8", errors="replace")
                    except OSError:
                        after_text = ""
                    if is_end_box:
                        copy_target = resolve_clipboard_target(edit_target, after_text)
                    else:
                        copy_target = edit_target
                    new_clip = clipboard_command(copy_target)
                    if new_clip is not None:
                        cmd, cmd_str = new_clip
                is_edited = _is_file_edited(edit_target, orig_path)
                return {"edited": is_edited}

            def _redraw_box() -> None:
                nonlocal box, rule_width, cursor_offset, bottom, prev_cols, prev_rows
                new_cols, new_rows = _term_size()
                up_rows = _box_rows_above_prompt(box, new_cols)
                prev_cols, prev_rows = new_cols, new_rows
                box, rule_width, cursor_offset = format_clipboard_box(
                    label,
                    copy_target,
                    ok=ok,
                    rc=rc,
                    stats=stats_line(copy_target),
                    title_kind=title_kind,
                    extra_lines=extra_lines,
                    cmd_str=cmd_str,
                    edited=is_edited,
                    error_source=edit_target,
                    duration_s=duration_s,
                    op_timings=op_timings,
                    failed_step=failed_step,
                    bundle_details=False,
                    sdir=sdir,
                    term_cols=new_cols,
                    term_rows=max(6, new_rows - 1),
                )
                bottom = _format_bottom_rule(rule_width, border_color=border_col)
                move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                tty_w.flush()

            first_read = True
            while True:
                action = read_clipboard_key(tty_r, flush=first_read)
                first_read = False
                if action == "resize":
                    new_cols, new_rows = _term_size()
                    if (new_cols, new_rows) != (prev_cols, prev_rows):
                        up_rows = _box_rows_above_prompt(box, new_cols)
                        prev_cols, prev_rows = new_cols, new_rows
                        box, rule_width, cursor_offset = format_clipboard_box(
                            label,
                            copy_target,
                            ok=ok,
                            rc=rc,
                            stats=stats_line(copy_target),
                            title_kind=title_kind,
                            extra_lines=extra_lines,
                            cmd_str=cmd_str,
                            edited=is_edited,
                            error_source=edit_target,
                            duration_s=duration_s,
                            op_timings=op_timings,
                            failed_step=failed_step,
                            bundle_details=False,
                            sdir=sdir,
                            term_cols=new_cols,
                            term_rows=max(6, new_rows - 1),
                        )
                        bottom = _format_bottom_rule(rule_width, border_color=border_col)
                        occ_lines = box.splitlines()
                        prefixed_line2 = (
                            occ_lines[-2]
                            if len(occ_lines) >= 2
                            else _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
                        )
                        move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                        tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                        tty_w.flush()
                    continue
                if action == "info":
                    info_state = _show_info_fullscreen(
                        title_kind=title_kind,
                        label=label,
                        tty_r=tty_r,
                        tty_w=tty_w,
                        sdir=resolved_sdir,
                        out_path=copy_target if is_start_bundle else edit_target,
                        script_path=step_script,
                        edit_target=edit_target,
                        rc=rc,
                        duration_s=duration_s,
                        op_timings=op_timings,
                        failed_step=failed_step,
                        extra_lines=extra_lines,
                        edited=is_edited,
                        allow_copy=True,
                        on_edit_callback=_on_clip_edit,
                    )
                    if info_state.get("action") == "copy":
                        action = "copy"
                    else:
                        new_cols, new_rows = _term_size()
                        if info_state.get("edited") or (new_cols, new_rows) != (prev_cols, prev_rows):
                            is_edited = _is_file_edited(edit_target, orig_path)
                            up_rows = _box_rows_above_prompt(box, new_cols)
                            prev_cols, prev_rows = new_cols, new_rows
                            box, rule_width, cursor_offset = format_clipboard_box(
                                label,
                                copy_target,
                                ok=ok,
                                rc=rc,
                                stats=stats_line(copy_target),
                                title_kind=title_kind,
                                extra_lines=extra_lines,
                                cmd_str=cmd_str,
                                edited=is_edited,
                                error_source=edit_target,
                                duration_s=duration_s,
                                op_timings=op_timings,
                                failed_step=failed_step,
                                bundle_details=False,
                                sdir=sdir,
                                term_cols=new_cols,
                                term_rows=max(6, new_rows - 1),
                            )
                            bottom = _format_bottom_rule(rule_width, border_color=border_col)
                            occ_lines = box.splitlines()
                            prefixed_line2 = (
                                occ_lines[-2]
                                if len(occ_lines) >= 2
                                else _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
                            )
                            move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                            tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                            tty_w.flush()
                        continue
                if action == "prompt":
                    note = _prompt_append_text(tty_r, tty_w)
                    if append_note_to_file(edit_target, note, as_prompt=is_start_bundle):
                        _on_clip_edit(edit_target)
                    _redraw_box()
                    continue
                if action in ("view", "edit"):
                    continue
                if action == "copy":
                    if copy_file_to_clipboard(cmd, copy_target):
                        status_line = f"✓ Copied {copy_target} to clipboard."
                    else:
                        status_line = f"✗ Clipboard copy failed; run: {cmd_str}"
                else:
                    status_line = "Skipped clipboard copy."
                break
            prefixed_status = _prefix_block_line(status_line, border_color=border_col)
            tty_w.write(f"\r\033[K{prefixed_status}\n\r\033[K{bottom}\n")
            tty_w.flush()
    except OSError:
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()


BUNDLE_BOUNDARY_HEADER = "bundle-boundary"
BUNDLE_EXPOSE_HEADER = "bundle-expose"
BUNDLE_HIDE_HEADER = "bundle-hide"
DEFAULT_BUNDLE_TOKEN_BUDGET = 100000
DEFAULT_FRAGMENT_MAX_TOKENS = 20000

SECTION_HEADER_RE = re.compile(r"^={5,}\s*(.+?)\s*={5,}$")
TERMINAL_BLOCK_HEADING_RE = re.compile(r"(?m)^## Terminal blocks \(")
EMBEDDED_RULE_ID_RE = re.compile(r"(?:^|:)blocks/(?:bash|pwsh)$")


def _strip_rule_description(raw_text: str) -> str:
    lines = raw_text.replace("\r\n", "\n").splitlines()
    while lines and lines[0].startswith("# Description:"):
        lines.pop(0)
    return "\n".join(lines).strip("\n")


def get_embedded_block_rule(shell_bin: str | None = None) -> tuple[str, str]:
    is_ps = _is_powershell(shell_bin)
    rule_id = "run_block:blocks/pwsh" if is_ps else "run_block:blocks/bash"
    raw = EMBEDDED_RULE_PWSH if is_ps else EMBEDDED_RULE_BASH
    placeholder = "__EMBEDDED_RULE_PWSH__" if is_ps else "__EMBEDDED_RULE_BASH__"
    if raw == placeholder:
        rel = Path("rules/blocks/pwsh.md" if is_ps else "rules/blocks/bash.md")
        src_path = Path(__file__).resolve().parent / rel
        if src_path.is_file():
            raw = _strip_rule_description(src_path.read_text(encoding="utf-8"))
        else:
            raw = ""
    else:
        raw = _strip_rule_description(raw)
    rendered = raw.replace("{cmd:run_block}", prog_name())
    return rule_id, rendered


def _has_embedded_block_rule(body_text: str, boundary: str | None = None) -> bool:
    if not body_text:
        return False
    boundary_val = (boundary or "").strip()
    if boundary_val:
        esc = re.escape(boundary_val)
        part_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:part(?:\s+(\{{.*\}}))?\s*-->\s*$")
        end_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:end\s*-->\s*$")
        in_part = False
        is_rule_part = False
        for line in body_text.replace("\r\n", "\n").splitlines():
            m = part_re.match(line)
            if m:
                in_part = True
                is_rule_part = False
                if m.group(1):
                    try:
                        meta = json.loads(m.group(1))
                    except ValueError:
                        meta = None
                    if isinstance(meta, dict):
                        kind = str(meta.get("kind") or "")
                        is_rule_part = kind in ("", "rule", "rules")
                        ident = str(meta.get("id") or meta.get("name") or "")
                        if is_rule_part and EMBEDDED_RULE_ID_RE.search(ident):
                            return True
                continue
            if end_re.match(line):
                in_part = False
                is_rule_part = False
                continue
            if (not in_part or is_rule_part) and TERMINAL_BLOCK_HEADING_RE.match(line):
                return True
        return False
    return bool(TERMINAL_BLOCK_HEADING_RE.search(body_text))


def inject_embedded_block_rule(
    raw_body: str,
    boundary: str | None = None,
    shell_bin: str | None = None,
) -> str:
    norm_body = (raw_body or "").replace("\r\n", "\n")
    boundary_val = (boundary or "").strip() or None
    if _has_embedded_block_rule(norm_body, boundary=boundary_val):
        return norm_body
    rule_id, rule_text = get_embedded_block_rule(shell_bin=shell_bin)
    if not rule_text.strip():
        return norm_body

    if boundary_val:
        part_meta = json.dumps(
            {"kind": "rule", "id": rule_id, "chain": ["run_block"]},
            ensure_ascii=False,
        )
        part_block = [
            f"<!-- bundle:{boundary_val}:part {part_meta} -->",
            *rule_text.splitlines(),
            f"<!-- bundle:{boundary_val}:end -->",
        ]
        esc = re.escape(boundary_val)
        part_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:part(?:\s+(\{{.*\}}))?\s*-->\s*$")
        end_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:end\s*-->\s*$")
        lines = norm_body.splitlines()
        in_part = False
        rules_idx: int | None = None
        first_part_idx: int | None = None
        for idx, line in enumerate(lines):
            if part_re.match(line):
                if first_part_idx is None:
                    first_part_idx = idx
                in_part = True
                continue
            if end_re.match(line):
                in_part = False
                continue
            if not in_part and rules_idx is None:
                m_sec = SECTION_HEADER_RE.match(line.strip())
                if m_sec and m_sec.group(1).strip().lower() == "rules":
                    rules_idx = idx
        if rules_idx is not None:
            after = lines[rules_idx + 1 :]
            while after and not after[0].strip():
                after.pop(0)
            merged = [*lines[: rules_idx + 1], *part_block]
            if after:
                merged.extend(["", *after])
            return "\n".join(merged)
        if first_part_idx is not None:
            before = lines[:first_part_idx]
            while before and not before[-1].strip():
                before.pop()
            after = lines[first_part_idx:]
            if before and SECTION_HEADER_RE.match(before[0].strip()):
                return "\n".join(["===== Rules =====", *part_block, "", *before, *after])
            merged: list[str] = []
            if before:
                merged.extend([*before, ""])
            merged.extend(["===== Rules =====", *part_block, "", *after])
            return "\n".join(merged)
        stripped = norm_body.strip("\n")
        if not stripped.strip():
            return "\n".join(["===== Rules =====", *part_block])
        first_nonempty = next((ln.strip() for ln in stripped.splitlines() if ln.strip()), "")
        if SECTION_HEADER_RE.match(first_nonempty):
            return "\n".join(["===== Rules =====", *part_block, "", stripped])
        return "\n".join(["===== Rules =====", *part_block, "", "===== Prompt =====", stripped])

    stripped = norm_body.strip("\n")
    if not stripped.strip():
        return f"===== Rules =====\n{rule_text}"
    lines = stripped.splitlines()
    first_idx = next((i for i, ln in enumerate(lines) if ln.strip()), 0)
    m_first = SECTION_HEADER_RE.match(lines[first_idx].strip())
    if m_first and m_first.group(1).strip().lower() == "rules":
        after = lines[first_idx + 1 :]
        while after and not after[0].strip():
            after.pop(0)
        merged = [lines[first_idx], rule_text]
        if after:
            merged.extend(["", *after])
        return "\n".join(merged)
    if m_first:
        return f"===== Rules =====\n{rule_text}\n\n{stripped}"
    return f"===== Rules =====\n{rule_text}\n\n===== Prompt =====\n{stripped}"


def normalize_prompt_text(prompt: str | list[str] | tuple[str, ...] | None) -> str:
    if prompt is None:
        return ""
    items = [prompt] if isinstance(prompt, str) else list(prompt)
    cleaned: list[str] = []
    for item in items:
        if not isinstance(item, str):
            continue
        norm = item.replace("\r\n", "\n").strip("\n")
        if norm.strip():
            cleaned.append(norm.strip())
    return "\n\n".join(cleaned)


def _append_to_unframed_prompt_tail(
    lines: list[str], start_idx: int, prompt_lines: list[str]
) -> list[str] | None:
    last_sec_idx: int | None = None
    last_sec_title = ""
    for idx in range(start_idx, len(lines)):
        m = SECTION_HEADER_RE.match(lines[idx].strip())
        if m:
            last_sec_idx = idx
            last_sec_title = m.group(1).strip().lower()
    if last_sec_idx is None or last_sec_title != "prompt":
        return None
    trimmed = list(lines)
    while trimmed and not trimmed[-1].strip():
        trimmed.pop()
    has_body = any(ln.strip() for ln in trimmed[last_sec_idx + 1 :])
    if has_body:
        return [*trimmed, "", *prompt_lines]
    return [*trimmed[: last_sec_idx + 1], *prompt_lines]


def inject_embedded_prompt(
    raw_body: str,
    prompt: str | list[str] | tuple[str, ...] | None = None,
    boundary: str | None = None,
) -> str:
    prompt_text = normalize_prompt_text(prompt)
    norm_body = (raw_body or "").replace("\r\n", "\n")
    if not prompt_text:
        return norm_body
    prompt_lines = prompt_text.splitlines()
    boundary_val = (boundary or "").strip() or None
    lines = norm_body.splitlines()
    while lines and not lines[-1].strip():
        lines.pop()

    if boundary_val:
        esc = re.escape(boundary_val)
        part_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:part(?:\s+(\{{.*\}}))?\s*-->\s*$")
        end_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:end\s*-->\s*$")
        last_end_idx: int | None = None
        for idx, line in enumerate(lines):
            if end_re.match(line):
                last_end_idx = idx
        if last_end_idx is not None:
            tail_after_end = lines[last_end_idx + 1 :]
            if any(ln.strip() for ln in tail_after_end):
                updated = _append_to_unframed_prompt_tail(lines, last_end_idx + 1, prompt_lines)
                if updated is not None:
                    return "\n".join(updated)
            else:
                last_part_idx: int | None = None
                last_meta: dict[str, object] = {}
                for idx in range(last_end_idx - 1, -1, -1):
                    m_part = part_re.match(lines[idx])
                    if m_part:
                        last_part_idx = idx
                        if m_part.group(1):
                            try:
                                parsed = json.loads(m_part.group(1))
                                if isinstance(parsed, dict):
                                    last_meta = parsed
                            except ValueError:
                                pass
                        break
                if last_part_idx is not None:
                    part_kind = str(last_meta.get("kind") or "").strip().lower()
                    inner = list(lines[last_part_idx + 1 : last_end_idx])
                    while inner and not inner[-1].strip():
                        inner.pop()
                    first_inner = next((ln.strip() for ln in inner if ln.strip()), "")
                    m_inner_sec = SECTION_HEADER_RE.match(first_inner) if first_inner else None
                    prev_nonempty = next(
                        (lines[j].strip() for j in range(last_part_idx - 1, -1, -1) if lines[j].strip()),
                        "",
                    )
                    m_prev_sec = SECTION_HEADER_RE.match(prev_nonempty) if prev_nonempty else None
                    is_prompt_part = part_kind == "prompt" or (
                        part_kind in ("", "section")
                        and (
                            (m_inner_sec is not None and m_inner_sec.group(1).strip().lower() == "prompt")
                            or (m_prev_sec is not None and m_prev_sec.group(1).strip().lower() == "prompt")
                        )
                    )
                    if is_prompt_part:
                        non_empty_inner = [ln for ln in inner if ln.strip()]
                        only_header = (
                            len(non_empty_inner) == 1
                            and SECTION_HEADER_RE.match(non_empty_inner[0].strip()) is not None
                        )
                        prefix = [*lines[: last_part_idx + 1], *inner]
                        if non_empty_inner and not only_header:
                            prefix.append("")
                        return "\n".join([*prefix, *prompt_lines, lines[last_end_idx]])
            part_meta = json.dumps({"kind": "prompt", "name": "Prompt"}, ensure_ascii=False)
            prompt_block = [
                f"<!-- bundle:{boundary_val}:part {part_meta} -->",
                "===== Prompt =====",
                *prompt_lines,
                f"<!-- bundle:{boundary_val}:end -->",
            ]
            if lines:
                return "\n".join([*lines, "", *prompt_block])
            return "\n".join(prompt_block)

    updated_plain = _append_to_unframed_prompt_tail(lines, 0, prompt_lines)
    if updated_plain is not None:
        return "\n".join(updated_plain)
    if lines:
        return "\n".join([*lines, "", "===== Prompt =====", *prompt_lines])
    return "\n".join(["===== Prompt =====", *prompt_lines])


def _parse_header_filter_tokens(raw: str) -> set[str]:
    tokens: set[str] = set()
    for tok in re.split(r"[\s,]+", raw or ""):
        cleaned = re.sub(r"\s+", "-", tok.strip().lower())
        if cleaned:
            tokens.add(cleaned)
    return tokens


def extract_bundle_transport_headers(headers: list[tuple[str, str]]) -> dict[str, str]:
    out: dict[str, str] = {}
    for k, v in headers:
        if is_bundle_transport_header(k):
            norm = re.sub(r"\s+", "-", k.strip().lower())
            out[norm] = v.strip()
    return out


def get_bundle_boundary(headers: list[tuple[str, str]]) -> str | None:
    transport = extract_bundle_transport_headers(headers)
    val = transport.get(BUNDLE_BOUNDARY_HEADER, "").strip()
    return val or None


def filter_exposed_headers(headers: list[tuple[str, str]]) -> list[tuple[str, str]]:
    transport = extract_bundle_transport_headers(headers)
    raw_expose = transport.get(BUNDLE_EXPOSE_HEADER, "")
    if not raw_expose:
        return []
    expose_set = _parse_header_filter_tokens(raw_expose)
    hide_set = _parse_header_filter_tokens(transport.get(BUNDLE_HIDE_HEADER, ""))
    if "*" in hide_set or "all" in hide_set:
        return []
    expose_all = "*" in expose_set or "all" in expose_set
    if not expose_all and (not expose_set or expose_set == {"none"}):
        return []

    exposed: list[tuple[str, str]] = []
    for k, v in headers:
        norm_k = re.sub(r"\s+", "-", k.strip().lower())
        if is_bundle_transport_header(norm_k):
            continue
        if norm_k in HIDDEN_SESSION_HEADER_KEYS:
            continue
        if norm_k in hide_set:
            continue
        if not expose_all and norm_k not in expose_set:
            continue
        if not v.strip():
            continue
        exposed.append((k, v))
    return exposed


def _infer_section_meta(title: str | None, *, is_sections: bool, is_preamble: bool = False) -> dict[str, object]:
    if title is None:
        if is_sections:
            return {"kind": "text", "name": "Preamble" if is_preamble else "Text"}
        return {"kind": "body", "name": "Body"}
    low = title.lower()
    if low == "rules":
        return {"kind": "rules", "name": "Rules"}
    if low == "prompt":
        return {"kind": "prompt", "name": "Prompt"}
    if title.startswith(chr(36) + " "):
        return {"kind": "cmd", "name": title[2:].strip()}
    if low.startswith("file:"):
        return {"kind": "file", "name": title.split(":", 1)[1].strip()}
    return {"kind": "section", "name": title}


def _bundle_thresholds() -> tuple[int, int]:
    try:
        bundle_max = int(get_setting("bundle_max_tokens")[0])
    except Exception:
        bundle_max = DEFAULT_BUNDLE_TOKEN_BUDGET
    try:
        frag_max = int(get_setting("fragment_max_tokens")[0])
    except Exception:
        frag_max = DEFAULT_FRAGMENT_MAX_TOKENS
    return max(0, bundle_max), max(0, frag_max)


def _part_label(entry: dict[str, object]) -> str:
    name = str(entry.get("name") or entry.get("id") or "")
    if name:
        return name
    grp = str(entry.get("group") or "")
    if grp:
        return grp
    kind = str(entry.get("kind") or "part")
    idx = entry.get("index")
    return f"{kind} #{idx}" if idx is not None else kind


def _is_cmd_output_empty(part_lines: list[str]) -> bool:
    non_empty = [ln for ln in part_lines if ln.strip()]
    if not non_empty:
        return True
    if SECTION_HEADER_RE.match(non_empty[0].strip()):
        return len(non_empty) == 1
    return False


def analyze_bundle_warnings(
    parts: list[dict[str, object]],
    part_texts: list[str] | None = None,
    part_lines_list: list[list[str]] | None = None,
    total_gpt: int | None = None,
) -> list[dict[str, object]]:
    bundle_budget, frag_limit = _bundle_thresholds()
    warnings: list[dict[str, object]] = []
    computed_gpt = 0
    for idx_0, entry in enumerate(parts):
        idx = int(entry.get("index") or (idx_0 + 1))
        kind = str(entry.get("kind") or "part").lower()
        label = _part_label(entry)
        gpt_cnt = int(entry.get("gpt") or 0)
        computed_gpt += gpt_cnt
        rc_val = entry.get("rc")
        if isinstance(rc_val, int) and rc_val != 0:
            warnings.append(
                {
                    "code": "cmd_rc",
                    "severity": "warn",
                    "part_index": idx,
                    "part_name": label,
                    "message": f"command {label!r} exited with rc={rc_val}",
                }
            )
        if kind == "cmd" and part_lines_list is not None and idx_0 < len(part_lines_list):
            if _is_cmd_output_empty(part_lines_list[idx_0]):
                warnings.append(
                    {
                        "code": "cmd_empty",
                        "severity": "warn",
                        "part_index": idx,
                        "part_name": label,
                        "message": f"command {label!r} produced empty output",
                    }
                )
        if frag_limit > 0 and gpt_cnt > frag_limit:
            warnings.append(
                {
                    "code": "fragment_oversized",
                    "severity": "warn",
                    "part_index": idx,
                    "part_name": label,
                    "message": f"fragment {label!r} is oversized (~{_human_tok(gpt_cnt)} > {_human_tok(frag_limit)} tokens)",
                }
            )
        if kind not in ("rule", "rules") and part_texts is not None and idx_0 < len(part_texts):
            sec_hits = scan_content_secrets(part_texts[idx_0])
            if sec_hits:
                labels: list[str] = []
                for h in sec_hits:
                    lbl = str(h.get("label") or h.get("category") or "secret")
                    if lbl not in labels:
                        labels.append(lbl)
                cat_str = ", ".join(labels)
                warnings.append(
                    {
                        "code": "secret_detected",
                        "severity": "warn",
                        "part_index": idx,
                        "part_name": label,
                        "message": f"potential secret in {label!r} ({cat_str})",
                    }
                )
    eff_total_gpt = total_gpt if total_gpt is not None else computed_gpt
    if bundle_budget > 0 and eff_total_gpt > bundle_budget:
        warnings.append(
            {
                "code": "token_budget",
                "severity": "warn",
                "message": f"total bundle (~{_human_tok(eff_total_gpt)} tokens) exceeds {_human_tok(bundle_budget)} token budget",
            }
        )
    return warnings


def _part_chars(entry: dict[str, object]) -> int:
    raw = entry.get("chars")
    if isinstance(raw, (int, float)) and not isinstance(raw, bool):
        return int(raw)
    return int(entry.get("bytes") or 0)


def _resolve_part_chain(entry: dict[str, object]) -> list[str]:
    if "chain" in entry and isinstance(entry.get("chain"), (list, tuple)):
        return [str(x).strip() for x in entry["chain"] if str(x).strip()]
    grp = str(entry.get("group") or "").strip()
    if not grp:
        return []
    via = str(entry.get("via") or "").strip()
    if via and via != grp:
        return [via, grp]
    return [grp]


def _join_chain_label(chain: list[str], name: str) -> str:
    if not chain:
        return name
    if not name:
        return " -> ".join(chain) if len(chain) > 1 else chain[0]
    cur = name
    for seg in reversed(chain):
        if cur == seg or cur.startswith(seg + ":") or cur.startswith(seg + "/"):
            continue
        cur = f"{seg}: {cur}"
    return cur


def _child_rel_label(prefix: str, name: str) -> str:
    if not prefix or not name or name == prefix:
        return name
    for sep in (":", "/"):
        if name.startswith(prefix + sep):
            return name[len(prefix) + 1 :].lstrip() or name
    return name


def _recompute_share_pct(plan: dict[str, object]) -> None:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    total_chars = int(plan.get("chars") if plan.get("chars") is not None else (plan.get("bytes") or 0))
    total_bytes = int(plan.get("bytes") or 0)
    denom = total_chars if total_chars > 0 else total_bytes
    use_chars = total_chars > 0
    for entry in parts:
        val = _part_chars(entry) if use_chars else int(entry.get("bytes") or 0)
        entry["share_pct"] = round(val * 100.0 / denom, 1) if denom > 0 else 0.0


def _collapse_blank_runs(lines: list[str]) -> list[str]:
    out: list[str] = []
    for ln in lines:
        if ln == "" and out and out[-1] == "":
            continue
        out.append(ln)
    return out


def _assign_part_ranges(
    plan: dict[str, object],
    raw_parts: list[tuple[dict[str, object], list[str]]],
    body_text: str,
    *,
    collapse_blanks: bool,
) -> None:
    # Locate each part inside the cleaned body (1-based, body-relative); parts
    # that cannot be matched contiguously simply carry no range.
    body_lines = body_text.splitlines()
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    cursor = 0
    for entry, (_, part_lines) in zip(parts, raw_parts):
        seq = _collapse_blank_runs(part_lines) if collapse_blanks else list(part_lines)
        while seq and not seq[0].strip():
            seq.pop(0)
        while seq and not seq[-1].strip():
            seq.pop()
        if not seq:
            continue
        span = len(seq)
        for pos in range(cursor, len(body_lines) - span + 1):
            if body_lines[pos] == seq[0] and body_lines[pos:pos + span] == seq:
                entry["line_start"] = pos + 1
                entry["line_end"] = pos + span
                cursor = pos + span
                break
    plan["line_offset"] = 0


def _body_line_offset(full_text: str) -> int:
    try:
        _, body = parse_stdin_preamble(full_text)
    except Exception:
        return 0
    if not body.strip():
        return 0
    body_pos = full_text.find(body[:200])
    return full_text.count("\n", 0, body_pos) if body_pos > 0 else 0


def _shift_part_ranges(plan: dict[str, object], offset: int) -> dict[str, object]:
    delta = offset - int(plan.get("line_offset") or 0)
    out = dict(plan)
    out["line_offset"] = offset
    if delta == 0:
        return out
    shifted: list[dict[str, object]] = []
    for p in out.get("parts") or []:
        q = dict(p)
        if str(q.get("kind") or "") != "header" and isinstance(q.get("line_start"), int) and isinstance(q.get("line_end"), int):
            q["line_start"] += delta
            q["line_end"] += delta
        shifted.append(q)
    out["parts"] = shifted
    return out


def parse_part_option(argv: list[str], usage: str) -> tuple[list[str], int | None]:
    prog = prog_name()
    rest: list[str] = []
    part: int | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--part":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --part requires a number (usage: {usage})")
            raw = argv[i + 1]
            i += 2
        elif a.startswith("--part="):
            raw = a.split("=", 1)[1]
            i += 1
        else:
            rest.append(a)
            i += 1
            continue
        if part is not None:
            raise SystemExit(f"{prog}: --part given more than once (usage: {usage})")
        if not re.fullmatch(r"[0-9]+", raw) or int(raw) < 1:
            raise SystemExit(f"{prog}: --part expects a positive integer, got {raw!r}")
        part = int(raw)
    return rest, part


def extract_bundle_part(plan: dict[str, object], text: str, number: int) -> tuple[dict[str, object], str]:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    if number < 1 or number > len(parts):
        raise ValueError(f"part {number} out of range (bundle has {len(parts)} part{'s' if len(parts) != 1 else ''})")
    entry = parts[number - 1]
    start, end = entry.get("line_start"), entry.get("line_end")
    if not isinstance(start, int) or not isinstance(end, int):
        raise ValueError(f"part {number} has no recorded line range (bundle plan predates part ranges)")
    lines = text.splitlines()
    if start < 1 or end < start or end > len(lines):
        raise ValueError(f"part {number} line range {start}-{end} is outside the bundle ({len(lines)} lines)")
    return entry, "\n".join(lines[start - 1:end]) + "\n"


def format_part_header(target: str, entry: dict[str, object], total: int) -> str:
    return (
        f"{target} part {entry.get('index')}/{total}: {_part_label(entry)} "
        f"(lines {entry.get('line_start')}-{entry.get('line_end')})\n"
    )


def reconcile_bundle_plan(plan: dict[str, object], full_text: str, *, track_lines: bool = True) -> dict[str, object]:
    out = dict(plan)
    raw_parts = [dict(p) for p in (out.get("parts") or []) if isinstance(p, dict)]
    had_header_part = bool(raw_parts and str(raw_parts[0].get("kind") or "") == "header")
    non_hdr_parts = raw_parts[1:] if had_header_part else raw_parts
    sum_lines = sum(int(p.get("lines") or 0) for p in non_hdr_parts)
    sum_chars = sum(_part_chars(p) for p in non_hdr_parts)
    sum_bytes = sum(int(p.get("bytes") or 0) for p in non_hdr_parts)
    sum_gpt = sum(int(p.get("gpt") or 0) for p in non_hdr_parts)
    sum_claude = sum(int(p.get("claude") or 0) for p in non_hdr_parts)
    full_tok = count_tokens(full_text.encode("utf-8"))
    try:
        preamble_headers, body = parse_stdin_preamble(full_text)
    except Exception:
        preamble_headers, body = [], full_text
    body_pos = full_text.find(body[:200]) if body.strip() else -1
    prefix = full_text[:body_pos] if body_pos > 0 else (full_text if (preamble_headers and not body.strip()) else "")
    pre_tok = count_tokens(prefix.encode("utf-8")) if prefix else {}

    def _hdr_val(key: str, sum_val: int) -> int:
        return max(0, int(full_tok[key]) - sum_val, int(pre_tok.get(key) or 0))

    has_leading_headers = bool(preamble_headers)
    hdr_lines = _hdr_val("lines", sum_lines) if has_leading_headers else 0
    hdr_chars = _hdr_val("chars", sum_chars) if has_leading_headers else 0
    hdr_bytes = _hdr_val("bytes", sum_bytes) if has_leading_headers else 0
    hdr_gpt = _hdr_val("gpt", sum_gpt) if has_leading_headers else 0
    hdr_claude = _hdr_val("claude", sum_claude) if has_leading_headers else 0
    out.pop("header", None)
    if has_leading_headers and (hdr_lines > 0 or hdr_chars > 0):
        out["lines"] = sum_lines + hdr_lines
        out["chars"] = sum_chars + hdr_chars
        out["bytes"] = sum_bytes + hdr_bytes
        out["gpt"] = sum_gpt + hdr_gpt
        out["claude"] = sum_claude + hdr_claude
        out["gpt_exact"] = bool(full_tok["gpt_exact"])
        offset = _body_line_offset(full_text)
        hdr_end = max(1, offset) if offset > 0 else max(1, len(prefix.splitlines()))
        hdr_part: dict[str, object] = {
            "index": 1,
            "kind": "header",
            "name": "Headers & spacing",
            "chain": [],
            "lines": hdr_lines,
            "chars": hdr_chars,
            "bytes": hdr_bytes,
            "gpt": hdr_gpt,
            "claude": hdr_claude,
            "line_start": 1,
            "line_end": hdr_end,
        }
        shifted_parts: list[dict[str, object]] = [hdr_part]
        for idx_p, p in enumerate(non_hdr_parts, 2):
            qp = dict(p)
            qp["index"] = idx_p
            shifted_parts.append(qp)
        out["parts"] = shifted_parts
        out["part_count"] = len(shifted_parts)
        if not had_header_part and isinstance(out.get("warnings"), list):
            new_warns: list[dict[str, object]] = []
            for w in out["warnings"]:
                if isinstance(w, dict):
                    qw = dict(w)
                    if isinstance(qw.get("part_index"), int):
                        qw["part_index"] = int(qw["part_index"]) + 1
                    new_warns.append(qw)
            out["warnings"] = new_warns
    else:
        renumbered: list[dict[str, object]] = []
        for idx_p, p in enumerate(non_hdr_parts, 1):
            qp = dict(p)
            qp["index"] = idx_p
            renumbered.append(qp)
        out["parts"] = renumbered
        out["part_count"] = len(renumbered)
        out["lines"] = sum_lines
        out["chars"] = sum_chars
        out["bytes"] = sum_bytes
        out["gpt"] = sum_gpt
        out["claude"] = sum_claude
    _recompute_share_pct(out)
    if track_lines:
        out = _shift_part_ranges(out, _body_line_offset(full_text))
    return out


def group_bundle_parts(parts: list[dict[str, object]]) -> list[dict[str, object]]:
    buckets: dict[tuple[str, tuple[str, ...]], dict[str, object]] = {}
    order: list[tuple[str, tuple[str, ...]]] = []
    for entry in parts:
        kind = str(entry.get("kind") or "part")
        chain = tuple(_resolve_part_chain(entry))
        group = " / ".join(chain) if chain else ""
        key = (kind, chain)
        if key not in buckets:
            order.append(key)
            buckets[key] = {
                "kind": kind,
                "group": group,
                "chain": list(chain),
                "count": 0,
                "lines": 0,
                "chars": 0,
                "bytes": 0,
                "gpt": 0,
                "claude": 0,
                "share_pct": 0.0,
                "names": [],
                "rc_errors": 0,
            }
        b = buckets[key]
        b["count"] = int(b["count"]) + 1
        b["lines"] = int(b["lines"]) + int(entry.get("lines") or 0)
        b["chars"] = int(b["chars"]) + _part_chars(entry)
        b["bytes"] = int(b["bytes"]) + int(entry.get("bytes") or 0)
        b["gpt"] = int(b["gpt"]) + int(entry.get("gpt") or 0)
        b["claude"] = int(b["claude"]) + int(entry.get("claude") or 0)
        b["share_pct"] = round(float(b["share_pct"]) + float(entry.get("share_pct") or 0.0), 1)
        name = str(entry.get("name") or entry.get("id") or "")
        names_list = b["names"]
        if name and isinstance(names_list, list) and name not in names_list:
            names_list.append(name)
        rc_val = entry.get("rc")
        if isinstance(rc_val, int) and rc_val != 0:
            b["rc_errors"] = int(b["rc_errors"]) + 1
    return [buckets[k] for k in order]


def _build_bundle_plan(
    protocol: str,
    boundary: str | None,
    raw_parts: list[tuple[dict[str, object], list[str]]],
) -> dict[str, object]:
    parts: list[dict[str, object]] = []
    part_texts: list[str] = []
    part_lines_list: list[list[str]] = []
    total_lines = 0
    total_chars = 0
    total_bytes = 0
    total_gpt = 0
    total_claude = 0
    gpt_exact = False

    for idx, (meta, part_lines) in enumerate(raw_parts, 1):
        part_text = "\n".join(part_lines) + ("\n" if part_lines else "")
        part_texts.append(part_text)
        part_lines_list.append(part_lines)
        tok = count_tokens(part_text.encode("utf-8"))
        gpt_exact = bool(tok["gpt_exact"])
        lines_cnt = int(tok["lines"])
        chars_cnt = int(tok["chars"])
        bytes_cnt = int(tok["bytes"])
        gpt_cnt = int(tok["gpt"])
        claude_cnt = int(tok["claude"])

        entry: dict[str, object] = {
            "index": idx,
            "kind": str(meta.get("kind") or "part"),
        }
        if meta.get("id"):
            entry["id"] = str(meta["id"])
        name_val = str(meta.get("name") or meta.get("id") or "")
        if name_val:
            entry["name"] = name_val
        if "chain" in meta and isinstance(meta.get("chain"), (list, tuple)):
            entry["chain"] = [str(x).strip() for x in meta["chain"] if str(x).strip()]
        if meta.get("group"):
            entry["group"] = str(meta["group"])
        if meta.get("via"):
            entry["via"] = str(meta["via"])
        rc_val = meta.get("rc")
        if isinstance(rc_val, (int, float)) and not isinstance(rc_val, bool):
            entry["rc"] = int(rc_val)
        ms_val = meta.get("ms")
        if isinstance(ms_val, (int, float)) and not isinstance(ms_val, bool):
            ms_f = float(ms_val)
            entry["ms"] = int(round(ms_f)) if ms_f.is_integer() else ms_f
        entry["lines"] = lines_cnt
        entry["chars"] = chars_cnt
        entry["bytes"] = bytes_cnt
        entry["gpt"] = gpt_cnt
        entry["claude"] = claude_cnt

        total_lines += lines_cnt
        total_chars += chars_cnt
        total_bytes += bytes_cnt
        total_gpt += gpt_cnt
        total_claude += claude_cnt
        parts.append(entry)

    plan: dict[str, object] = {
        "protocol": protocol,
        "boundary": boundary or None,
        "part_count": len(parts),
        "lines": total_lines,
        "chars": total_chars,
        "bytes": total_bytes,
        "gpt": total_gpt,
        "claude": total_claude,
        "gpt_exact": gpt_exact,
        "parts": parts,
        "warnings": analyze_bundle_warnings(
            parts,
            part_texts=part_texts,
            part_lines_list=part_lines_list,
            total_gpt=total_gpt,
        ),
    }
    _recompute_share_pct(plan)
    return plan


def _split_section_fallback(norm_text: str, boundary_val: str | None) -> tuple[str, dict[str, object]]:
    clean_body = norm_text.strip("\n")
    if not clean_body.strip():
        return "", _build_bundle_plan("empty", boundary_val, [])

    lines = clean_body.splitlines()
    raw_sections: list[tuple[str | None, list[str]]] = []
    cur_title: str | None = None
    cur_lines: list[str] = []
    saw_section = False

    for line in lines:
        m = SECTION_HEADER_RE.match(line.strip())
        if m:
            if saw_section or any(x.strip() for x in cur_lines):
                while cur_lines and not cur_lines[-1].strip():
                    cur_lines.pop()
                raw_sections.append((cur_title, cur_lines))
            saw_section = True
            cur_title = m.group(1).strip()
            cur_lines = [line]
        else:
            cur_lines.append(line)

    if saw_section or any(x.strip() for x in cur_lines):
        while cur_lines and not cur_lines[-1].strip():
            cur_lines.pop()
        raw_sections.append((cur_title, cur_lines))

    protocol = "sections" if saw_section else "body"
    raw_parts: list[tuple[dict[str, object], list[str]]] = []
    for idx, (sec_title, sec_lines) in enumerate(raw_sections):
        meta = _infer_section_meta(sec_title, is_sections=saw_section, is_preamble=(idx == 0))
        raw_parts.append((meta, sec_lines))
    plan = _build_bundle_plan(protocol, boundary_val, raw_parts)
    _assign_part_ranges(plan, raw_parts, clean_body, collapse_blanks=False)
    if clean_body:
        plan = reconcile_bundle_plan(plan, clean_body + "\n", track_lines=False)
    return clean_body, plan


def _collect_unframed_parts(
    unframed_lines: list[str],
    *,
    is_first: bool,
) -> list[tuple[dict[str, object], list[str]]]:
    real_unframed = [ln for ln in unframed_lines if not SECTION_HEADER_RE.match(ln.strip())]
    while real_unframed and not real_unframed[0].strip():
        real_unframed.pop(0)
    while real_unframed and not real_unframed[-1].strip():
        real_unframed.pop()
    if any(x.strip() for x in real_unframed):
        return [(_infer_section_meta(None, is_sections=True, is_preamble=is_first), real_unframed)]
    return []


def parse_bundle_fragments(body_text: str, boundary: str | None = None) -> tuple[str, dict[str, object]]:
    if not body_text:
        return "", _build_bundle_plan("empty", boundary, [])

    norm_text = body_text.replace("\r\n", "\n")
    boundary_val = (boundary or "").strip() or None

    if boundary_val:
        esc = re.escape(boundary_val)
        part_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:part(?:\s+(\{{.*\}}))?\s*-->\s*$")
        end_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:end\s*-->\s*$")

        raw_parts: list[tuple[dict[str, object], list[str]]] = []
        stripped_lines: list[str] = []
        in_part = False
        cur_meta: dict[str, object] = {}
        cur_lines: list[str] = []
        unframed_lines: list[str] = []
        found_markers = 0

        for line in norm_text.splitlines():
            m_part = part_re.match(line)
            if m_part:
                found_markers += 1
                if in_part:
                    raw_parts.append((cur_meta, cur_lines))
                else:
                    raw_parts.extend(_collect_unframed_parts(unframed_lines, is_first=(len(raw_parts) == 0)))
                unframed_lines = []
                in_part = True
                cur_lines = []
                cur_meta = {}
                raw_json = m_part.group(1)
                if raw_json:
                    try:
                        parsed = json.loads(raw_json)
                        if isinstance(parsed, dict):
                            cur_meta = parsed
                    except ValueError:
                        cur_meta = {"kind": "part"}
                continue

            if end_re.match(line):
                found_markers += 1
                if in_part:
                    raw_parts.append((cur_meta, cur_lines))
                    in_part = False
                    cur_meta = {}
                    cur_lines = []
                continue

            stripped_lines.append(line)
            if in_part:
                cur_lines.append(line)
            else:
                unframed_lines.append(line)

        if in_part:
            raw_parts.append((cur_meta, cur_lines))
        else:
            raw_parts.extend(_collect_unframed_parts(unframed_lines, is_first=(len(raw_parts) == 0)))

        if found_markers > 0:
            clean_body = "\n".join(stripped_lines)
            clean_body = re.sub(r"\n{3,}", "\n\n", clean_body).strip("\n")
            plan = _build_bundle_plan("boundary", boundary_val, raw_parts)
            _assign_part_ranges(plan, raw_parts, clean_body, collapse_blanks=True)
            if clean_body:
                plan = reconcile_bundle_plan(plan, clean_body + "\n", track_lines=False)
            return clean_body, plan

    return _split_section_fallback(norm_text, boundary_val)


def refresh_bundle_plan_meta(sdir: Path, bundle_path: Path) -> None:
    if not bundle_path.is_file():
        return
    text = bundle_path.read_text(encoding="utf-8", errors="replace")
    preamble_hdrs, body = parse_stdin_preamble(text)
    meta = read_session_meta(sdir)
    prev_plan = meta.get("bundle_plan") if isinstance(meta.get("bundle_plan"), dict) else None
    meta_hdrs = _parse_meta_header_items(sdir)
    boundary = get_bundle_boundary(meta_hdrs)
    clean_body, parsed_plan = parse_bundle_fragments(body, boundary=boundary)
    raw_path = sdir / "0.raw"
    if boundary and parsed_plan.get("protocol") == "boundary":
        write_private(raw_path, text, overwrite=True)
        hdr_block = "\n".join(f"{k}: {v}" for k, v in preamble_hdrs) + "\n" if preamble_hdrs else ""
        text = hdr_block + ("\n" + clean_body + "\n" if (hdr_block and clean_body) else (clean_body + "\n" if clean_body else ""))
        write_private(bundle_path, text, overwrite=True)
        plan = reconcile_bundle_plan(parsed_plan, text)
        update_session_meta(sdir, bundle_plan=plan)
        return
    if raw_path.is_file() and boundary:
        raw_text = raw_path.read_text(encoding="utf-8", errors="replace")
        _, raw_body = parse_stdin_preamble(raw_text)
        raw_clean_body, raw_plan = parse_bundle_fragments(raw_body, boundary=boundary)
        if raw_plan.get("protocol") == "boundary" and raw_clean_body == body:
            hdr_block = "\n".join(f"{k}: {v}" for k, v in preamble_hdrs) + "\n" if preamble_hdrs else ""
            new_raw = hdr_block + ("\n" + raw_body.strip("\n") + "\n" if (hdr_block and raw_body.strip()) else (raw_body.strip("\n") + "\n" if raw_body.strip() else ""))
            write_private(raw_path, new_raw, overwrite=True)
            plan = reconcile_bundle_plan(raw_plan, text)
            update_session_meta(sdir, bundle_plan=plan)
            return
    if (
        isinstance(prev_plan, dict)
        and prev_plan.get("protocol") == "boundary"
        and parsed_plan.get("protocol") != "boundary"
    ):
        prev_parts = [dict(p) for p in (prev_plan.get("parts") or []) if isinstance(p, dict)]
        non_hdr = [p for p in prev_parts if str(p.get("kind") or "") != "header"]
        lines = text.splitlines()
        last_non_prompt_end = 0
        for p in non_hdr:
            if str(p.get("kind") or "") != "prompt" and isinstance(p.get("line_end"), int):
                last_non_prompt_end = max(last_non_prompt_end, int(p["line_end"]))
        if non_hdr and last_non_prompt_end > 0 and last_non_prompt_end <= len(lines):
            prefix_match = True
            for p in non_hdr:
                if str(p.get("kind") or "") == "prompt":
                    continue
                ls, le = p.get("line_start"), p.get("line_end")
                if not isinstance(ls, int) or not isinstance(le, int) or ls < 1 or le > len(lines):
                    prefix_match = False
                    break
            if prefix_match:
                tail_start = last_non_prompt_end + 1
                while tail_start <= len(lines) and not lines[tail_start - 1].strip():
                    tail_start += 1
                tail_end = len(lines)
                while tail_end >= tail_start and not lines[tail_end - 1].strip():
                    tail_end -= 1
                if tail_start <= tail_end:
                    tail_lines = lines[tail_start - 1 : tail_end]
                    first_tail = tail_lines[0].strip()
                    m_sec = SECTION_HEADER_RE.match(first_tail)
                    if m_sec and m_sec.group(1).strip().lower() == "prompt":
                        p_text = "\n".join(tail_lines) + "\n"
                        tok = count_tokens(p_text.encode("utf-8"))
                        if str(non_hdr[-1].get("kind") or "") == "prompt":
                            p_entry = dict(non_hdr[-1])
                        else:
                            p_entry = {"kind": "prompt", "name": "Prompt", "chain": []}
                            non_hdr.append(p_entry)
                        p_entry["lines"] = int(tok["lines"])
                        p_entry["chars"] = int(tok["chars"])
                        p_entry["bytes"] = int(tok["bytes"])
                        p_entry["gpt"] = int(tok["gpt"])
                        p_entry["claude"] = int(tok["claude"])
                        p_entry["line_start"] = tail_start
                        p_entry["line_end"] = tail_end
                        kept_plan = dict(prev_plan)
                        kept_plan["parts"] = non_hdr
                        kept_plan["line_offset"] = _body_line_offset(text)
                        plan = reconcile_bundle_plan(kept_plan, text, track_lines=False)
                        update_session_meta(sdir, bundle_plan=plan)
                        return
    raw_path.unlink(missing_ok=True)
    plan = reconcile_bundle_plan(parsed_plan, text)
    update_session_meta(sdir, bundle_plan=plan)


def _format_tok_pair(gpt_cnt: int, claude_cnt: int, *, unit: bool = True) -> str:
    lo = min(gpt_cnt, claude_cnt)
    hi = max(gpt_cnt, claude_cnt)
    body = f"~{_human_tok(lo)}–{_human_tok(hi)}" if lo != hi else f"~{_human_tok(lo)}"
    return f"{body} tok" if unit else body


def _new_tree_node(name: str, chain: list[str]) -> dict[str, object]:
    return {
        "name": name,
        "chain": list(chain),
        "items": [],
        "children_by_name": {},
        "direct_parts": [],
        "part_indices": [],
        "total_count": 0,
        "lines": 0,
        "chars": 0,
        "bytes": 0,
        "gpt": 0,
        "claude": 0,
        "share_pct": 0.0,
        "kinds": [],
        "rc_errors": 0,
    }


def _add_part_to_node(node: dict[str, object], entry: dict[str, object]) -> None:
    node["total_count"] = int(node["total_count"]) + 1
    node["lines"] = int(node["lines"]) + int(entry.get("lines") or 0)
    node["chars"] = int(node["chars"]) + _part_chars(entry)
    node["bytes"] = int(node["bytes"]) + int(entry.get("bytes") or 0)
    node["gpt"] = int(node["gpt"]) + int(entry.get("gpt") or 0)
    node["claude"] = int(node["claude"]) + int(entry.get("claude") or 0)
    node["share_pct"] = round(float(node["share_pct"]) + float(entry.get("share_pct") or 0.0), 1)
    p_idx = entry.get("index")
    p_indices = node["part_indices"]
    if isinstance(p_idx, int) and p_idx > 0 and isinstance(p_indices, list):
        p_indices.append(p_idx)
    kind = str(entry.get("kind") or "part")
    kinds = node["kinds"]
    if isinstance(kinds, list) and kind not in kinds:
        kinds.append(kind)
    rc_val = entry.get("rc")
    if isinstance(rc_val, int) and rc_val != 0:
        node["rc_errors"] = int(node["rc_errors"]) + 1


def _build_bundle_tree(parts: list[dict[str, object]]) -> list[tuple[str, dict[str, object]]]:
    root_items: list[tuple[str, dict[str, object]]] = []
    root_nodes: dict[str, dict[str, object]] = {}
    for entry in parts:
        chain = _resolve_part_chain(entry)
        if not chain:
            root_items.append(("part", entry))
            continue
        cur_items = root_items
        cur_map = root_nodes
        cur_node: dict[str, object] | None = None
        for depth_idx, seg in enumerate(chain):
            if seg not in cur_map:
                new_n = _new_tree_node(seg, chain[: depth_idx + 1])
                cur_map[seg] = new_n
                cur_items.append(("node", new_n))
            cur_node = cur_map[seg]
            _add_part_to_node(cur_node, entry)
            cur_items = cur_node["items"]  # type: ignore[assignment]
            cur_map = cur_node["children_by_name"]  # type: ignore[assignment]
        if cur_node is not None:
            cur_node["items"].append(("part", entry))  # type: ignore[union-attr]
            cur_node["direct_parts"].append(entry)  # type: ignore[union-attr]
    return root_items


HEAVY_WARN_SHARE = 25.0
HEAVY_WARN_TOK = 10000
HEAVY_ACCENT_SHARE = 10.0
HEAVY_ACCENT_TOK = 3000
_TABLE_ROW_RE = re.compile(r"^\s*(?:\d+\s+)?(\d+(?:\.\d+)?)%\s+\S+\s+\d+\s+(~\S+)\s+\[([a-z0-9_-]+)\]")
_COUNT_RE = re.compile(r"(\d+(?:\.\d+)?)([kKmM]?)")


def _heavy_level(share_pct: float, tok_hi: float) -> str:
    if share_pct >= HEAVY_WARN_SHARE or tok_hi >= HEAVY_WARN_TOK:
        return "warn"
    if share_pct >= HEAVY_ACCENT_SHARE or tok_hi >= HEAVY_ACCENT_TOK:
        return "accent"
    return ""


def _parse_tok_hi(tok_str: str) -> float:
    scale = {"": 1.0, "k": 1000.0, "m": 1000000.0}
    best = 0.0
    for num, suf in _COUNT_RE.findall(tok_str):
        best = max(best, float(num) * scale[suf.lower()])
    return best


def bundle_row_heavy_level(line: str) -> str:
    m = _TABLE_ROW_RE.match(line)
    if not m:
        return ""
    if m.group(3) == "total":
        return ""
    return _heavy_level(float(m.group(1)), _parse_tok_hi(m.group(2)))


def _tree_connector(ancestors_more: list[bool], is_last: bool) -> str:
    utf8_ok = _supports_utf8()
    bar = "│  " if utf8_ok else "|  "
    branch = ("└─ " if is_last else "├─ ") if utf8_ok else ("`- " if is_last else "|- ")
    return "".join(bar if more else "   " for more in ancestors_more) + branch


def _make_table_row(
    *,
    kind: str,
    desc: str,
    lines_cnt: int,
    chars_cnt: int,
    gpt_cnt: int,
    claude_cnt: int,
    share_pct: float,
    tree_prefix: str = "",
    part_num: str = "",
    depth: int = 0,
    part_indices: list[int] | None = None,
) -> dict[str, object]:
    return {
        "num_str": part_num,
        "depth": depth,
        "pct_str": f"{share_pct:.1f}%",
        "chars_str": re.sub(r"\s*ch$", "", _human_chars(chars_cnt, short=True)),
        "lines_str": str(lines_cnt),
        "tok_str": _format_tok_pair(gpt_cnt, claude_cnt, unit=False),
        "kind": kind,
        "tree_prefix": tree_prefix,
        "desc": desc,
        "part_indices": list(part_indices) if part_indices is not None else [],
    }


def _part_extras_suffix(p: dict[str, object], *, include_ms: bool = True) -> str:
    extras: list[str] = []
    rc_val = p.get("rc")
    if isinstance(rc_val, int) and (include_ms or rc_val != 0):
        extras.append(f"rc={rc_val}")
    if include_ms and "ms" in p:
        extras.append(f"{p['ms']}ms")
    return f" ({', '.join(extras)})" if extras else ""


def _collect_hierarchy_rows(
    plan: dict[str, object],
    *,
    details: bool,
    edited: bool = False,
) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    parts = [dict(p) for p in (plan.get("parts") or []) if isinstance(p, dict)]
    hdr = plan.get("header")
    if isinstance(hdr, dict) and (_part_chars(hdr) > 0 or int(hdr.get("lines") or 0) > 0):
        if not (parts and str(parts[0].get("kind") or "") == "header"):
            hdr_part = dict(hdr)
            hdr_part.setdefault("index", 1)
            hdr_part.setdefault("kind", "header")
            hdr_part.setdefault("name", "Headers & spacing")
            hdr_part.setdefault("chain", [])
            shifted: list[dict[str, object]] = [hdr_part]
            for idx_p, ep in enumerate(parts, 2):
                qp = dict(ep)
                qp["index"] = idx_p
                shifted.append(qp)
            parts = shifted

    if not parts:
        return []

    row_counter = 0

    def _next_row_num() -> str:
        nonlocal row_counter
        row_counter += 1
        return str(row_counter)

    def _emit_part(
        p: dict[str, object],
        parent_name: str,
        ancestors_more: list[bool],
        is_last: bool | None,
        depth: int,
    ) -> None:
        t_pfx = _tree_connector(ancestors_more, is_last) if is_last is not None else ""
        raw_lbl = _part_label(p)
        lbl = _child_rel_label(parent_name, raw_lbl) if parent_name else raw_lbl
        lbl += _part_extras_suffix(p, include_ms=details)
        idx_val = p.get("index")
        p_indices = [idx_val] if isinstance(idx_val, int) and idx_val > 0 else []
        rows.append(
            _make_table_row(
                kind=str(p.get("kind") or "part"),
                desc=lbl,
                lines_cnt=int(p.get("lines") or 0),
                chars_cnt=_part_chars(p),
                gpt_cnt=int(p.get("gpt") or 0),
                claude_cnt=int(p.get("claude") or 0),
                share_pct=float(p.get("share_pct") or 0.0),
                tree_prefix=t_pfx,
                part_num=_next_row_num(),
                depth=depth,
                part_indices=p_indices,
            )
        )

    def _emit_node(
        node: dict[str, object],
        ancestors_more: list[bool],
        is_last: bool | None,
        depth: int,
    ) -> None:
        t_pfx = _tree_connector(ancestors_more, is_last) if is_last is not None else ""
        has_children = bool(node.get("children_by_name"))
        direct_parts: list[dict[str, object]] = list(node.get("direct_parts") or [])  # type: ignore[arg-type]
        if not has_children and len(direct_parts) == 1:
            p = direct_parts[0]
            p_kind = str(p.get("kind") or "part")
            if p_kind == "rule":
                p_kind = "bundle"
            lbl = _join_chain_label([str(node["name"])], _part_label(p)) + _part_extras_suffix(p, include_ms=details)
            idx_val = p.get("index")
            p_indices = [idx_val] if isinstance(idx_val, int) and idx_val > 0 else []
            rows.append(
                _make_table_row(
                    kind=p_kind,
                    desc=lbl,
                    lines_cnt=int(p.get("lines") or 0),
                    chars_cnt=_part_chars(p),
                    gpt_cnt=int(p.get("gpt") or 0),
                    claude_cnt=int(p.get("claude") or 0),
                    share_pct=float(p.get("share_pct") or 0.0),
                    tree_prefix=t_pfx,
                    part_num=_next_row_num(),
                    depth=depth,
                    part_indices=p_indices,
                )
            )
            return
        cnt = int(node.get("total_count") or 0)
        rc_errs = int(node.get("rc_errors") or 0)
        lbl = f"{node['name']} ({cnt})" + (f" ({rc_errs} rc!=0)" if rc_errs else "")
        node_indices = [int(i) for i in (node.get("part_indices") or []) if isinstance(i, int) and i > 0]
        rows.append(
            _make_table_row(
                kind="bundle",
                desc=lbl,
                lines_cnt=int(node.get("lines") or 0),
                chars_cnt=int(node.get("chars") or 0),
                gpt_cnt=int(node.get("gpt") or 0),
                claude_cnt=int(node.get("claude") or 0),
                share_pct=float(node.get("share_pct") or 0.0),
                tree_prefix=t_pfx,
                part_num=_next_row_num(),
                depth=depth,
                part_indices=node_indices,
            )
        )
        if details or has_children:
            child_items: list[tuple[str, dict[str, object]]] = list(node.get("items") or [])  # type: ignore[arg-type]
            next_anc = ([*ancestors_more, not is_last] if is_last is not None else [])
            for c_idx, (c_type, c_obj) in enumerate(child_items):
                c_last = c_idx == len(child_items) - 1
                if c_type == "node":
                    _emit_node(c_obj, next_anc, c_last, depth + 1)
                else:
                    _emit_part(c_obj, str(node["name"]), next_anc, c_last, depth + 1)

    for it_type, it_obj in _build_bundle_tree(parts):
        if it_type == "node":
            _emit_node(it_obj, [], None, 0)
        else:
            _emit_part(it_obj, "", [], None, 0)

    part_cnt = len(parts)
    tot_lines = int(plan.get("lines") if plan.get("lines") is not None else sum(int(p.get("lines") or 0) for p in parts))
    tot_chars = int(plan.get("chars") if plan.get("chars") is not None else (plan.get("bytes") or sum(_part_chars(p) for p in parts)))
    tot_gpt = int(plan.get("gpt") if plan.get("gpt") is not None else sum(int(p.get("gpt") or 0) for p in parts))
    tot_claude = int(plan.get("claude") if plan.get("claude") is not None else sum(int(p.get("claude") or 0) for p in parts))
    tot_desc = f"{part_cnt} part{'s' if part_cnt != 1 else ''}" + (" (edited)" if edited else "")
    tot_row = _make_table_row(
        kind="total",
        desc=tot_desc,
        lines_cnt=tot_lines,
        chars_cnt=tot_chars,
        gpt_cnt=tot_gpt,
        claude_cnt=tot_claude,
        share_pct=100.0,
        part_num="",
        depth=0,
    )
    return [dict(tot_row), *rows, dict(tot_row)]


def _render_bundle_table(rows: list[dict[str, object]], max_width: int, indent: str = "  ") -> list[str]:
    if not rows:
        return []
    w_num = max(1, *(len(str(r.get("num_str") or "")) for r in rows))
    w_pct_val = max(len("%"), *(len(str(r["pct_str"])) for r in rows))
    max_depth = max((int(r.get("depth") or 0) for r in rows), default=0)
    w_pct_col = w_pct_val + max_depth * 2
    w_ch = max(len("CHARS"), *(len(str(r["chars_str"])) for r in rows))
    w_ln = max(len("LINES"), *(len(str(r["lines_str"])) for r in rows))
    w_tok = max(len("~TOK"), *(len(str(r["tok_str"])) for r in rows))
    w_kind = max(len("KIND"), *(len(f"[{r['kind']}]") for r in rows))

    pct_hdr = "%".rjust(w_pct_val).ljust(w_pct_col)
    out: list[str] = [
        f"{indent}{' ' * w_num} {pct_hdr} {'CHARS'.rjust(w_ch)} {'LINES'.rjust(w_ln)} "
        f"{'~TOK'.rjust(w_tok)}  {'KIND'.ljust(w_kind)}  SOURCE"
    ]
    for r in rows:
        num_col = str(r.get("num_str") or "").rjust(w_num)
        depth = int(r.get("depth") or 0)
        pct_col = ((" " * (depth * 2)) + str(r["pct_str"]).rjust(w_pct_val)).ljust(w_pct_col)
        kind_col = f"[{r['kind']}]".ljust(w_kind)
        cols_prefix = (
            f"{indent}{num_col} "
            f"{pct_col} "
            f"{str(r['chars_str']).rjust(w_ch)} "
            f"{str(r['lines_str']).rjust(w_ln)} "
            f"{str(r['tok_str']).rjust(w_tok)}  "
            f"{kind_col}  "
        )
        full_pfx = f"{cols_prefix}{r.get('tree_prefix') or ''}"
        sub_indent = " " * display_width(full_pfx)
        avail = max(16, max_width - display_width(full_pfx))
        desc = str(r.get("desc") or "")
        wrapped = textwrap.wrap(desc, width=avail, break_long_words=True, break_on_hyphens=False) or [desc]
        out.append(full_pfx + wrapped[0])
        for cont in wrapped[1:]:
            out.append(sub_indent + cont)
    return out


def format_bundle_summary_lines(plan: dict[str, object], max_width: int = 120, *, edited: bool = False) -> list[str]:
    return _render_bundle_table(_collect_hierarchy_rows(plan, details=False, edited=edited), max_width=max_width)


def format_bundle_parts_lines(plan: dict[str, object], max_width: int = 120, *, edited: bool = False) -> list[str]:
    return _render_bundle_table(_collect_hierarchy_rows(plan, details=True, edited=edited), max_width=max_width)


def format_bundle_group_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    if not parts:
        return []
    groups = group_bundle_parts(parts)
    items: list[tuple[str, str]] = []
    for g in groups:
        kind = str(g.get("kind") or "part")
        chain = [str(x) for x in (g.get("chain") or []) if str(x)]
        grp = str(g.get("group") or "")
        cnt = int(g.get("count") or 0)
        names = list(g.get("names") or [])
        if chain:
            if cnt == 1 and names:
                lbl = _join_chain_label(chain, str(names[0]))
            elif cnt > 1:
                lbl = f"{grp} ({cnt})"
            else:
                lbl = grp
        elif cnt == 1 and names:
            lbl = str(names[0])
        else:
            lbl = f"{cnt} part" + ("s" if cnt != 1 else "")
        lines_cnt = int(g.get("lines") or 0)
        chars_cnt = int(g.get("chars") if g.get("chars") is not None else (g.get("bytes") or 0))
        gpt_cnt = int(g.get("gpt") or 0)
        claude_cnt = int(g.get("claude") or 0)
        share = float(g.get("share_pct") or 0.0)
        err_cnt = int(g.get("rc_errors") or 0)
        meta = f"{lines_cnt}L · {_human_chars(chars_cnt, short=True)} · {_format_tok_pair(gpt_cnt, claude_cnt)} ({share:.1f}%)"
        if err_cnt:
            meta += f" · {err_cnt} rc!=0"
        items.append((kind, f"{lbl}  [{meta}]"))
    return items


def format_bundle_part_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    items: list[tuple[str, str]] = []
    for p in parts:
        kind = str(p.get("kind") or "part")
        chain = _resolve_part_chain(p)
        lbl = _join_chain_label(chain, _part_label(p))
        lines_cnt = int(p.get("lines") or 0)
        chars_cnt = _part_chars(p)
        gpt_cnt = int(p.get("gpt") or 0)
        claude_cnt = int(p.get("claude") or 0)
        share = float(p.get("share_pct") or 0.0)
        extras: list[str] = [f"{lines_cnt}L", _human_chars(chars_cnt, short=True), f"{_format_tok_pair(gpt_cnt, claude_cnt)} ({share:.1f}%)"]
        if "rc" in p:
            extras.append(f"rc={p['rc']}")
        if "ms" in p:
            extras.append(f"{p['ms']}ms")
        items.append((kind, f"{lbl}  [{' · '.join(extras)}]"))
    return items


def format_bundle_warning_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    warns = [w for w in (plan.get("warnings") or []) if isinstance(w, dict)]
    return [
        (str(w.get("code") or "warn"), str(w.get("message") or ""))
        for w in warns
        if w.get("message")
    ]


def _enrich_bundle_plan(plan: dict[str, object], full_text: str | None = None) -> dict[str, object]:
    out = dict(plan)
    parts = [dict(p) for p in (out.get("parts") or []) if isinstance(p, dict)]
    for part in parts:
        if part.get("chars") is None:
            part["chars"] = int(part.get("bytes") or 0)
    out["parts"] = parts
    if out.get("chars") is None:
        out["chars"] = int(out.get("bytes") or sum(_part_chars(p) for p in parts))
    has_hdr_part = bool(parts and str(parts[0].get("kind") or "") == "header")
    if full_text is not None and not has_hdr_part:
        out = reconcile_bundle_plan(out, full_text)
    if "warnings" not in out:
        out["warnings"] = analyze_bundle_warnings(parts, total_gpt=int(out.get("gpt") or 0))
    return out


def load_session_bundle_plan(sdir: Path | None, bundle_path: Path | None = None) -> dict[str, object] | None:
    meta = read_session_meta(sdir) if sdir is not None else {}
    raw_plan = meta.get("bundle_plan")
    bpath = bundle_path if bundle_path is not None else (sdir / "0" if sdir is not None else None)
    btext = bpath.read_text(encoding="utf-8", errors="replace") if (bpath is not None and bpath.is_file()) else None
    if isinstance(raw_plan, dict) and "parts" in raw_plan and "warnings" in raw_plan:
        return _enrich_bundle_plan(raw_plan, full_text=btext)
    if btext is not None:
        _, body = parse_stdin_preamble(btext)
        meta_hdrs = _parse_meta_header_items(sdir) if sdir is not None else []
        boundary = get_bundle_boundary(meta_hdrs)
        _, parsed_plan = parse_bundle_fragments(body, boundary=boundary)
        if isinstance(raw_plan, dict) and raw_plan.get("protocol") == "boundary" and parsed_plan.get("protocol") != "boundary":
            return _enrich_bundle_plan(raw_plan, full_text=btext)
        return reconcile_bundle_plan(parsed_plan, btext)
    if isinstance(raw_plan, dict):
        return _enrich_bundle_plan(raw_plan)
    return None


def format_bundle_plan_text(
    plan: dict[str, object],
    *,
    full: bool = False,
    session: str | None = None,
) -> str:
    protocol = str(plan.get("protocol") or "empty")
    part_cnt = int(plan.get("part_count") or 0)
    lines_cnt = int(plan.get("lines") or 0)
    chars_cnt = int(plan.get("chars") if plan.get("chars") is not None else (plan.get("bytes") or 0))
    gpt_cnt = int(plan.get("gpt") or 0)
    claude_cnt = int(plan.get("claude") or 0)
    hdr_target = session if session else "stdin"
    out_lines: list[str] = [
        f"Bundle Plan ({hdr_target}, protocol: {protocol}):",
        f"Total: {lines_cnt} line{'s' if lines_cnt != 1 else ''} · {_human_chars(chars_cnt)} · {_format_tok_pair(gpt_cnt, claude_cnt)} ({part_cnt} part{'s' if part_cnt != 1 else ''})",
    ]
    sum_lines = format_bundle_summary_lines(plan, max_width=120)
    if sum_lines:
        out_lines.append("")
        out_lines.append(f"Summary ({part_cnt} part{'s' if part_cnt != 1 else ''}):")
        out_lines.extend(sum_lines)
    if full:
        part_lines = format_bundle_parts_lines(plan, max_width=120)
        if part_lines:
            out_lines.append("")
            out_lines.append(f"Parts ({part_cnt}):")
            out_lines.extend(part_lines)
    warn_items = format_bundle_warning_items(plan)
    if warn_items:
        out_lines.append("")
        out_lines.append(f"Warnings ({len(warn_items)}):")
        out_lines.extend(_wrap_labeled_items(warn_items, 120, indent="  "))
    return "\n".join(out_lines) + "\n"


def cmd_bundle_plan(argv: list[str], stdin_text: str | None = None) -> int:
    prog = prog_name()
    usage = f"{prog} --bundle-plan [<session>] [--json] [--full] [--part N]"
    argv, part_no = parse_part_option(argv, usage)
    as_json = False
    full = False
    session_arg: str | None = None
    for a in argv:
        if a == "--json":
            as_json = True
        elif a == "--full":
            full = True
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: usage: {usage}")
        elif session_arg is None:
            session_arg = a
        else:
            raise SystemExit(f"{prog}: usage: {usage}")
    if part_no is not None and (as_json or full):
        raise SystemExit(f"{prog}: --part cannot be combined with --json or --full")

    plan: dict[str, object] | None = None
    plan_text: str | None = None
    if session_arg is not None:
        sess = session_arg.split("/", 1)[0] if session_arg.endswith("/0") else session_arg
        if not re.fullmatch(r"[A-Za-z0-9._-]+", sess):
            raise SystemExit(f"{prog}: invalid session name: {session_arg!r}")
        sdir = BASE_DIR / sess
        if not sdir.is_dir():
            raise SystemExit(f"{prog}: session {sess!r} not found in {BASE_DIR}")
        plan = load_session_bundle_plan(sdir)
        if plan is None:
            raise SystemExit(f"{prog}: no bundle data found for session {sess!r}")
        session_arg = sess
        bundle_file = sdir / "0"
        if bundle_file.is_file():
            plan_text = bundle_file.read_text(encoding="utf-8", errors="replace")
    else:
        if stdin_text is None:
            if sys.stdin.isatty():
                sys.stderr.write(
                    f"{prog}: --bundle-plan expects a session name or a bundle on stdin "
                    f"(e.g. '{prog} --bundle-plan s1' or 'cat bundle.txt | {prog} --bundle-plan')\n"
                )
                return 2
            stdin_text = sys.stdin.read()
        stdin_headers, raw_body = parse_stdin_preamble(stdin_text)
        boundary = get_bundle_boundary(stdin_headers)
        plan_text, plan = parse_bundle_fragments(raw_body, boundary=boundary)

    if part_no is not None:
        target = f"{session_arg}/0" if session_arg is not None else "stdin"
        if plan_text is None:
            raise SystemExit(f"{prog}: bundle text for {target} not found")
        try:
            entry, chunk = extract_bundle_part(plan, plan_text, part_no)
        except ValueError as exc:
            raise SystemExit(f"{prog}: {target}: {exc}")
        sys.stderr.write(format_part_header(target, entry, int(plan.get("part_count") or 0)))
        sys.stdout.write(chunk)
        sys.stdout.flush()
        return 0

    if as_json:
        payload = dict(plan)
        if session_arg is not None:
            payload["session"] = session_arg
        sys.stdout.write(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
    else:
        sys.stdout.write(format_bundle_plan_text(plan, full=full, session=session_arg))
    sys.stdout.flush()
    return 0


def ensure_base() -> Path:
    BASE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        BASE_DIR.chmod(0o700)
    except OSError:
        pass
    return BASE_DIR


def next_session_name(base: Path) -> str:
    used = set()
    for p in base.iterdir():
        m = re.fullmatch(r"s(\d+)", p.name)
        if m:
            used.add(int(m.group(1)))
    n = 1
    while n in used:
        n += 1
    return f"s{n}"


def start_session(name: str | None = None, force: bool = False, sandbox_mode: str | None = None) -> Path:
    base = ensure_base()
    _warn_if_state_oversized(base)
    if not name:
        name = next_session_name(base)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        raise SystemExit(f"{prog_name()}: invalid session name: {name!r}")
    sdir = base / name
    if sdir.exists():
        if not force:
            raise SystemExit(f"{prog_name()}: session {sdir} already exists (use --force to overwrite)")
        shutil.rmtree(sdir)
    sdir.mkdir(mode=0o700, parents=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_mode)
    return sdir


def parse_ref(ref: str, allow_fix_step: bool) -> tuple[str, str]:
    pattern = r"^([A-Za-z0-9._-]+)/(\d+(?:_\d+)?)$" if allow_fix_step else r"^([A-Za-z0-9._-]+)/(\d+)$"
    m = re.fullmatch(pattern, ref.strip())
    if not m:
        kind = "<session>/<step> (e.g. s1/2 or s1/2_1)" if allow_fix_step else "<session>/<step> (e.g. s1/1)"
        raise SystemExit(f"{prog_name()}: invalid block reference {ref!r}; expected {kind}")
    return m.group(1), m.group(2)


def next_free_step(sdir: Path, min_step: int = 1) -> int:
    used: set[int] = set()
    if sdir.is_dir():
        for p in sdir.iterdir():
            if p.is_dir():
                m = re.fullmatch(r"(\d+)(?:_\d+)?", p.name)
                if m:
                    used.add(int(m.group(1)))
    candidate = max(min_step, (max(used) + 1) if used else 1)
    while candidate in used:
        candidate += 1
    return candidate


def first_missing_step(sdir: Path) -> int:
    n = 1
    while True:
        step_dir = _step_dir(sdir, str(n))
        has_script = _find_step_script(sdir, str(n)).exists()
        has_out = (step_dir / "out").exists()
        is_aborted = (step_dir / "aborted").exists()
        if (not has_script and not has_out) or is_aborted:
            return n
        n += 1


def _rewrite_script_step_header(script_text: str, old_label: str, new_label: str) -> str:
    lines = script_text.splitlines(keepends=True)
    if not lines:
        return script_text
    pat = re.compile(
        rf"^(\s*#\s*(?:run_block|Block|Next-Block)\s*:\s*){re.escape(old_label)}(\s*)$"
    )
    for idx in range(min(3, len(lines))):
        line_body = lines[idx].rstrip("\r\n")
        eol = lines[idx][len(line_body) :]
        m = pat.match(line_body)
        if m:
            lines[idx] = f"{m.group(1)}{new_label}{m.group(2)}{eol}"
            break
    return "".join(lines)


def next_fix_step(step: str, sdir: Path | None = None) -> str:
    base = step.split("_", 1)[0]
    min_next = 1
    if "_" in step:
        _, sub = step.split("_", 1)
        if sub.isdigit():
            min_next = int(sub) + 1
    if sdir is not None and sdir.is_dir():
        max_n = 0
        pat = re.compile(rf"^{re.escape(base)}_(\d+)$")
        for p in sdir.iterdir():
            m = pat.match(p.name)
            if m and p.is_dir():
                max_n = max(max_n, int(m.group(1)))
        return f"{base}_{max(min_next, max_n + 1)}"
    return f"{base}_{min_next}"


_CMP_OP_SYMBOLS: dict[type[ast.cmpop], str] = {
    ast.Eq: "==",
    ast.NotEq: "!=",
    ast.Lt: "<",
    ast.LtE: "<=",
    ast.Gt: ">",
    ast.GtE: ">=",
    ast.Is: "is",
    ast.IsNot: "is not",
    ast.In: "in",
    ast.NotIn: "not in",
}


def _short_repr(val: object, limit: int = 80) -> str:
    r = repr(val)
    if len(r) > limit:
        return r[: limit - 3] + "..."
    return r


def _format_fix_exception(
    exc: BaseException, fix_code: str, fix_path: Path, ns: dict[str, object]
) -> str:
    lineno: int | None = getattr(exc, "lineno", None)
    tb = exc.__traceback__
    while tb is not None:
        if tb.tb_frame.f_code.co_filename == str(fix_path):
            lineno = tb.tb_lineno
        tb = tb.tb_next

    lines = fix_code.splitlines()
    stmt_node: ast.stmt | None = None
    if lineno is not None:
        try:
            tree = ast.parse(fix_code)
            for node in ast.walk(tree):
                if isinstance(node, ast.stmt) and hasattr(node, "lineno"):
                    end_ln = getattr(node, "end_lineno", node.lineno) or node.lineno
                    if node.lineno <= lineno <= end_ln:
                        if stmt_node is None or node.lineno >= stmt_node.lineno:
                            stmt_node = node
        except Exception:
            stmt_node = None

    stmt_str = ""
    if stmt_node is not None:
        seg = ast.get_source_segment(fix_code, stmt_node)
        if seg:
            stmt_str = " ".join(l.strip() for l in seg.splitlines() if l.strip())
    if not stmt_str and lineno is not None and 1 <= lineno <= len(lines):
        stmt_str = lines[lineno - 1].strip()

    actual_part = ""
    if (
        isinstance(exc, AssertionError)
        and isinstance(stmt_node, ast.Assert)
        and isinstance(stmt_node.test, ast.Compare)
        and len(stmt_node.test.ops) == 1
        and len(stmt_node.test.comparators) == 1
    ):
        op_sym = _CMP_OP_SYMBOLS.get(type(stmt_node.test.ops[0]))
        if op_sym:
            try:
                left_expr = ast.Expression(body=stmt_node.test.left)
                right_expr = ast.Expression(body=stmt_node.test.comparators[0])
                ast.fix_missing_locations(left_expr)
                ast.fix_missing_locations(right_expr)
                left_val = eval(compile(left_expr, "<fix_eval>", "eval"), ns)
                right_val = eval(compile(right_expr, "<fix_eval>", "eval"), ns)
                actual_part = f" (actual: {_short_repr(left_val)} {op_sym} {_short_repr(right_val)})"
            except Exception:
                actual_part = ""

    exc_name = type(exc).__name__
    exc_msg = str(exc).strip()
    if lineno is not None and stmt_str:
        loc_str = f"at line {lineno}: {stmt_str}{actual_part}"
        if exc_msg:
            return f"fix raised {exc_name}: {exc_msg} ({loc_str})"
        return f"fix raised {exc_name} {loc_str}"
    if exc_msg:
        return f"fix raised {exc_name}: {exc_msg}"
    return f"fix raised {exc_name}"


def _find_fix_chain_scripts(sdir: Path, base_step: str) -> list[tuple[str, Path]]:
    chain: list[tuple[str, Path]] = []
    base_script = _find_step_script(sdir, base_step)
    if base_script.is_file():
        chain.append((base_step, base_script))
    if sdir.is_dir():
        fix_items: list[tuple[int, str, Path]] = []
        pat = re.compile(rf"^{re.escape(base_step)}_(\d+)$")
        for d in sdir.iterdir():
            m = pat.match(d.name)
            if m and d.is_dir():
                sub_idx = int(m.group(1))
                step_name = f"{base_step}_{sub_idx}"
                sp = _find_step_script(sdir, step_name)
                if sp.is_file():
                    fix_items.append((sub_idx, step_name, sp))
        for _, step_name, p in sorted(fix_items, key=lambda x: x[0]):
            chain.append((step_name, p))
    return chain


def _consecutive_failed_fixes(sdir: Path, base_step: str) -> int:
    if not sdir.is_dir():
        return 0
    indices: set[int] = set()
    pat = re.compile(rf"^{re.escape(base_step)}_(\d+)$")
    for d in sdir.iterdir():
        m = pat.match(d.name)
        if m and d.is_dir():
            indices.add(int(m.group(1)))
    failures = 0
    for idx in sorted(indices):
        stem = f"{base_step}_{idx}"
        st = _step_status(sdir, stem)
        if st == "ABORTED":
            continue
        if st == "END":
            failures = 0
        else:
            failures += 1
    return failures


def write_private(path: Path, content: str, overwrite: bool = False) -> None:
    flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if overwrite else os.O_EXCL)
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


_EMBEDDED_PY_HEREDOC_RE = re.compile(r"\bpython3?(?:\s+[^\n]*?)?<<-?\s*['\"]?([A-Za-z0-9_]+)['\"]?")
_STDIN_TB_LINE_RE = re.compile(r'File "<stdin>", line (\d+)(?:, in ([^\n]+))?')


def _extract_python_heredoc_bodies(script_text: str) -> list[list[str]]:
    bodies: list[list[str]] = []
    eof_token: str | None = None
    strip_tabs = False
    cur_lines: list[str] = []
    for raw in script_text.splitlines():
        if eof_token is not None:
            cmp_line = raw.lstrip("\t") if strip_tabs else raw
            if cmp_line.strip() == eof_token:
                bodies.append(cur_lines)
                eof_token = None
                strip_tabs = False
                cur_lines = []
            else:
                cur_lines.append(cmp_line if strip_tabs else raw)
            continue
        m = _EMBEDDED_PY_HEREDOC_RE.search(raw)
        if m:
            eof_token = m.group(1)
            strip_tabs = "<<-" in raw
            cur_lines = []
    if eof_token is not None and cur_lines:
        bodies.append(cur_lines)
    return bodies


def _resolve_python_stdin_tracebacks(label: str, script_text: str, output_text: str) -> list[str]:
    matches = _STDIN_TB_LINE_RE.findall(output_text)
    if not matches:
        return []
    heredocs = _extract_python_heredoc_bodies(script_text)
    if not heredocs:
        return []
    resolved: list[str] = []
    seen: set[tuple[int, str]] = set()
    for raw_ln, raw_func in matches:
        try:
            lineno = int(raw_ln)
        except ValueError:
            continue
        if lineno < 1:
            continue
        func_name = (raw_func or "").strip()
        chosen_body: list[str] | None = None
        if len(heredocs) == 1:
            if lineno <= len(heredocs[0]):
                chosen_body = heredocs[0]
        else:
            if func_name and func_name != "<module>":
                def_pat = re.compile(rf"^\s*(?:async\s+)?def\s+{re.escape(func_name)}\b")
                for body in reversed(heredocs):
                    if lineno <= len(body) and any(def_pat.match(ln) for ln in body):
                        chosen_body = body
                        break
            if chosen_body is None:
                for body in reversed(heredocs):
                    if lineno <= len(body):
                        chosen_body = body
                        break
        if chosen_body is None:
            continue
        src_line = chosen_body[lineno - 1].strip()
        if not src_line:
            continue
        key = (lineno, src_line)
        if key in seen:
            continue
        seen.add(key)
        resolved.append(f"[{label}] <stdin> line {lineno}: {src_line}")
    return resolved


def not_run_exit(
    label: str,
    sdir: Path,
    step_name: str,
    out_path: Path,
    msg: str,
    rc: int = 2,
    headless: bool = False,
    fix_target: str | None = None,
) -> int:
    step_dir = _step_dir(sdir, step_name)
    step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    line = msg if msg.endswith("\n") else msg + "\n"
    clean_msg = msg.strip()
    prefix = f"[{label}] NOT RUN:"
    detail = clean_msg[len(prefix):].strip() if clean_msg.startswith(prefix) else clean_msg
    detail_lines = detail.splitlines() or [detail]
    err_target = step_dir / "error" if out_path.exists() else out_path
    try:
        write_private(err_target, line, overwrite=True)
    except Exception:
        pass
    is_headless = headless or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    if is_headless:
        sys.stdout.write(line)
        sys.stdout.flush()
        return rc
    body_lines: list[str] = []
    if fix_target:
        body_lines.append(f"Target: {fix_target} -> {label}")
    body_lines.append(f"Reason: {detail_lines[0]}")
    stop_pat = re.compile(rf"^(?:\[{re.escape(label)}\]\s*)?STOP --fix:\s*(.*)$")
    for dline in detail_lines[1:]:
        m_stop = stop_pat.match(dline.strip())
        if m_stop:
            body_lines.append(f"Guard: {m_stop.group(1).strip()}")
        else:
            body_lines.append(f"  {dline}")
    body_lines.append(f"Output: {err_target}")
    can_prompt_clip = (
        not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(err_target) is not None
    )
    if can_prompt_clip:
        offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines, sdir=sdir)
    else:
        full_body = build_box_body_lines(
            err_target, rc=rc, stats=stats_line(err_target), extra_lines=body_lines, label=label, sdir=sdir
        )
        sys.stdout.write(format_info_box("NOT RUN", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines, sdir=sdir)
    return rc


class _ProgressLineFilter:
    def __init__(
        self,
        step_map: dict[int, dict[str, object]],
        total_steps: int,
        marker_prefix: str = "__RB_STEP__:",
        clock: object = None,
        is_tty: bool | None = None,
    ) -> None:
        self.step_map = step_map
        self.total_steps = total_steps
        self.marker_prefix = marker_prefix
        self.buf = ""
        self._marker_re = re.compile(rf"^{re.escape(marker_prefix)}(\d+)\r?$")
        self._clock = clock if callable(clock) else time.monotonic
        if is_tty is None:
            try:
                self._is_tty = bool(sys.stdout.isatty())
            except Exception:
                self._is_tty = False
        else:
            self._is_tty = bool(is_tty)
        self.active_step: int | None = None
        self._active_started: float | None = None
        self._active_has_output: bool = False
        self.step_durations: dict[int, float] = {}
        self.step_order: list[int] = []

    def mark_output(self) -> None:
        if self.active_step is not None:
            self._active_has_output = True

    @staticmethod
    def _truncate_width(text: str, max_w: int) -> str:
        if display_width(text) <= max_w:
            return text
        if max_w <= 3:
            out_chars: list[str] = []
            cur_w = 0
            for ch in text:
                cw = display_width(ch)
                if cur_w + cw > max(0, max_w):
                    break
                out_chars.append(ch)
                cur_w += cw
            return "".join(out_chars)
        out_chars = []
        cur_w = 0
        limit = max_w - 3
        for ch in text:
            cw = display_width(ch)
            if cur_w + cw > limit:
                break
            out_chars.append(ch)
            cur_w += cw
        return "".join(out_chars).rstrip() + "..."

    def _format_step_banner(self, step_num: int) -> str:
        info = self.step_map.get(step_num)
        if not info:
            return ""
        tag = str(info.get("tag") or "")
        desc = str(info.get("desc") or "").replace("\n", " ").strip()
        prefix = f"[{step_num}/{self.total_steps}]"
        if tag:
            prefix = f"{prefix} [{tag}]"
        max_cols = max(40, _hr_width() - 4)
        avail = max(16, max_cols - len(prefix) - 1)
        if len(desc) > avail:
            desc = desc[: avail - 3] + "..."
        line = f"{prefix} {desc}".rstrip()
        arrow = "▸" if _supports_utf8() else ">"
        if _use_color():
            return f"\x1b[90m{arrow} {line}\x1b[0m\n"
        return f"{arrow} {line}\n"

    def _format_step_done(
        self,
        step_num: int,
        elapsed: float,
        failed: bool = False,
        collapsed: bool = False,
    ) -> str:
        info = self.step_map.get(step_num)
        if info is None:
            return ""
        dur_str = format_duration(elapsed)
        mark = ("✗" if failed else "✓") if _supports_utf8() else ("x" if failed else "+")
        if collapsed:
            tag = str(info.get("tag") or "")
            desc = str(info.get("desc") or "").replace("\n", " ").strip()
            prefix = f"{mark} [{step_num}/{self.total_steps}]"
            if tag:
                prefix = f"{prefix} [{tag}]"
            suffix = f"({dur_str})"
            max_cols = _hr_width()
            if desc:
                avail = max_cols - display_width(prefix) - display_width(suffix) - 2
                if avail >= 4:
                    desc = self._truncate_width(desc, avail)
                    line = f"{prefix} {desc} {suffix}"
                elif avail > 0 and display_width(desc) <= avail:
                    line = f"{prefix} {desc} {suffix}"
                else:
                    line = f"{prefix} {suffix}"
            else:
                line = f"{prefix} {suffix}"
            line = self._truncate_width(line, max_cols)
            ctrl = "\033[1A\r\033[2K"
        else:
            line = f"{mark} [{step_num}/{self.total_steps}] ({dur_str})"
            ctrl = ""
        if _use_color():
            col = "\x1b[31m" if failed else "\x1b[90m"
            return f"{ctrl}{col}{line}\x1b[0m\n"
        return f"{ctrl}{line}\n"

    def _start_step(self, step_num: int) -> str:
        now = float(self._clock())
        parts: list[str] = []
        if self.active_step is not None and self._active_started is not None:
            elapsed = max(0.0, now - self._active_started)
            self.step_durations[self.active_step] = elapsed
            collapsed = self._is_tty and not self._active_has_output
            done_line = self._format_step_done(
                self.active_step, elapsed, collapsed=collapsed
            )
            if done_line:
                parts.append(done_line)
        self.active_step = step_num
        self._active_started = now
        self._active_has_output = False
        if step_num not in self.step_order:
            self.step_order.append(step_num)
        banner = self._format_step_banner(step_num)
        if banner:
            parts.append(banner)
        return "".join(parts)

    def feed_events(self, text: str) -> list[tuple[str, str]]:
        self.buf += text
        events: list[tuple[str, str]] = []
        while "\n" in self.buf:
            line, rest = self.buf.split("\n", 1)
            self.buf = rest
            m = self._marker_re.match(line)
            if m:
                prog = self._start_step(int(m.group(1)))
                if prog:
                    events.append(("prog", prog))
            else:
                if self.active_step is not None:
                    self._active_has_output = True
                events.append(("out", line + "\n"))
        if self.buf:
            if not (
                self.marker_prefix.startswith(self.buf)
                or self.buf.startswith(self.marker_prefix)
            ):
                if self.active_step is not None:
                    self._active_has_output = True
                events.append(("out", self.buf))
                self.buf = ""
        return events

    def feed(self, text: str) -> tuple[str, str]:
        out_parts: list[str] = []
        prog_parts: list[str] = []
        for kind, chunk in self.feed_events(text):
            if kind == "prog":
                prog_parts.append(chunk)
            else:
                out_parts.append(chunk)
        return "".join(out_parts), "".join(prog_parts)

    def flush(self, rc: int = 0) -> tuple[str, str]:
        rem_out = ""
        prog_parts: list[str] = []
        if self.buf:
            rem = self.buf
            self.buf = ""
            m = self._marker_re.match(rem)
            if m:
                prog = self._start_step(int(m.group(1)))
                if prog:
                    prog_parts.append(prog)
            else:
                if self.active_step is not None:
                    self._active_has_output = True
                rem_out = rem
        if self.active_step is not None and self._active_started is not None:
            elapsed = max(0.0, float(self._clock()) - self._active_started)
            self.step_durations[self.active_step] = elapsed
            collapsed = self._is_tty and not self._active_has_output
            done_line = self._format_step_done(
                self.active_step, elapsed, failed=(rc != 0), collapsed=collapsed
            )
            if done_line:
                prog_parts.append(done_line)
            self._active_started = None
        return rem_out, "".join(prog_parts)

    def operation_timings(self) -> list[dict[str, object]]:
        timings: list[dict[str, object]] = []
        for step_num in self.step_order:
            if step_num not in self.step_durations:
                continue
            info = self.step_map.get(step_num) or {}
            timings.append(
                {
                    "step": step_num,
                    "tag": str(info.get("tag") or ""),
                    "desc": str(info.get("desc") or "").replace("\n", " ").strip(),
                    "duration_ms": int(round(self.step_durations[step_num] * 1000.0)),
                }
            )
        return timings


def _prepare_progress_script(
    script_text: str,
    step_dir: Path,
    step_lines: list[dict[str, object]],
    shell_bin: str,
    is_ps: bool,
    work_dir: Path,
) -> Path | None:
    if not step_lines:
        return None
    inst_text = instrument_script_for_progress(
        script_text, step_lines=step_lines, is_powershell=is_ps
    )
    if inst_text == script_text:
        return None
    ext = ".ps1" if is_ps else ".sh"
    fd, tmp_name = tempfile.mkstemp(prefix=".progress_", suffix=ext, dir=step_dir)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(inst_text)
        os.chmod(tmp_path, 0o600)
        if is_ps:
            ps_check = (
                "$err = $null; "
                "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
                "if ($err) { exit 1 }"
            )
            chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(tmp_path)]
        else:
            chk_cmd = [shell_bin, "-n", str(tmp_path)]
        chk = subprocess.run(
            chk_cmd,
            cwd=work_dir,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if chk.returncode != 0:
            tmp_path.unlink(missing_ok=True)
            return None
        return tmp_path
    except Exception:
        tmp_path.unlink(missing_ok=True)
        return None


def _iter_child_streams(out_fd, err_fd):
    """Yield (is_err, text) chunks read from two child descriptors."""
    if os.name != "nt":
        fds = [out_fd, err_fd]
        while fds:
            try:
                rlist, _, _ = select.select(fds, [], [])
            except OSError:
                break
            if out_fd in fds and out_fd not in rlist:
                try:
                    r_out, _, _ = select.select([out_fd], [], [], 0.001)
                except OSError:
                    r_out = []
                if r_out:
                    rlist = [out_fd] + list(rlist)
            for fd in list(fds):
                if fd not in rlist:
                    continue
                try:
                    chunk = os.read(fd, 4096)
                except OSError:
                    chunk = b""
                if not chunk:
                    fds.remove(fd)
                    continue
                yield (fd == err_fd), chunk.decode("utf-8", "replace")
                break
        return

    q: queue.Queue = queue.Queue()

    def _reader(fd, is_err):
        while True:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if not chunk:
                break
            q.put((is_err, chunk))
        q.put((is_err, None))

    threads = [
        threading.Thread(target=_reader, args=(fd, flag), daemon=True)
        for fd, flag in ((out_fd, False), (err_fd, True))
    ]
    for th in threads:
        th.start()
    pending = len(threads)
    while pending:
        is_err, chunk = q.get()
        if chunk is None:
            pending -= 1
            continue
        yield is_err, chunk.decode("utf-8", "replace")
    for th in threads:
        th.join()


def _validate_step_script_syntax(
    label: str,
    script_path: Path,
    out_path: Path,
    work_dir: Path,
    shell_bin: str,
    is_ps: bool,
    sdir: Path,
    headless: bool = False,
    footer_on_fail: str | None = None,
    renumbered_from: str | None = None,
) -> int:
    if is_ps:
        ps_check = (
            "$err = $null; "
            "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
            "if ($err) { foreach ($e in $err) { [Console]::Error.WriteLine($e.ToString()) }; exit 1 }"
        )
        chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(script_path)]
    else:
        chk_cmd = [shell_bin, "-n", str(script_path)]
    chk = subprocess.run(
        chk_cmd,
        cwd=work_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if chk.returncode == 0:
        return 0
    renum_note = (
        f"[{label}] Note: renumbered from {renumbered_from} to {label}; continue from {label}.\n"
        if renumbered_from else ""
    )
    start_line = f"[{label}] START\n{renum_note}\n"
    msg = chk.stdout or "syntax check failed\n"
    end_line = f"[{label}] END (syntax error, exit {chk.returncode})\n"
    if footer_on_fail:
        end_line += footer_on_fail if footer_on_fail.endswith("\n") else footer_on_fail + "\n"
    full_output = start_line + msg + end_line
    write_private(out_path, full_output, overwrite=True)
    if headless:
        sys.stdout.write(full_output)
        sys.stdout.flush()
        return chk.returncode
    err_lines = msg.rstrip("\n").splitlines() or ["syntax check failed"]
    box_lines = [
        f"Exit: {chk.returncode}",
        f"Script: {script_path}",
        f"Output: {out_path}",
        f"Error: {err_lines[0]}",
        *(f"  {eline}" for eline in err_lines[1:]),
    ]
    can_prompt_clip = (
        not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(out_path) is not None
    )
    if can_prompt_clip:
        offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines, sdir=sdir)
    else:
        full_body = build_box_body_lines(
            out_path, rc=chk.returncode, stats=stats_line(out_path), extra_lines=box_lines, label=label, sdir=sdir
        )
        sys.stdout.write(format_info_box("SYNTAX ERROR", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines, sdir=sdir)
    return chk.returncode


def run_script(
    label: str,
    script_path: Path,
    out_path: Path,
    header_lines: list[str] | None = None,
    cleanup_on_abort: list[Path] | None = None,
    auto_yes: bool = False,
    sandbox_override: str | None = None,
    footer_on_fail: str | None = None,
    renumbered_from: str | None = None,
) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    step_dir = script_path.parent
    sdir = step_dir.parent
    work_dir = get_work_dir(sdir)
    sandbox_mode = get_sandbox_mode(sdir, override=sandbox_override)
    shell_bin, _ = get_setting("shell")
    is_ps = _is_powershell(shell_bin)
    script_text = script_path.read_text(encoding="utf-8")
    exec_cmd = (
        [shell_bin, "-NoProfile", "-File", str(script_path)]
        if is_ps
        else [shell_bin, str(script_path)]
    )

    rc_syn = _validate_step_script_syntax(
        label,
        script_path,
        out_path,
        work_dir,
        shell_bin,
        is_ps,
        sdir,
        headless=headless,
        footer_on_fail=footer_on_fail,
        renumbered_from=renumbered_from,
    )
    if rc_syn != 0:
        return rc_syn

    aborted_marker = step_dir / "aborted"
    summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
    summary_obj["sandbox"] = sandbox_mode
    approved, abort_reason = confirm_execution(
        label, script_text, summary=summary_obj, script_path=script_path, auto_yes=headless
    )
    if not approved:
        write_private(aborted_marker, "aborted\n", overwrite=True)
        if abort_reason == "USER_ABORTED":
            return 130
        reason_str = abort_reason or f"aborted by user (re-run with: {prog_name()} --retry {label})"
        return not_run_exit(
            label, sdir, step_dir.name, out_path, f"[{label}] NOT RUN: {reason_str}", rc=130, headless=headless
        )
    aborted_marker.unlink(missing_ok=True)

    if script_path.is_file():
        updated_text = script_path.read_text(encoding="utf-8")
        if updated_text != script_text:
            script_text = updated_text
            rc_syn = _validate_step_script_syntax(
                label,
                script_path,
                out_path,
                work_dir,
                shell_bin,
                is_ps,
                sdir,
                headless=headless,
                footer_on_fail=footer_on_fail,
                renumbered_from=renumbered_from,
            )
            if rc_syn != 0:
                return rc_syn
            summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
            summary_obj["sandbox"] = sandbox_mode

    start_line = f"[{label}] START\n"
    log_chunks: list[str] = [start_line]
    if renumbered_from:
        log_chunks.append(f"[{label}] Note: renumbered from {renumbered_from} to {label}; continue from {label}.\n")
    err_chunks: list[str] = []

    def _emit(text: str, is_err: bool) -> None:
        if is_err:
            err_chunks.append(text)
            log_chunks.append(text)
            if progress_filter is not None and text:
                progress_filter.mark_output()
            sys.stdout.write(text)
            sys.stdout.flush()
            return
        if progress_filter is not None:
            events = progress_filter.feed_events(text)
            for kind, chunk in events:
                if kind == "out":
                    log_chunks.append(chunk)
                sys.stdout.write(chunk)
            if events:
                sys.stdout.flush()
        else:
            log_chunks.append(text)
            sys.stdout.write(text)
            sys.stdout.flush()
    for h in header_lines or []:
        log_chunks.append(h)
    log_chunks.append("\n")
    if headless:
        sys.stdout.write("".join(log_chunks))
    elif header_lines:
        sys.stdout.write("".join(header_lines) + "\n")
    sys.stdout.flush()

    tty_in = None
    master_fd = None
    slave_fd = None
    err_master_fd = None
    err_slave_fd = None
    if HAS_PTY and sys.stdout.isatty() and not no_clipboard() and not headless:
        try:
            tty_in = open("/dev/tty", "rb", buffering=0)
            master_fd, slave_fd = pty.openpty()
            attrs = termios.tcgetattr(slave_fd)
            attrs[1] &= ~termios.ONLCR
            termios.tcsetattr(slave_fd, termios.TCSANOW, attrs)
            err_master_fd, err_slave_fd = pty.openpty()
            termios.tcsetattr(err_slave_fd, termios.TCSANOW, attrs)
        except OSError:
            if tty_in is not None:
                tty_in.close()
                tty_in = None
            if master_fd is not None:
                os.close(master_fd)
                master_fd = None
            if slave_fd is not None:
                os.close(slave_fd)
                slave_fd = None
            if err_master_fd is not None:
                os.close(err_master_fd)
                err_master_fd = None
            if err_slave_fd is not None:
                os.close(err_slave_fd)
                err_slave_fd = None

    step_lines = list(summary_obj.get("operation_steps") or [])
    use_progress = (
        not headless
        and not in_run_block()
        and sys.stdout.isatty()
        and get_setting("progress")[0] != "false"
        and bool(step_lines)
    )
    tmp_progress_path: Path | None = None
    progress_filter: _ProgressLineFilter | None = None
    if use_progress:
        tmp_progress_path = _prepare_progress_script(
            script_text, step_dir, step_lines, shell_bin, is_ps, work_dir
        )
        if tmp_progress_path is not None:
            step_map = {int(s["step"]): s for s in step_lines if s.get("step")}
            progress_filter = _ProgressLineFilter(step_map, len(step_lines))
            exec_cmd = (
                [shell_bin, "-NoProfile", "-File", str(tmp_progress_path)]
                if is_ps
                else [shell_bin, str(tmp_progress_path)]
            )

    bundle_file = sdir / "0"
    bundle_snapshot = bundle_file.read_bytes() if bundle_file.is_file() else None
    child_env = scrub_child_env(
        {
            **os.environ,
            "IN_RUN_BLOCK": "1",
            "RUN_BLOCK_PARENT_SESSION": sdir.name,
            "RUN_BLOCK_PARENT_STEP": step_dir.name,
        },
        sandbox_mode,
    )
    exec_cmd = build_sandbox_exec(exec_cmd, work_dir=work_dir, base_dir=ensure_base(), sandbox_mode=sandbox_mode)
    exec_started = time.monotonic()
    try:
        if (
            master_fd is not None
            and slave_fd is not None
            and err_master_fd is not None
            and err_slave_fd is not None
        ):
            try:
                proc = subprocess.Popen(
                    exec_cmd,
                    cwd=work_dir,
                    stdin=tty_in if tty_in is not None else slave_fd,
                    stdout=slave_fd,
                    stderr=err_slave_fd,
                    env=child_env,
                    close_fds=True,
                )
                os.close(slave_fd)
                slave_fd = None
                os.close(err_slave_fd)
                err_slave_fd = None
                for is_err, text in _iter_child_streams(master_fd, err_master_fd):
                    _emit(text, is_err)
                rc = proc.wait()
            finally:
                if slave_fd is not None:
                    os.close(slave_fd)
                if err_slave_fd is not None:
                    os.close(err_slave_fd)
                if master_fd is not None:
                    os.close(master_fd)
                if err_master_fd is not None:
                    os.close(err_master_fd)
                if tty_in is not None:
                    tty_in.close()
        else:
            proc = subprocess.Popen(
                exec_cmd,
                cwd=work_dir,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=child_env,
            )
            assert proc.stdout is not None and proc.stderr is not None
            for is_err, text in _iter_child_streams(proc.stdout.fileno(), proc.stderr.fileno()):
                _emit(text, is_err)
            proc.stdout.close()
            proc.stderr.close()
            rc = proc.wait()
        duration_s = max(0.0, time.monotonic() - exec_started)
        if progress_filter is not None:
            rem_out, rem_prog = progress_filter.flush(rc=rc)
            if rem_out:
                log_chunks.append(rem_out)
                sys.stdout.write(rem_out)
                if not rem_out.endswith("\n"):
                    log_chunks.append("\n")
                    sys.stdout.write("\n")
            if rem_prog:
                sys.stdout.write(rem_prog)
            if rem_out or rem_prog:
                sys.stdout.flush()
    finally:
        if tmp_progress_path is not None:
            tmp_progress_path.unlink(missing_ok=True)
    if bundle_snapshot is not None:
        if not bundle_file.is_file() or bundle_file.read_bytes() != bundle_snapshot:
            write_private(bundle_file, bundle_snapshot.decode("utf-8", "replace"), overwrite=True)
            warn_msg = f"\n[{label}] SECURITY WARNING: block attempted to modify {bundle_file.name} (reverted)\n"
            log_chunks.append(warn_msg)
            sys.stdout.write(warn_msg)
            sys.stdout.flush()
    if log_chunks and not log_chunks[-1].endswith("\n"):
        log_chunks.append("\n")
        sys.stdout.write("\n")
    stdin_diag_lines: list[str] = []
    if rc != 0:
        clean_so_far = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks[1:]))).replace("\r\n", "\n")
        stdin_diag_lines = _resolve_python_stdin_tracebacks(label, script_text, clean_so_far)
        for diag in stdin_diag_lines:
            log_chunks.append(diag + "\n")
    dur_str = format_duration(duration_s)
    duration_ms = int(round(duration_s * 1000.0))
    op_timings = progress_filter.operation_timings() if progress_filter is not None else []
    failed_step = (
        progress_filter.active_step
        if (rc != 0 and progress_filter is not None)
        else None
    )
    write_step_meta(
        step_dir,
        duration_ms=duration_ms,
        exit_code=rc,
        operations=op_timings,
        failed_step=failed_step,
        renumbered_from=renumbered_from,
    )
    end_detail = f"exit {rc}, {dur_str}" if rc != 0 else dur_str
    end_line = f"\n[{label}] END ({end_detail})\n"
    if rc != 0 and footer_on_fail:
        end_line += footer_on_fail if footer_on_fail.endswith("\n") else footer_on_fail + "\n"
    log_chunks.append(end_line)
    full_output = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks))).replace("\r\n", "\n")
    write_private(out_path, full_output)
    err_path = step_dir / "err"
    err_text = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(err_chunks))).replace("\r\n", "\n")
    if err_text.strip():
        write_private(err_path, err_text, overwrite=True)
    else:
        err_path.unlink(missing_ok=True)
    try:
        update_session_stats(
            sdir,
            ok=(rc == 0),
            duration_s=float(duration_s or 0.0),
            is_fix="_" in step_dir.name,
            renumbered=bool(renumbered_from),
        )
    except OSError:
        pass
    deferred_cards = pop_deferred_cards(step_dir)
    end_session_cards = [c for c in deferred_cards if c.get("kind") == "end_session"]
    start_session_cards = [c for c in deferred_cards if c.get("kind") == "start_session"]
    has_deferred_start = bool(start_session_cards)
    clip_target = resolve_clipboard_target(out_path, full_output)
    if headless:
        if stdin_diag_lines:
            sys.stdout.write("".join(d + "\n" for d in stdin_diag_lines))
        sys.stdout.write(end_line)
        sys.stdout.flush()
    elif (
        has_deferred_start
        or in_run_block()
        or not sys.stdout.isatty()
        or clipboard_mode() != "prompt"
        or clipboard_command(clip_target) is None
    ):
        end_body = build_box_body_lines(
            clip_target,
            rc=rc,
            stats=stats_line(clip_target),
            label=label,
            sdir=sdir,
            duration_s=duration_s,
            op_timings=op_timings,
            failed_step=failed_step,
        )
        sys.stdout.write("\n" + format_info_box("END STEP", end_body) + "\n")
        sys.stdout.flush()
    if not headless and not has_deferred_start:
        offer_clipboard_copy(
            label,
            out_path,
            ok=(rc == 0),
            rc=rc,
            duration_s=duration_s,
            op_timings=op_timings,
            failed_step=failed_step,
            sdir=sdir,
        )
    base_dir = sdir.parent
    for card in end_session_cards:
        sess_name = str(card.get("session") or sdir.name)
        target_sdir = base_dir / sess_name
        if target_sdir.is_dir():
            render_end_session_card(target_sdir, headless=headless)
    valid_start_dirs = [
        base_dir / str(card.get("session") or "")
        for card in start_session_cards
        if str(card.get("session") or "") and (base_dir / str(card.get("session") or "")).is_dir()
    ]
    for idx, target_sdir in enumerate(valid_start_dirs):
        is_last = idx == len(valid_start_dirs) - 1
        render_start_session_card(target_sdir, offer_copy=(is_last and not headless))
    return rc


TRAILING_FENCE_RE = re.compile(r"(?:\r?\n)+(?:RUN_(?:BLOCK|FIX)\s*)?`{3,}\s*$")
SPLIT_HEADER_RE = re.compile(
    r"^\s*(?:`{3,}[A-Za-z0-9_-]*\s*\n)?\s*(?:[A-Za-z0-9_./-]+\s+)?run_block\b[^\n]*<<\s*['\"]?(RUN_(?:BLOCK|FIX))['\"]?\s*$"
)
FENCE_LINE_RE = re.compile(r"^`{3,}[A-Za-z0-9_-]*\s*$")


def _reassemble_split_payload(payload: str) -> tuple[str, str | None]:
    """Reconstruct payloads split by chat Markdown fences when inner triple backticks appear."""
    norm = payload.replace("\r\n", "\n")
    lines = norm.split("\n")

    first_nonempty = -1
    for idx, line in enumerate(lines):
        if line.strip():
            first_nonempty = idx
            break
    if first_nonempty == -1:
        return payload, None

    header_line = lines[first_nonempty]
    m = SPLIT_HEADER_RE.match(header_line)
    if not m:
        cleaned = TRAILING_FENCE_RE.sub("", norm)
        c_lines = cleaned.split("\n")
        # Also strip orphan Markdown fence lines when the local shell consumed the outer
        # `run_block ... <<'RUN_BLOCK'` header before passing stdin.
        stripped_orphan = [ln for ln in c_lines if not FENCE_LINE_RE.match(ln)]
        joined_orphan = "\n".join(stripped_orphan)
        out = (joined_orphan + "\n") if joined_orphan and not joined_orphan.endswith("\n") else joined_orphan
        return out, None

    delim = m.group(1)
    body_lines = lines[first_nonempty + 1 :]
    end_idx = -1
    for idx in range(len(body_lines) - 1, -1, -1):
        stripped = body_lines[idx].strip()
        if stripped == delim or re.fullmatch(rf"{re.escape(delim)}\s*`{{3,}}", stripped):
            end_idx = idx
            break

    if end_idx == -1:
        return (
            payload,
            f"unclosed {delim} heredoc on stdin (missing closing '{delim}' terminator — check for split Markdown fences)",
        )

    inner = body_lines[:end_idx]
    rebuilt: list[str] = []
    i = 0
    while i < len(inner):
        cur = inner[i]
        # A split caused by inner triple backticks turns a single line or fence boundary into:
        #   <prefix>        (or standalone closing ```)
        #   ```<lang>       (chat UI reopening the next code block)
        # Strip standalone Markdown fence lines introduced by chat renderer splitting.
        if FENCE_LINE_RE.match(cur):
            i += 1
            continue
        rebuilt.append(cur)
        i += 1

    joined = "\n".join(rebuilt)
    out = (joined + "\n") if joined and not joined.endswith("\n") else joined
    return out, None


def _done_badge(sdir: Path) -> str:
    return " [DONE]" if is_session_completed(sdir) else ""


def _session_stats_lines(meta: dict[str, object]) -> list[str]:
    stats = _session_stats(meta)
    lines = [
        f"Steps: {stat_int(stats, 'steps')}",
        (
            f"Results: {stat_int(stats, 'ok')} ok, {stat_int(stats, 'failed')} failed, "
            f"{stat_int(stats, 'fix')} --fix, {stat_int(stats, 'renumbered')} renumbered"
        ),
        f"Duration: {format_duration(stat_int(stats, 'duration_ms') / 1000.0)}",
    ]
    if stats.get("started_at"):
        lines.append(f"Started: {stats['started_at']}")
    return lines


def render_end_session_card(sdir: Path, *, headless: bool = False) -> None:
    name = sdir.name
    meta = read_session_meta(sdir)
    lines = [f"Session: {name}", f"Completed: {meta.get('completed_at')}", *_session_stats_lines(meta)]
    if meta.get("completed_note"):
        lines.append(f"Note: {meta['completed_note']}")
    if headless:
        sys.stdout.write(f"[{name}] END SESSION\n" + "".join(f"{ln}\n" for ln in lines[1:]))
    else:
        sys.stdout.write(format_info_box("END SESSION", lines) + "\n")
    sys.stdout.flush()


def cmd_done(session: str | None = None, note: str | None = None, auto_yes: bool = False) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    base = ensure_base()
    if session:
        sdir = base / session
        if not sdir.is_dir():
            raise SystemExit(f"{prog_name()}: session {session!r} not found in {base}")
    else:
        parent_ref = parent_run_block_ref()
        if parent_ref is not None and (base / parent_ref[0]).is_dir():
            sdir = base / parent_ref[0]
        else:
            found = _find_latest_session_dir()
            if found is None:
                raise SystemExit(f"{prog_name()}: no sessions found in {base}")
            sdir = found
    name = sdir.name
    if is_session_completed(sdir):
        when = read_session_meta(sdir).get("completed_at") or "unknown time"
        sys.stdout.write(f"{prog_name()}: session {name} is already marked as completed ({when})\n")
        return 0
    set_session_completed(sdir, note=note)
    if in_run_block() and append_deferred_card("end_session", session=name):
        sys.stdout.write(f"{prog_name()}: session {name} marked completed\n")
        sys.stdout.flush()
        return 0
    render_end_session_card(sdir, headless=headless)
    return 0


def _guard_completed_session(
    label: str,
    sdir: Path,
    step_name: str,
    out_path: Path,
    headless: bool,
    fix_target: str | None = None,
) -> int | None:
    if not is_session_completed(sdir):
        return None
    session = sdir.name
    if headless:
        clear_session_completed(sdir)
        return None
    rc = 2
    reason = f"session {session} is marked as completed (pass -y/--yes to reopen and run)"
    if sys.stdout.isatty():
        meta = read_session_meta(sdir)
        lines = [f"Session: {session}", f"Completed: {meta.get('completed_at') or 'unknown'}"]
        if meta.get("completed_note"):
            lines.append(f"Note: {meta['completed_note']}")
        lines.append(f"Step: {label}")
        choice = prompt_yes_no_box(
            "SESSION COMPLETED",
            lines,
            f"-> Reopen session {session}?",
            default_yes=False,
            yes_status="✓ Session reopened.",
            no_status="✗ Session stays completed.",
            label=label,
            sdir=sdir,
        )
        if choice is True:
            clear_session_completed(sdir)
            return None
        rc = 130
        reason = f"session {session} is marked as completed (not reopened)"
    step_dir = _step_dir(sdir, step_name)
    existed = step_dir.exists()
    rc_out = not_run_exit(
        label, sdir, step_name, out_path, f"[{label}] NOT RUN: {reason}", rc=rc, headless=headless, fix_target=fix_target
    )
    if not existed:
        shutil.rmtree(step_dir, ignore_errors=True)
    return rc_out


def _reject_nested_step_execution(action: str) -> int:
    prog = prog_name()
    parent_ref = parent_run_block_ref()
    where = f" (active step: {parent_ref[0]}/{parent_ref[1]})" if parent_ref else ""
    sys.stderr.write(
        f"{prog}: cannot run {action} from inside a running block{where}\n"
    )
    sys.stderr.flush()
    return 2


def cmd_normal(
    ref: str, payload: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    if in_run_block():
        return _reject_nested_step_execution(f"block {ref}")
    payload, split_err = _reassemble_split_payload(payload)
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, step = parse_ref(ref, allow_fix_step=False)
    step_num = int(step)
    if step_num < 1:
        raise SystemExit(f"{prog_name()}: step number must be >= 1")
    base = ensure_base()
    _warn_if_state_oversized(base)
    sdir = base / session
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_override)
    label = f"{session}/{step}"
    step_dir = _step_dir(sdir, step)
    script_path = _find_step_script(sdir, step)
    out_path = step_dir / "out"
    if split_err:
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: {split_err}", headless=headless)
    rc_done = _guard_completed_session(label, sdir, step, out_path, headless)
    if rc_done is not None:
        return rc_done

    aborted_marker = step_dir / "aborted"
    renumbered_from: str | None = None

    overwrite = aborted_marker.exists()
    if overwrite:
        out_path.unlink(missing_ok=True)
        (step_dir / "meta.json").unlink(missing_ok=True)
        aborted_marker.unlink(missing_ok=True)
        for orig_p in (step_dir / "block.orig.sh", step_dir / "block.orig.ps1", step_dir / "out.orig"):
            orig_p.unlink(missing_ok=True)
    elif script_path.exists() or out_path.exists():
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            next_num = next_free_step(sdir, min_step=step_num + 1)
            next_label = f"{session}/{next_num}"
            existing_lines = [f"Next: {next_label}"]
            if script_path.exists():
                existing_lines.append(f"Script: {script_path}")
            if out_path.exists():
                existing_lines.append(f"Output: {out_path}")
            def _step_exists_lines() -> list[str]:
                hdr = format_session_header_lines(
                    label=label, sdir=sdir, sandbox_mode=sandbox_override
                )
                return [*hdr, "", *existing_lines]

            if out_path.exists():
                choice = prompt_yes_no_box(
                    "STEP ALREADY EXISTS",
                    _step_exists_lines(),
                    "Copy out to clipboard?",
                    default_yes=True,
                    no_status=f"✗ Keeping existing {label}.",
                    script_path=script_path if script_path.exists() else None,
                    out_path=out_path,
                    renumber_label=next_label,
                    renumber_status=f"✓ Renumbering {label} -> {next_label}.",
                    content_builder=_step_exists_lines,
                    copy_on_yes=True,
                    label=label,
                    sdir=sdir,
                    sandbox_mode=sandbox_override,
                    allow_overwrite=True,
                )
            else:
                choice = prompt_yes_no_box(
                    "STEP ALREADY EXISTS",
                    _step_exists_lines(),
                    f"Renumber to {next_label}?",
                    default_yes=False,
                    no_status=f"✗ Keeping existing {label}.",
                    script_path=script_path if script_path.exists() else None,
                    renumber_label=next_label,
                    renumber_status=f"✓ Renumbering {label} -> {next_label}.",
                    content_builder=_step_exists_lines,
                    renumber_only=True,
                    label=label,
                    sdir=sdir,
                    sandbox_mode=sandbox_override,
                    allow_overwrite=True,
                )
            if choice == "renumber":
                renumbered_from = label
                payload = _rewrite_script_step_header(payload, label, next_label)
                step = str(next_num)
                step_num = next_num
                label = next_label
                step_dir = _step_dir(sdir, step)
                script_path = _find_step_script(sdir, step)
                out_path = step_dir / "out"
                aborted_marker = step_dir / "aborted"
                overwrite = False
            elif choice == "overwrite":
                out_path.unlink(missing_ok=True)
                (step_dir / "meta.json").unlink(missing_ok=True)
                (step_dir / "error").unlink(missing_ok=True)
                (step_dir / "err").unlink(missing_ok=True)
                aborted_marker.unlink(missing_ok=True)
                for orig_p in (step_dir / "block.orig.sh", step_dir / "block.orig.ps1", step_dir / "out.orig"):
                    orig_p.unlink(missing_ok=True)
                overwrite = True
            elif choice == "copy":
                return 0
            else:
                return 2
        if not overwrite and renumbered_from is None:
            return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: step already exists — output: {out_path}", headless=headless)
    if step_num > 1 and renumbered_from is None and not _find_step_script(sdir, str(step_num - 1)).exists():
        prev_label = f"{session}/{step_num - 1}"
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            first_missing_num = first_missing_step(sdir)
            first_missing_label = f"{session}/{first_missing_num}"
            def _missing_prev_lines() -> list[str]:
                hdr = format_session_header_lines(
                    label=label, sdir=sdir, sandbox_mode=sandbox_override
                )
                lines = [*hdr, "", f"Missing: {prev_label}"]
                if first_missing_label != prev_label:
                    lines.append(f"Next: {first_missing_label}")
                return lines

            choice = prompt_yes_no_box(
                "MISSING PREVIOUS STEP",
                _missing_prev_lines(),
                f"Renumber to {first_missing_label}?",
                default_yes=False,
                no_status=f"✗ Canceled {label} (run {prev_label} first).",
                renumber_label=first_missing_label,
                renumber_status=f"✓ Renumbering {label} -> {first_missing_label}.",
                content_builder=_missing_prev_lines,
                renumber_only=True,
                label=label,
                sdir=sdir,
                sandbox_mode=sandbox_override,
            )
            if choice == "renumber":
                renumbered_from = label
                payload = _rewrite_script_step_header(payload, label, first_missing_label)
                step = str(first_missing_num)
                step_num = first_missing_num
                label = first_missing_label
                step_dir = _step_dir(sdir, step)
                script_path = _find_step_script(sdir, step)
                out_path = step_dir / "out"
                aborted_marker = step_dir / "aborted"
                overwrite = aborted_marker.exists()
                if overwrite:
                    out_path.unlink(missing_ok=True)
                    (step_dir / "meta.json").unlink(missing_ok=True)
                    aborted_marker.unlink(missing_ok=True)
                    for orig_p in (step_dir / "block.orig.sh", step_dir / "block.orig.ps1", step_dir / "out.orig"):
                        orig_p.unlink(missing_ok=True)
            else:
                return 2
        if renumbered_from is None:
            return not_run_exit(
                label,
                sdir,
                step,
                out_path,
                f"[{label}] NOT RUN: previous step {prev_label} has not been run yet",
                headless=headless,
            )
    if not payload.strip():
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: empty script on stdin", headless=headless)

    step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_private(script_path, payload, overwrite=overwrite)
    return run_script(
        label,
        script_path,
        out_path,
        cleanup_on_abort=[script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
        renumbered_from=renumbered_from,
    )


def cmd_fix(
    ref: str, fix_code: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    if in_run_block():
        return _reject_nested_step_execution(f"--fix {ref}")
    fix_code, split_err = _reassemble_split_payload(fix_code)
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, target = parse_ref(ref, allow_fix_step=True)
    target_ref = f"{session}/{target}"
    base_step = target.split("_", 1)[0]
    next_seq_ref = f"{session}/{int(base_step) + 1}"
    sdir = ensure_base() / session
    new_step = next_fix_step(target, sdir=sdir)
    label = f"{session}/{new_step}"
    new_step_dir = _step_dir(sdir, new_step)
    fix_path = new_step_dir / "fix.py"
    out_path = new_step_dir / "out"
    if split_err:
        return not_run_exit(
            label, sdir, new_step, out_path, f"[{label}] NOT RUN: {split_err}", headless=headless, fix_target=target_ref
        )

    chain = _find_fix_chain_scripts(sdir, base_step)
    if not chain:
        missing_script = _find_step_script(sdir, target)
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            f"[{label}] NOT RUN: target script {missing_script} does not exist",
            headless=headless,
            fix_target=target_ref,
        )

    rc_done = _guard_completed_session(label, sdir, new_step, out_path, headless, fix_target=target_ref)
    if rc_done is not None:
        return rc_done

    max_attempts = int(get_setting("max_fix_attempts")[0])
    prior_failures = _consecutive_failed_fixes(sdir, base_step)
    if prior_failures >= max_attempts:
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            (
                f"[{label}] NOT RUN: STOP --fix — reached max consecutive failed --fix attempts "
                f"({prior_failures}/{max_attempts}) for {session}/{base_step}; "
                f"emit a fresh {next_seq_ref} block instead"
            ),
            headless=headless,
            fix_target=target_ref,
        )

    reach_limit = (prior_failures + 1) >= max_attempts
    stop_directive = (
        f"[{label}] STOP --fix: reached {prior_failures + 1}/{max_attempts} failed --fix attempts "
        f"for {session}/{base_step}; switch to a fresh {next_seq_ref} block instead."
    )

    def _fail_not_run(reason: str) -> int:
        msg = f"[{label}] NOT RUN: {reason}"
        if reach_limit:
            msg += f"\n{stop_directive}"
        return not_run_exit(label, sdir, new_step, out_path, msg, headless=headless, fix_target=target_ref)

    if not fix_code.strip():
        return _fail_not_run("empty fix on stdin")

    ast_ok, ast_err = validate_fix_ast(fix_code)
    if not ast_ok:
        return _fail_not_run(f"unsafe construct in --fix ({ast_err})")

    direct_script = _find_step_script(sdir, target)
    if direct_script.is_file():
        primary = (target, direct_script)
    else:
        primary = chain[-1]

    candidates: list[tuple[str, Path]] = [primary]
    for cand_step, cand_path in reversed(chain):
        if all(cand_step != c[0] for c in candidates):
            candidates.append((cand_step, cand_path))

    chosen_step: str | None = None
    chosen_script: Path | None = None
    chosen_orig: str = ""
    chosen_new: str = ""
    primary_err: str | None = None

    for idx, (cand_step, cand_script) in enumerate(candidates):
        cand_orig = cand_script.read_text(encoding="utf-8")
        ns: dict[str, object] = {
            "__builtins__": dict(SAFE_FIX_BUILTINS),
            "text": cand_orig,
            "re": re,
        }
        try:
            exec(compile(fix_code, str(fix_path), "exec"), ns)
        except Exception as exc:
            if idx == 0:
                primary_err = _format_fix_exception(exc, fix_code, fix_path, ns)
            continue
        cand_new = ns.get("text")
        if not isinstance(cand_new, str):
            if idx == 0:
                primary_err = "fix did not leave a string in 'text'"
            continue
        if cand_new == cand_orig:
            if idx == 0:
                primary_err = f"fix made no changes to {cand_script}"
            continue
        chosen_step = cand_step
        chosen_script = cand_script
        chosen_orig = cand_orig
        chosen_new = cand_new
        break

    if chosen_step is None or chosen_script is None:
        return _fail_not_run(primary_err or f"fix made no changes to {primary[1]}")

    ext = chosen_script.suffix or _script_ext()
    new_step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    script_path = new_step_dir / f"block{ext}"
    write_private(fix_path, fix_code)
    write_private(script_path, chosen_new)
    diff = "".join(
        difflib.unified_diff(
            chosen_orig.splitlines(keepends=True),
            chosen_new.splitlines(keepends=True),
            fromfile=f"{chosen_step}/{chosen_script.name}",
            tofile=f"{new_step}/block{ext}",
        )
    )
    header = [f"[{label}] patched {chosen_step}/{chosen_script.name} -> {new_step}/block{ext}:\n", diff]
    return run_script(
        label,
        script_path,
        out_path,
        header_lines=header,
        cleanup_on_abort=[fix_path, script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
        footer_on_fail=stop_directive if reach_limit else None,
    )


def _step_sort_key(stem: str) -> tuple[int, int]:
    if "_" in stem:
        b, s = stem.split("_", 1)
        return (int(b) if b.isdigit() else 0, int(s) if s.isdigit() else 0)
    return (int(stem) if stem.isdigit() else 0, 0)


def _step_status(sdir: Path, stem: str) -> str:
    step_d = _step_dir(sdir, stem)
    if (step_d / "aborted").exists():
        return "ABORTED"
    for candidate in (step_d / "out", step_d / "error"):
        if candidate.is_file():
            txt = candidate.read_text(encoding="utf-8", errors="replace")
            label = f"{sdir.name}/{stem}"
            matches = re.findall(rf"^\[{re.escape(label)}\]\s+(END|SUCCESS|FAILED|NOT RUN)([^\n]*)", txt, flags=re.MULTILINE)
            if matches:
                kind, rest = matches[-1]
                return (kind + rest.split("—")[0]).strip()
            return "DONE"
    return "SAVED"


def _find_latest_step(session: str | None = None) -> tuple[str, str]:
    base = ensure_base()
    if session:
        sdirs = [base / session] if (base / session).is_dir() else []
    else:
        sdirs = sorted(
            [p for p in base.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    for sdir in sdirs:
        scripts = [p.parent.name for p in _iter_session_scripts(sdir)]
        if scripts:
            return sdir.name, scripts[-1]
    raise SystemExit(f"{prog_name()}: no saved blocks found in {base}")


def cmd_list(session: str | None = None) -> int:
    base = ensure_base()
    _warn_if_state_oversized(base)
    if not session:
        sdirs = sorted([p for p in base.iterdir() if p.is_dir()], key=lambda p: (_session_mtime(p), p.name))
        if not sdirs:
            sys.stdout.write(f"No sessions in {base} (0 B)\n")
            return 0
        sys.stdout.write(f"Sessions in {base}:\n")
        total_bytes = 0
        for sdir in sdirs:
            scripts = [p.parent.name for p in _iter_session_scripts(sdir)]
            has_bundle = (sdir / "0").is_file()
            sz = _dir_size_bytes(sdir)
            total_bytes += sz
            if scripts:
                last = f"{sdir.name}/{scripts[-1]} ({_step_status(sdir, scripts[-1])})"
            elif has_bundle:
                last = f"{sdir.name}/0 (BUNDLE)"
            else:
                last = "empty"
            sys.stdout.write(f"  {sdir.name:<8}  {len(scripts):>3} block(s)  {_human_size(sz):>9}   last: {last}{_done_badge(sdir)}\n")
        sys.stdout.write(f"Total storage: {_human_size(total_bytes)} ({len(sdirs)} session(s))\n")
        session = sdirs[-1].name
        sys.stdout.write(f"\nRecent blocks in {session}:\n")
    else:
        sdir = base / session
        if not sdir.is_dir():
            raise SystemExit(f"{prog_name()}: session {session!r} not found in {base}")
        sys.stdout.write(f"Blocks in {session} ({_human_size(_dir_size_bytes(sdir))}){_done_badge(sdir)}:\n")
    sdir = base / session
    if (sdir / "0").is_file():
        ref0 = f"{session}/0"
        sys.stdout.write(f"  {ref0:<10}  {'BUNDLE':<24}  Session context bundle (0)\n")
    script_paths = _iter_session_scripts(sdir)
    for sp in script_paths[-15:]:
        stem = sp.parent.name
        st = _step_status(sdir, stem)
        sh_text = sp.read_text(encoding="utf-8", errors="replace")
        summary = summarize_script_actions(sh_text, work_dir=get_work_dir(sdir))
        rows = summary.get("rows") or []
        desc = "; ".join(f"{k}: {v}" for k, v in rows[:2]) if rows else ""
        if len(desc) > 56:
            desc = desc[:53] + "..."
        ref = f"{session}/{stem}"
        sys.stdout.write(f"  {ref:<10}  {st:<24}  {desc}\n")
    return 0


def _find_latest_session() -> str:
    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not sdirs:
        raise SystemExit(f"{prog_name()}: no sessions found in {base}")
    return sdirs[0].name


def _show_bundle_part(ref: str | None, part: int) -> int:
    prog = prog_name()
    if ref is None:
        session, step = _find_latest_session(), "0"
    elif "/" in ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = parse_ref(f"{ref}/0", allow_fix_step=True)
    if step != "0":
        raise SystemExit(f"{prog}: --part applies only to the <session>/0 bundle (got {session}/{step})")
    sdir = ensure_base() / session
    bundle_path = sdir / "0"
    if not bundle_path.is_file():
        raise SystemExit(f"{prog}: bundle {session}/0 not found ({bundle_path})")
    plan = load_session_bundle_plan(sdir, bundle_path)
    if plan is None:
        raise SystemExit(f"{prog}: no bundle data found for session {session!r}")
    text = bundle_path.read_text(encoding="utf-8", errors="replace")
    try:
        entry, chunk = extract_bundle_part(plan, text, part)
    except ValueError as exc:
        raise SystemExit(f"{prog}: {session}/0: {exc}")
    sys.stderr.write(format_part_header(f"{session}/0", entry, int(plan.get("part_count") or 0)))
    sys.stdout.write(chunk)
    return 0


def cmd_show(ref: str | None = None, part: int | None = None) -> int:
    if part is not None:
        return _show_bundle_part(ref, part)
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    if step == "0":
        bundle_path = sdir / "0"
        if bundle_path.is_file():
            orig_bundle = _orig_file_backup_path(bundle_path)
            b_suffix = f" (edited) (original: {orig_bundle})" if orig_bundle.is_file() else ""
            sys.stdout.write(f"=== [{session}/0] Bundle: {bundle_path}{b_suffix} ===\n")
            sys.stdout.write(bundle_path.read_text(encoding="utf-8", errors="replace"))
            return 0
        raise SystemExit(f"{prog_name()}: bundle {session}/0 not found ({bundle_path})")
    step_dir = _step_dir(sdir, step)
    script_path = _find_step_script(sdir, step)
    out_path = step_dir / "out"
    err_path = step_dir / "error"
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    orig_path = _orig_backup_path(script_path)
    status_str = _step_status(sdir, step)
    script_edited = f" (edited) (original: {orig_path})" if orig_path.is_file() else ""
    sys.stdout.write(f"=== [{session}/{step}] Script: {script_path} ({status_str}){script_edited} ===\n")
    sys.stdout.write(script_path.read_text(encoding="utf-8", errors="replace"))
    if out_path.is_file():
        out_orig = _orig_file_backup_path(out_path)
        out_edited = f" (edited) (original: {out_orig})" if out_orig.is_file() else ""
        sys.stdout.write(f"\n=== [{session}/{step}] Output: {out_path}{out_edited} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
    if err_path.is_file():
        sys.stdout.write(f"\n=== [{session}/{step}] Error: {err_path} ===\n")
        sys.stdout.write(err_path.read_text(encoding="utf-8", errors="replace"))
    return 0


def cmd_retry(
    ref: str | None = None, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    if in_run_block():
        target = f"--retry {ref}" if ref else "--retry"
        return _reject_nested_step_execution(target)
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    step_dir = _step_dir(sdir, step)
    script_path = _find_step_script(sdir, step)
    out_path = step_dir / "out"
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    rc_done = _guard_completed_session(
        f"{session}/{step}", sdir, step, out_path, auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    )
    if rc_done is not None:
        return rc_done
    out_path.unlink(missing_ok=True)
    (step_dir / "out.orig").unlink(missing_ok=True)
    (step_dir / "meta.json").unlink(missing_ok=True)
    (step_dir / "error").unlink(missing_ok=True)
    (step_dir / "aborted").unlink(missing_ok=True)
    return run_script(
        f"{session}/{step}",
        script_path,
        out_path,
        cleanup_on_abort=[],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
    )


def _find_latest_session_dir() -> Path | None:
    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    return sdirs[0] if sdirs else None


def cmd_sandbox(argv: list[str]) -> int:
    prog = prog_name()
    mode_arg: str | None = None
    session_arg: str | None = None
    for a in argv:
        if re.fullmatch(r"s\d+", a) and session_arg is None and mode_arg is not None:
            session_arg = a
        elif mode_arg is None and a.lower() in ("off", "0", "false", "on", "1", "true", "auto", "strict", "nonet", "no-net"):
            mode_arg = normalize_sandbox_mode(a)
        elif session_arg is None and re.fullmatch(r"[A-Za-z0-9._-]+", a) and (ensure_base() / a).is_dir():
            session_arg = a
        elif mode_arg is None:
            mode_arg = normalize_sandbox_mode(a)
        else:
            raise SystemExit(f"{prog}: usage: {prog} --sandbox [off|strict|nonet] [session]")

    base = ensure_base()
    if session_arg:
        sdir: Path | None = base / session_arg
    else:
        parent_ref = parent_run_block_ref()
        if parent_ref is not None and (base / parent_ref[0]).is_dir():
            sdir = base / parent_ref[0]
        else:
            sdir = _find_latest_session_dir()
    backend = detect_sandbox_backend()
    if mode_arg is None:
        cur_mode = get_sandbox_mode(sdir)
        sess_lbl = sdir.name if sdir is not None else "(no active session)"
        sys.stdout.write(
            f"Session: {sess_lbl}\n"
            f"Sandbox: {format_sandbox_header(cur_mode)}\n"
            f"Backend: {backend}\n"
        )
        return 0
    if in_run_block():
        sys.stderr.write(f"{prog}: cannot modify session sandbox settings from inside a running block\n")
        return 2
    if sdir is None:
        sdir = start_session(session_arg, sandbox_mode=mode_arg)
    else:
        sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
        set_session_bundle_header(sdir, "Sandbox", format_sandbox_header(mode_arg))
    sys.stdout.write(
        f"Updated {sdir.name}/0 -> Sandbox: {format_sandbox_header(mode_arg)} (backend: {backend})\n"
    )
    return 0


def _dir_size_bytes(path: Path) -> int:
    total = 0
    try:
        for p in path.rglob("*"):
            if p.is_file():
                try:
                    total += p.stat().st_size
                except OSError:
                    pass
    except OSError:
        pass
    return total


def _session_mtime(sdir: Path) -> float:
    latest = 0.0
    try:
        latest = sdir.stat().st_mtime
        for p in sdir.iterdir():
            try:
                latest = max(latest, p.stat().st_mtime)
            except OSError:
                pass
    except OSError:
        pass
    return latest


_STATE_WARNED_DIRS: set[str] = set()


def _warn_if_state_oversized(base: Path) -> None:
    key = str(base)
    if key in _STATE_WARNED_DIRS:
        return
    raw_limit, _ = get_setting("max_state_mb")
    try:
        limit_mb = float(raw_limit)
    except ValueError:
        limit_mb = 100.0
    if limit_mb <= 0:
        return
    total_bytes = _dir_size_bytes(base)
    if total_bytes > limit_mb * 1024 * 1024:
        _STATE_WARNED_DIRS.add(key)
        prog = prog_name()
        sys.stderr.write(
            f"{prog}: warning: state directory {base} uses {_human_size(total_bytes)} "
            f"(exceeds {limit_mb:g} MB limit; run '{prog} --clean' to prune old sessions)\n"
        )
        sys.stderr.flush()


def _parse_nonneg_float(raw: str, flag_name: str) -> float:
    prog = prog_name()
    try:
        val = float(raw)
    except ValueError:
        raise SystemExit(f"{prog}: invalid {flag_name} value: {raw!r}")
    if math.isnan(val) or math.isinf(val) or val < 0:
        raise SystemExit(f"{prog}: {flag_name} must be >= 0")
    return val


def cmd_clean(argv: list[str]) -> int:
    prog = prog_name()
    usage_msg = (
        f"{prog}: usage: {prog} --clean [--keep N | --older-than DAYS | --max-size MB | --all] [--yes] [session...]"
    )
    keep: int | None = None
    older_than_days: float | None = None
    max_size_mb: float | None = None
    clean_all = False
    yes = False
    target_names: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--all":
            clean_all = True
            i += 1
        elif a in ("-y", "--yes", "--force"):
            yes = True
            i += 1
        elif a == "--keep":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --keep requires a non-negative integer")
            try:
                keep = int(argv[i + 1])
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {argv[i + 1]!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 2
        elif a.startswith("--keep="):
            val_s = a.split("=", 1)[1]
            try:
                keep = int(val_s)
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {val_s!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 1
        elif a == "--older-than":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --older-than requires a non-negative number of days")
            older_than_days = _parse_nonneg_float(argv[i + 1], "--older-than")
            i += 2
        elif a.startswith("--older-than="):
            older_than_days = _parse_nonneg_float(a.split("=", 1)[1], "--older-than")
            i += 1
        elif a == "--max-size":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-size requires a non-negative size in MB")
            max_size_mb = _parse_nonneg_float(argv[i + 1], "--max-size")
            i += 2
        elif a.startswith("--max-size="):
            max_size_mb = _parse_nonneg_float(a.split("=", 1)[1], "--max-size")
            i += 1
        elif a.startswith("-"):
            raise SystemExit(usage_msg)
        else:
            if not re.fullmatch(r"[A-Za-z0-9._-]+", a):
                raise SystemExit(f"{prog}: invalid session name: {a!r}")
            if a not in target_names:
                target_names.append(a)
            i += 1

    has_policy_flag = clean_all or keep is not None or older_than_days is not None or max_size_mb is not None
    if target_names and has_policy_flag:
        raise SystemExit(f"{prog}: cannot combine explicit session names with --keep/--older-than/--max-size/--all")

    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: (_session_mtime(p), p.name),
    )
    sizes_by_dir: dict[Path, int] = {d: _dir_size_bytes(d) for d in sdirs}
    total_before = sum(sizes_by_dir.values())

    if target_names:
        by_name = {d.name: d for d in sdirs}
        to_remove: list[Path] = []
        for name in target_names:
            if name not in by_name:
                raise SystemExit(f"{prog}: session {name!r} not found in {base}")
            to_remove.append(by_name[name])
    elif clean_all:
        to_remove = list(sdirs)
    else:
        if not has_policy_flag:
            keep = 5
        remove_set: set[Path] = set()
        if older_than_days is not None:
            cutoff = time.time() - older_than_days * 86400.0
            for d in sdirs:
                if _session_mtime(d) < cutoff:
                    remove_set.add(d)
        if keep is not None:
            remaining = [d for d in sdirs if d not in remove_set]
            if keep == 0:
                remove_set.update(remaining)
            elif len(remaining) > keep:
                remove_set.update(remaining[: len(remaining) - keep])
        if max_size_mb is not None:
            max_bytes = int(max_size_mb * 1024 * 1024)
            remaining = [d for d in sdirs if d not in remove_set]
            rem_total = sum(sizes_by_dir[d] for d in remaining)
            for d in remaining:
                if rem_total <= max_bytes:
                    break
                remove_set.add(d)
                rem_total -= sizes_by_dir[d]
        to_remove = [d for d in sdirs if d in remove_set]

    if not to_remove:
        sys.stdout.write(
            f"Nothing to clean in {base} ({len(sdirs)} session(s), {_human_size(total_before)} total).\n"
        )
        return 0

    freed_bytes = sum(sizes_by_dir[d] for d in to_remove)
    remaining_bytes = max(0, total_before - freed_bytes)
    details = ", ".join(f"{d.name} ({_human_size(sizes_by_dir[d])})" for d in to_remove)
    if not yes and sys.stdin.isatty() and sys.stdout.isatty() and not no_clipboard():
        ok = prompt_yes_no_box(
            "CLEAN SESSIONS",
            [
                f"Directory: {base}",
                f"Total size: {_human_size(total_before)}",
                f"Remove: {len(to_remove)} session(s) ({details})",
                f"Free: {_human_size(freed_bytes)} ({freed_bytes:,} bytes)",
            ],
            f"Delete {len(to_remove)} session(s)?",
            default_yes=False,
            yes_status=f"✓ Removing {len(to_remove)} session(s).",
            no_status="✗ Clean canceled.",
        )
        if not ok:
            return 2

    for d in to_remove:
        shutil.rmtree(d, ignore_errors=True)
    kept = len(sdirs) - len(to_remove)
    sys.stdout.write(
        f"Cleaned {len(to_remove)} session(s) ({details}; {_human_size(freed_bytes)} / {freed_bytes:,} bytes freed) "
        f"from {base}; {kept} kept ({_human_size(remaining_bytes)} remaining).\n"
    )
    return 0


def format_sandbox_header(mode: str) -> str:
    norm = normalize_sandbox_mode(mode)
    if norm == "strict":
        return "strict (rw: Workdir, /tmp; secrets: hidden; net: on)"
    if norm == "nonet":
        return "nonet (rw: Workdir, /tmp; secrets: hidden; net: off)"
    if norm == "off":
        return "off"
    return norm


def format_start_bundle(
    session_name: str,
    stdin_body: str = "",
    work_dir: Path | None = None,
    now: datetime | None = None,
    sandbox_mode: str | None = None,
    prompt: str | list[str] | tuple[str, ...] | None = None,
) -> dict[str, object]:
    stdin_headers, raw_body = parse_stdin_preamble(stdin_body)
    boundary = get_bundle_boundary(stdin_headers)
    raw_body = inject_embedded_block_rule(raw_body, boundary=boundary)
    raw_body = inject_embedded_prompt(raw_body, prompt=prompt, boundary=boundary)
    clean_body, bundle_plan = parse_bundle_fragments(raw_body, boundary=boundary)
    exposed_headers = filter_exposed_headers(stdin_headers)
    if work_dir is not None:
        wdir = work_dir.resolve()
    else:
        cwd_setting, _ = get_setting("work_dir")
        hdr_wdir: Path | None = None
        if cwd_setting.lower() == "auto":
            hdr_map = {k.lower(): v for k, v in stdin_headers}
            hdr_wdir = _resolve_existing_dir(hdr_map.get("workdir") or hdr_map.get("work-dir") or "")
        wdir = (hdr_wdir if hdr_wdir is not None else get_work_dir()).resolve()
    sb_mode = get_sandbox_mode(override=sandbox_mode)
    sb_hdr = format_sandbox_header(sb_mode)
    dt_utc = now.astimezone(timezone.utc) if now is not None else datetime.now(timezone.utc)
    ts = dt_utc.strftime("%Y-%m-%d %H:%M UTC")
    bundle_header_lines = [
        f"Session: {session_name}",
        f"Next-Block: {session_name}/1",
        f"Workdir: {wdir}",
    ]
    if normalize_sandbox_mode(sb_mode) != "off":
        bundle_header_lines.append(f"Sandbox: {sb_hdr}")
    bundle_header_lines.append(f"Date: {ts}")
    for exp_k, exp_v in exposed_headers:
        bundle_header_lines.append(f"{exp_k}: {exp_v}")
    bundle_header_text = "\n".join(bundle_header_lines) + "\n"
    full_text = bundle_header_text + ("\n" + clean_body + "\n" if clean_body else "")
    norm_raw_body = raw_body.strip("\n")
    raw_full_text = bundle_header_text + ("\n" + norm_raw_body + "\n" if norm_raw_body else "")
    full_tok = count_tokens(full_text.encode("utf-8"))
    total_lines = int(full_tok["lines"])
    total_chars = int(full_tok["chars"])
    total_tokens = int(full_tok["gpt"])
    fn_reconcile = globals().get("reconcile_bundle_plan")
    if callable(fn_reconcile):
        bundle_plan = fn_reconcile(bundle_plan, full_text)
    console_lines = [
        f"Session: {session_name}",
        f"Next-Block: {session_name}/1",
        f"Date: {ts}",
        f"Workdir: {wdir}",
        f"Sandbox: {sb_hdr}",
        f"Total: {total_lines} line{'s' if total_lines != 1 else ''} · {_human_chars(total_chars)} (~{total_tokens} tokens)",
    ]
    return {
        "console_lines": console_lines,
        "full": full_text,
        "raw_full": raw_full_text,
        "raw_body": raw_body,
        "stdin_headers": stdin_headers,
        "exposed_headers": exposed_headers,
        "bundle_plan": bundle_plan,
        "total_lines": total_lines,
        "total_chars": total_chars,
        "total_tokens": total_tokens,
        "sandbox": sb_mode,
    }


def _update_bundle_text_header(text: str, key: str, value: str) -> str:
    lines = text.splitlines()
    header_end = 0
    target_idx = -1
    key_lower = re.sub(r"\s+", "-", key.strip().lower())
    remove_line = key_lower == "sandbox" and normalize_sandbox_mode(value.split()[0] if value.strip() else "") == "off"
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped or stripped.startswith("====="):
            header_end = idx
            break
        m = BUNDLE_HEADER_RE.match(stripped)
        if not m:
            header_end = idx
            break
        k = re.sub(r"\s+", "-", m.group(1).strip().lower())
        if k == key_lower:
            target_idx = idx
        header_end = idx + 1
    if remove_line:
        if target_idx >= 0:
            lines.pop(target_idx)
    else:
        new_line = f"{key}: {value}"
        if target_idx >= 0:
            lines[target_idx] = new_line
        else:
            insert_at = max(0, header_end - 1) if header_end > 0 else 0
            lines.insert(insert_at, new_line)
    return "\n".join(lines) + "\n"


def set_session_bundle_header(sdir: Path, key: str, value: str) -> None:
    bundle_path = ensure_session_bundle(sdir)
    text = bundle_path.read_text(encoding="utf-8", errors="replace")
    write_private(bundle_path, _update_bundle_text_header(text, key, value), overwrite=True)
    raw_path = sdir / "0.raw"
    if raw_path.is_file():
        raw_text = raw_path.read_text(encoding="utf-8", errors="replace")
        write_private(raw_path, _update_bundle_text_header(raw_text, key, value), overwrite=True)


def cmd_start(
    argv: list[str],
    stdin_text: str | None = None,
    sandbox_override: str | None = None,
    prompt: str | list[str] | tuple[str, ...] | None = None,
) -> int:
    prog = prog_name()
    start_usage = (
        f"{prog}: usage: <command> | {prog} [--start] [-p TEXT] [--session NAME] [--sandbox [MODE]] [--force]"
    )
    force = False
    session_arg: str | None = None
    sb_arg: str | None = sandbox_override
    prompts: list[str] = []
    if prompt is not None:
        if isinstance(prompt, str):
            prompts.append(prompt)
        else:
            prompts.extend(str(p) for p in prompt)
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--force":
            force = True
            i += 1
        elif a == "--no-sandbox":
            sb_arg = "off"
            i += 1
        elif a == "--sandbox":
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                sb_arg = argv[i + 1]
                i += 2
            else:
                sb_arg = "strict"
                i += 1
        elif a.startswith("--sandbox="):
            sb_arg = a.split("=", 1)[1] or "strict"
            i += 1
        elif a == "--session":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --session requires an argument")
            session_arg = argv[i + 1]
            i += 2
        elif a.startswith("--session="):
            val = a.split("=", 1)[1]
            if not val:
                raise SystemExit(f"{prog}: --session requires an argument")
            session_arg = val
            i += 1
        elif a in ("-p", "--prompt"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prompts.append(argv[i + 1])
            i += 2
        elif a.startswith("--prompt="):
            prompts.append(a.split("=", 1)[1])
            i += 1
        elif a.startswith("-"):
            raise SystemExit(start_usage)
        else:
            if session_arg is None and re.fullmatch(r"s\d+", a):
                session_arg = a
                i += 1
            else:
                raise SystemExit(start_usage)

    if stdin_text is None:
        stdin_text = "" if sys.stdin.isatty() else sys.stdin.read()

    sdir = start_session(session_arg, force=force, sandbox_mode=sb_arg)
    session_name = sdir.name
    bundle_path = sdir / "0"
    res = format_start_bundle(
        session_name=session_name,
        stdin_body=stdin_text,
        sandbox_mode=sb_arg,
        prompt=prompts,
    )
    write_private(bundle_path, str(res["full"]), overwrite=True)
    raw_path = sdir / "0.raw"
    if isinstance(res.get("bundle_plan"), dict) and res["bundle_plan"].get("protocol") == "boundary":
        write_private(raw_path, str(res.get("raw_full") or res["full"]), overwrite=True)
    else:
        raw_path.unlink(missing_ok=True)
    stdin_headers = list(res.get("stdin_headers") or [])
    bundle_plan = res.get("bundle_plan")
    write_session_meta(
        sdir,
        stdin_headers,
        bundle_plan=bundle_plan if isinstance(bundle_plan, dict) else None,
    )
    if in_run_block():
        record_parent_child_session(sdir)
        if append_deferred_card("start_session", session=session_name):
            sys.stdout.write(f"{prog}: initialized session {session_name} ({session_name}/0)\n")
            sys.stdout.flush()
            return 0
    render_start_session_card(sdir)
    return 0


def render_start_session_card(sdir: Path, *, offer_copy: bool = True) -> None:
    session_name = sdir.name
    bundle_path = sdir / "0"
    body_lines = [f"Bundle: {bundle_path}"]
    label0 = f"{session_name}/0"
    if (
        offer_copy
        and not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(bundle_path) is not None
    ):
        offer_clipboard_copy(label0, bundle_path, ok=True, rc=0, title_kind="START SESSION", extra_lines=body_lines, sdir=sdir)
    else:
        full_body = build_box_body_lines(
            bundle_path, rc=0, stats=stats_line(bundle_path), extra_lines=body_lines, label=label0, sdir=sdir, title_kind="START SESSION"
        )
        sys.stdout.write(format_info_box("START SESSION", full_body) + "\n")
        sys.stdout.flush()
        if offer_copy and not in_run_block():
            offer_clipboard_copy(label0, bundle_path, ok=True, rc=0, title_kind="START SESSION", extra_lines=body_lines, sdir=sdir)


def refresh_bundle_meta(bundle_path: Path) -> None:
    if not bundle_path.is_file():
        return
    sdir = _resolve_session_dir(path_hint=bundle_path)
    if sdir is None:
        return
    fn_plan = globals().get("refresh_bundle_plan_meta")
    if callable(fn_plan):
        fn_plan(sdir, bundle_path)


def ensure_session_bundle(
    sdir: Path, work_dir: Path | None = None, sandbox_mode: str | None = None
) -> Path:
    bundle_path = sdir / "0"
    if not bundle_path.is_file():
        res = format_start_bundle(
            session_name=sdir.name, stdin_body="", work_dir=work_dir, sandbox_mode=sandbox_mode
        )
        write_private(bundle_path, str(res["full"]), overwrite=True)
    return bundle_path


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    parts = []
    for p in re.split(r"[^0-9]+", v):
        if p:
            parts.append(int(p))
    return tuple(parts)


def fetch_remote_script(url: str | None = None) -> str:
    import urllib.request

    cfg_url, _ = get_setting("update_url")
    target_url = url or cfg_url
    if target_url.startswith(("http://", "https://")) and "?" not in target_url:
        target_url = f"{target_url}?t={int(time.time())}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": f"run_block/{VERSION}", "Cache-Control": "no-cache", "Pragma": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER and REPO_MARKER not in data:
        raise ValueError("downloaded file does not contain expected repository marker")
    ast.parse(data)
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} --update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


_SANDBOX_MODE_TOKENS = ("off", "0", "false", "on", "1", "true", "auto", "strict", "nonet", "no-net")


def _extract_prompt_args(argv: list[str]) -> tuple[list[str], list[str]]:
    prog = prog_name()
    rest: list[str] = []
    prompts: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--prompt"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prompts.append(argv[i + 1])
            i += 2
        elif a.startswith("--prompt="):
            prompts.append(a.split("=", 1)[1])
            i += 1
        else:
            rest.append(a)
            i += 1
    return rest, prompts


def _reject_prompt_for(command_label: str, usage: str) -> None:
    prog = prog_name()
    raise SystemExit(f"{prog}: -p/--prompt cannot be used with {command_label} (usage: {usage})")


def main(argv: list[str] | None = None) -> int:
    raw_args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in raw_args or "--help" in raw_args:
        sys.stdout.write(usage_text())
        return 0
    if "-V" in raw_args or "--version" in raw_args:
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0

    has_bare_sandbox_flag = False
    for idx, tok in enumerate(raw_args):
        if tok == "--sandbox":
            if idx + 1 >= len(raw_args) or raw_args[idx + 1].lower() not in _SANDBOX_MODE_TOKENS:
                has_bare_sandbox_flag = True

    args, prompt_args = _extract_prompt_args(raw_args)

    if args and args[0] == "--plan":
        if prompt_args:
            _reject_prompt_for("--plan", f"{prog} --plan < script.sh")
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} --plan < script.sh")
        return cmd_plan(sys.stdin.read())
    if args and args[0] == "--bundle-plan":
        if prompt_args:
            _reject_prompt_for("--bundle-plan", f"{prog} --bundle-plan [<session>] [--json] [--full] [--part N]")
        return cmd_bundle_plan(args[1:])
    if args and args[0] == "--clean":
        if prompt_args:
            _reject_prompt_for(
                "--clean",
                f"{prog} --clean [--keep N | --older-than DAYS | --max-size MB | --all] [--yes] [session...]",
            )
        return cmd_clean(args[1:])

    has_start_opt = any(
        x in ("--start", "--bundle", "--session", "--force") or x.startswith("--session=")
        for x in args
    )
    if args and args[0] == "--sandbox" and not has_start_opt:
        rest_sb = args[1:]
        if not any("/" in x or x.startswith("-") for x in rest_sb):
            has_session_arg = len(rest_sb) >= 2 or (
                len(rest_sb) == 1 and rest_sb[0].lower() not in _SANDBOX_MODE_TOKENS
            )
            if in_run_block() or has_session_arg or has_bare_sandbox_flag or (
                sys.stdin.isatty() and not prompt_args
            ):
                if prompt_args:
                    _reject_prompt_for("--sandbox", f"{prog} --sandbox [off|strict|nonet] [session]")
                return cmd_sandbox(rest_sb)

    auto_yes = False
    sandbox_override: str | None = None
    filtered: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-y", "--yes", "--headless"):
            auto_yes = True
            i += 1
        elif a == "--no-sandbox":
            sandbox_override = "off"
            i += 1
        elif a.startswith("--sandbox="):
            sandbox_override = a.split("=", 1)[1] or "strict"
            i += 1
        elif a == "--sandbox":
            if i + 1 < len(args) and args[i + 1].lower() in _SANDBOX_MODE_TOKENS:
                sandbox_override = args[i + 1]
                i += 2
            else:
                sandbox_override = "strict"
                i += 1
        else:
            filtered.append(a)
            i += 1
    args = filtered

    if not args:
        if sandbox_override is not None and not has_start_opt:
            if in_run_block() or has_bare_sandbox_flag or (sys.stdin.isatty() and not prompt_args):
                if prompt_args:
                    _reject_prompt_for("--sandbox", f"{prog} --sandbox [off|strict|nonet] [session]")
                return cmd_sandbox([sandbox_override])
        return cmd_start([], sandbox_override=sandbox_override, prompt=prompt_args)

    if sandbox_override is not None and len(args) == 1 and "/" not in args[0] and not args[0].startswith("-"):
        if prompt_args:
            _reject_prompt_for("--sandbox", f"{prog} --sandbox [off|strict|nonet] [session]")
        return cmd_sandbox([sandbox_override, args[0]])

    if args[0] in ("--list", "-l"):
        if prompt_args:
            _reject_prompt_for(args[0], f"{prog} --list [session]")
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --list [session]")
        return cmd_list(args[1] if len(args) == 2 else None)

    if args[0] == "--done":
        done_usage = f"{prog} --done [-y] [session] [-m NOTE]"
        if prompt_args:
            _reject_prompt_for("--done", done_usage)
        done_note: str | None = None
        done_session: str | None = None
        j = 1
        while j < len(args):
            tok = args[j]
            if tok == "-m":
                if j + 1 >= len(args):
                    raise SystemExit(f"{prog}: -m requires an argument")
                done_note = args[j + 1]
                j += 2
            elif tok.startswith("-") or done_session is not None:
                raise SystemExit(f"{prog}: usage: {done_usage}")
            else:
                done_session = tok
                j += 1
        return cmd_done(done_session, note=done_note, auto_yes=auto_yes)

    if args[0] == "--show":
        show_usage = f"{prog} --show [session[/step]] [--part N]"
        if prompt_args:
            _reject_prompt_for("--show", show_usage)
        show_rest, show_part = parse_part_option(args[1:], show_usage)
        if len(show_rest) > 1:
            raise SystemExit(f"{prog}: usage: {show_usage}")
        return cmd_show(show_rest[0] if show_rest else None, part=show_part)

    if args[0] in ("--retry", "--rerun"):
        if prompt_args:
            _reject_prompt_for(args[0], f"{prog} --retry [-y] [session/step]")
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --retry [-y] [session/step]")
        return cmd_retry(
            args[1] if len(args) == 2 else None, auto_yes=auto_yes, sandbox_override=sandbox_override
        )

    if args[0] == "--check-update":
        if prompt_args:
            _reject_prompt_for("--check-update", f"{prog} --check-update")
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} --check-update")
        return cmd_check_update()

    if args[0] in ("--update", "--self-update"):
        if prompt_args:
            _reject_prompt_for(args[0], f"{prog} --update [--force]")
        force = "--force" in args[1:]
        rest = [a for a in args[1:] if a != "--force"]
        if rest:
            raise SystemExit(f"{prog}: usage: {prog} --update [--force]")
        return cmd_update(force=force)

    if args[0] in ("--start", "--bundle"):
        return cmd_start(args[1:], sandbox_override=sandbox_override, prompt=prompt_args)

    if args[0] == "--fix":
        if prompt_args:
            _reject_prompt_for("--fix", f"{prog} --fix [-y] <session>/<target>")
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} --fix [-y] <session>/<target>")
        return cmd_fix(
            args[1], sys.stdin.read(), auto_yes=auto_yes, sandbox_override=sandbox_override
        )

    if args[0] in ("--session", "--force") or args[0].startswith("--session="):
        return cmd_start(args, sandbox_override=sandbox_override, prompt=prompt_args)

    if prompt_args:
        if len(args) == 1 and "/" in args[0] and not args[0].startswith("-"):
            _reject_prompt_for(args[0], f"{prog} [-y] <session>/<step>")
        return cmd_start(args, sandbox_override=sandbox_override, prompt=prompt_args)

    if len(args) != 1 or args[0].startswith("-"):
        raise SystemExit(
            f"{prog}: usage: {prog} [-y] <session>/<step> (or pipe bundle to '{prog}' to start a session; see --help)"
        )
    return cmd_normal(
        args[0], sys.stdin.read(), auto_yes=auto_yes, sandbox_override=sandbox_override
    )


if __name__ == "__main__":
    raise SystemExit(main())
