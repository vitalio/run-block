    by_step: dict[str, Path] = {}
    if not sdir.is_dir():
        return []
    for d in sdir.iterdir():
        if not d.is_dir() or not re.fullmatch(r"\d+(?:_\d+)?", d.name):
            continue
        for ext in (".sh", ".ps1"):
            p = d / f"block{ext}"
            if p.is_file():
                by_step.setdefault(d.name, p)
                break
    return [by_step[k] for k in sorted(by_step.keys(), key=_step_sort_key)]


