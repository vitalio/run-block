def write_step_meta(
    step_dir: Path,
    *,
    duration_ms: int,
    exit_code: int,
    operations: list[dict[str, object]] | None = None,
    failed_step: int | None = None,
    renumbered_from: str | None = None,
) -> Path:
    meta_file = step_dir / "meta.json"
    data: dict[str, object] = {
        "duration_ms": max(0, int(duration_ms)),
        "exit_code": int(exit_code),
