def _parse_var_assignment(line: str) -> tuple[str, list[str]] | None:
    """Parses a pure shell variable or array assignment without trailing commands or substitutions."""
    m = VAR_ASSIGN_RE.match(line.strip())
    if not m:
        return None
    name, rhs = m.group(1), m.group(2)
    if rhs == "":
        return name, [""]
    if rhs[0].isspace():
        if rhs.lstrip().startswith("#"):
            return name, [""]
        return None
    n = len(rhs)
    if rhs[0] == "(":
        i = 1
        in_sq = False
        in_ansi_sq = False
        in_dq = False
        closed = False
        while i < n:
            ch = rhs[i]
            if in_sq:
                if ch == "'":
                    in_sq = False
                i += 1
                continue
            if in_ansi_sq:
                if ch == "\\" and i + 1 < n:
                    i += 2
                    continue
                if ch == "'":
                    in_ansi_sq = False
                i += 1
                continue
            if in_dq:
                if ch == "\\" and i + 1 < n:
                    i += 2
                    continue
                if ch == "`":
                    return None
                if ch == chr(36) and i + 1 < n and rhs[i + 1] == "(":
                    return None
                if ch == '"':
                    in_dq = False
                i += 1
                continue
            if ch == "\\" and i + 1 < n:
                i += 2
                continue
            if ch == "`":
                return None
            if ch == chr(36) and i + 1 < n and rhs[i + 1] == "(":
                return None
            if ch == chr(36) and i + 1 < n and rhs[i + 1] == "'":
                in_ansi_sq = True
                i += 2
                continue
            if ch == "'":
                in_sq = True
                i += 1
                continue
            if ch == '"':
                in_dq = True
                i += 1
                continue
            if ch == "(":
                return None
            if ch == ")":
                closed = True
                break
            i += 1
        if not closed or in_sq or in_ansi_sq or in_dq:
            return None
        tail = rhs[i + 1 :].strip()
        if tail and not tail.startswith("#"):
            return None
        return name, _parse_for_items(rhs[1:i])
    i = 0
    while i < n:
        ch = rhs[i]
        if ch.isspace() or ch in ";|&()":
            break
        if ch == "`":
            return None
        if ch == chr(36):
            if i + 1 < n and rhs[i + 1] == "(":
                return None
            if i + 1 < n and rhs[i + 1] == "'":
                i += 2
                while i < n:
                    if rhs[i] == "\\" and i + 1 < n:
                        i += 2
                        continue
                    if rhs[i] == "'":
                        i += 1
                        break
                    i += 1
                else:
                    return None
                continue
        if ch == "'":
            i += 1
            while i < n and rhs[i] != "'":
                i += 1
            if i >= n:
                return None
            i += 1
            continue
        if ch == '"':
            i += 1
            while i < n:
                c2 = rhs[i]
                if c2 == "\\" and i + 1 < n:
                    i += 2
                    continue
                if c2 == "`":
                    return None
                if c2 == chr(36) and i + 1 < n and rhs[i + 1] == "(":
                    return None
                if c2 == '"':
                    i += 1
                    break
                i += 1
            else:
                return None
            continue
        if ch == "\\":
            if i + 1 >= n:
                return None
            i += 2
            continue
        i += 1
    word = rhs[:i]
    tail = rhs[i:]
    if not word:
        return None
    if tail:
        if not tail[0].isspace():
            return None
        tail_s = tail.strip()
        if tail_s and not tail_s.startswith("#"):
            return None
    try:
        vals = shlex.split(word)
    except ValueError:
        vals = [word.strip("'\"")]
    return name, vals or [""]


def _strip_single_quoted_literals(line: str) -> str:
    """Replaces single-quoted shell string literal contents with empty quotes."""
    out: list[str] = []
    n = len(line)
    i = 0
    in_dq = False
    while i < n:
        ch = line[i]
        if in_dq:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(line[i + 1])
                i += 2
                continue
            if ch == '"':
                in_dq = False
            i += 1
            continue
        if ch == "\\" and i + 1 < n:
            out.append(ch)
            out.append(line[i + 1])
            i += 2
            continue
        if ch == '"':
            in_dq = True
            out.append(ch)
            i += 1
            continue
        if ch == chr(36) and i + 1 < n and line[i + 1] == "'":
            out.append(chr(36) + "''")
            i += 2
            while i < n:
                if line[i] == "\\" and i + 1 < n:
                    i += 2
                    continue
                if line[i] == "'":
                    i += 1
                    break
                i += 1
            continue
        if ch == "'":
            out.append("''")
            i += 1
            while i < n and line[i] != "'":
                i += 1
            if i < n:
                i += 1
            continue
        out.append(ch)
        i += 1
    return "".join(out)
CONTROL_FLOW_SKIP_RE = re.compile(
