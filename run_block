def _build_prompt_yes_no_suffix(
    default_yes: bool,
    has_script: bool = False,
    has_output: bool = False,
    can_copy: bool = False,
    has_renumber: bool = False,
) -> str:
    if has_renumber:
        parts = ["r", "R", "N"]
    else:
        parts = ["Y", "n"] if default_yes else ["y", "N"]
    if has_script:
        parts.append("s(cript)")
    if has_output:
        parts.append("o(utput)")
    if can_copy:
        parts.append("c(opy)")
    return f"[{'/'.join(parts)}]:"


def prompt_yes_no_box(
    title: str,
    content_lines: list[str],
    question: str,
    default_yes: bool = False,
    yes_status: str = "✓ Confirmed by user.",
    no_status: str = "✗ Canceled by user.",
    tty_streams: tuple[object, object] | None = None,
    script_path: Path | None = None,
    out_path: Path | None = None,
    renumber_label: str | None = None,
    renumber_status: str | None = None,
) -> bool | str:
    has_script = script_path is not None and script_path.is_file()
    has_output = out_path is not None and out_path.is_file()
    can_copy = has_output
    has_renumber = bool(renumber_label)
    renum_msg = renumber_status or (f"✓ Renumbering to {renumber_label}." if has_renumber else "")
    suffix = _build_prompt_yes_no_suffix(
        default_yes,
        has_script=has_script,
        has_output=has_output,
        can_copy=can_copy,
        has_renumber=has_renumber,
    )
    prompt_line = f"-> {question} {suffix}"
    status_list: list[str] = [yes_status, no_status]
    if has_renumber:
        status_list.append(renum_msg)
    clip_target: Path | None = None
    clip: tuple[list[str], str] | None = None
    if can_copy and out_path is not None:
        try:
            full_out = out_path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            full_out = ""
        clip_target = resolve_clipboard_target(out_path, full_out)
        clip = clipboard_command(clip_target)
        status_list.append(f"✓ Copied {clip_target} to clipboard.")
        if clip is not None:
            status_list.append(f"✗ Clipboard copy failed; run: {clip[1]}")
        else:
            status_list.append(f"✗ No clipboard tool found for {clip_target}.")
    extra_keys: dict[str, str] = {}
    case_sensitive_keys: dict[str, str] = {}
    if has_renumber:
        case_sensitive_keys["r"] = "renumber"
        case_sensitive_keys["R"] = "yes"
        extra_keys["renumber"] = "renumber"
        extra_keys["restart"] = "yes"
        extra_keys["overwrite"] = "yes"
    if has_script:
        extra_keys["s"] = "script"
        extra_keys["script"] = "script"
    if has_output:
        extra_keys["o"] = "output"
        extra_keys["output"] = "output"
    if can_copy:
        extra_keys["c"] = "copy"
        extra_keys["copy"] = "copy"
    box, rule_width, cursor_offset = format_prompt_box(
        title, content_lines, prompt_line, status_lines=status_list
    )
    _, border_col = _block_colors(title)
    bottom = _format_bottom_rule(rule_width, border_color=border_col)
    prefixed_prompt = _prefix_block_line(prompt_line, border_color=border_col)
    try:
        if tty_streams is not None:
            tty_w, tty_r = tty_streams
            close_after = False
        else:
            tty_w, tty_r = open_tty()
            close_after = True
        try:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            status_line: str | None = None
            result: bool | str = False
            while True:
                action = read_confirm_key(
                    tty_r,
                    default_yes=default_yes,
                    default_no=not default_yes,
                    extra_keys=extra_keys,
                    case_sensitive_keys=case_sensitive_keys,
                )
                if action == "script" and has_script and script_path is not None:
                    open_script_in_editor(script_path, tty_r, tty_w)
                    tty_w.write(f"\r\033[K{prefixed_prompt}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                    tty_w.flush()
                    continue
                if action == "output" and has_output and out_path is not None:
                    open_script_in_editor(out_path, tty_r, tty_w)
                    tty_w.write(f"\r\033[K{prefixed_prompt}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                    tty_w.flush()
                    continue
                if action in ("view", "edit") and (has_output or has_script):
                    view_target = out_path if (has_output and out_path is not None) else script_path
                    if view_target is not None:
                        open_script_in_editor(view_target, tty_r, tty_w)
                        tty_w.write(f"\r\033[K{prefixed_prompt}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                        tty_w.flush()
                    continue
                if action == "copy" and can_copy and clip_target is not None:
                    if clip is not None and copy_file_to_clipboard(clip[0], clip_target):
                        status_line = f"✓ Copied {clip_target} to clipboard."
                    elif clip is not None:
                        status_line = f"✗ Clipboard copy failed; run: {clip[1]}"
                    else:
                        status_line = f"✗ No clipboard tool found for {clip_target}."
                    result = False
                    break
                if action == "renumber" and has_renumber:
                    status_line = renum_msg
                    result = "renumber"
                    break
                if action == "yes":
                    result = True
                    break
                if action == "no":
                    result = False
                    break
            if status_line is None:
                status_line = yes_status if result else no_status
            prefixed_status = _prefix_block_line(status_line, border_color=border_col)
            tty_w.write(f"\r\033[K{prefixed_status}\n\r\033[K{bottom}\n")
            tty_w.flush()
            return result
        finally:
            if close_after:
                tty_w.close()
                tty_r.close()
    except OSError:
        return default_yes


def resolve_editor_command() -> list[str]:
    cfg_ed, _ = get_setting("editor")
    if cfg_ed and cfg_ed.lower() != "auto":
        return shlex.split(cfg_ed)
    for env_k in ("VISUAL", "EDITOR"):
        val = os.environ.get(env_k, "").strip()
        if val:
            return shlex.split(val)
    for candidate in ("vim", "vi", "less", "nano", "more"):
        if shutil.which(candidate):
            return [candidate]
    return ["vi"]


def open_script_in_editor(script_path: Path, tty_r, tty_w) -> None:
    cmd = resolve_editor_command() + [str(script_path)]
    try:
        subprocess.run(cmd, stdin=tty_r, stdout=tty_w, stderr=tty_w, check=False)
    except Exception as exc:
        tty_w.write(f"\n[editor error: {exc}]\n")
        tty_w.flush()


def _parse_confirm_line(
    line: str,
    default_yes: bool,
    default_no: bool = False,
    extra_keys: dict[str, str] | None = None,
    case_sensitive_keys: dict[str, str] | None = None,
) -> str:
    if not line:
        return "yes" if default_yes else "no"
    raw_ans = line.strip()
    if case_sensitive_keys and raw_ans in case_sensitive_keys:
        return case_sensitive_keys[raw_ans]
    ans = raw_ans.lower()
    if extra_keys and ans in extra_keys:
        return extra_keys[ans]
    if ans in ("e", "edit"):
        return "edit"
    if ans in ("v", "view"):
        return "view"
    if default_yes and ans in ("", "y", "yes"):
        return "yes"
    if not default_yes and ans in ("y", "yes"):
        return "yes"
    if default_no and ans == "":
        return "no"
    if ans in ("n", "no", "q", "esc", "\x1b"):
        return "no"
    return "invalid"


def read_confirm_key(
    tty_r,
    default_yes: bool,
    default_no: bool = False,
    extra_keys: dict[str, str] | None = None,
    case_sensitive_keys: dict[str, str] | None = None,
) -> str:
    """Reads a single key: returns 'yes', 'no', 'view', or an extra_keys action."""
    flush_tty_input(tty_r)
    if not HAS_PTY or termios is None or tty is None:
        return _parse_confirm_line(
            tty_r.readline(),
            default_yes,
            default_no=default_no,
            extra_keys=extra_keys,
            case_sensitive_keys=case_sensitive_keys,
        )
    try:
        fd = tty_r.fileno()
        old_attrs = termios.tcgetattr(fd)
    except Exception:
        return _parse_confirm_line(
            tty_r.readline(),
            default_yes,
            default_no=default_no,
            extra_keys=extra_keys,
            case_sensitive_keys=case_sensitive_keys,
        )
    try:
        tty.setraw(fd, termios.TCSANOW)
        while True:
            ch = os.read(fd, 1)
            if not ch:
                return "no"
            ch_str = ch.decode("latin1")
            if case_sensitive_keys and ch_str in case_sensitive_keys:
                return case_sensitive_keys[ch_str]
            ch_low = ch_str.lower()
            if extra_keys and ch_low in extra_keys:
                return extra_keys[ch_low]
            if ch in (b"e", b"E"):
                return "edit"
            if ch in (b"v", b"V"):
                return "view"
            if ch in (b"y", b"Y"):
                return "yes"
            if ch in (b"\r", b"\n"):
                if default_yes:
                    return "yes"
                if default_no:
                    return "no"
            if ch in (b"n", b"N", b"q", b"Q", b"\x03", b"\x04"):
                return "no"
            if ch == b"\x1b":
                rlist, _, _ = select.select([fd], [], [], 0.05)
                if rlist:
                    os.read(fd, 32)
                    continue
                return "no"
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


def _write_orig_backup_once(orig_path: Path, raw_bytes: bytes) -> None:
    if orig_path.exists():
        return
    fd = os.open(orig_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f_orig:
        f_orig.write(raw_bytes)


def _is_file_edited(file_path: Path | None, orig_path: Path | None = None) -> bool:
    if file_path is None:
        return False
    resolved_orig = orig_path if orig_path is not None else _orig_file_backup_path(file_path)
    if not resolved_orig.is_file() or not file_path.is_file():
        return False
    try:
        return file_path.read_bytes() != resolved_orig.read_bytes()
    except OSError:
        return False


def _safety_prompt_prefix(default_yes: bool, has_findings: bool, border_color: str) -> str:
    raw_prompt = f"-> Execute this block? {_safety_prompt_suffix(default_yes)}"
    if has_findings and _use_color():
        raw_prompt = f"{_PROMPT_WARN_COLOR}{raw_prompt}{_ANSI_RESET}"
    return _prefix_block_line(raw_prompt, border_color=border_color)


def confirm_execution(
    label: str,
    script_text: str,
    summary: dict[str, object] | None = None,
    script_path: Path | None = None,
    auto_yes: bool = False,
) -> tuple[bool, str]:
    if in_run_block():
        return True, ""
    findings = scan_script_risks(script_text)
    note = ""
    approve_decision = ""
    approve_cmd, _ = get_setting("approve_cmd")
    wdir = Path(str(summary.get("work_dir"))) if summary and summary.get("work_dir") else get_work_dir()
    orig_sandbox = str(summary.get("sandbox") or "") if summary else ""
    if approve_cmd:
        plan_obj = analyze_script(script_text, work_dir=wdir, label=label, check_syntax=False)
        approve_decision, note = run_approve_cmd(approve_cmd, label, script_text, plan_obj, script_path=script_path)
        if approve_decision == "reject":
            return False, (note or "rejected by RUN_BLOCK_APPROVE_CMD")
        if approve_decision == "approve":
            if findings and (auto_yes or not sys.stdout.isatty() or no_clipboard()):
                for f in findings:
                    sys.stdout.write(f"[{label}] safety warning [{f['category']}]: {f['snippet']}\n")
                sys.stdout.flush()
            return True, note
    if auto_yes or not sys.stdout.isatty() or no_clipboard():
        if findings:
            for f in findings:
                sys.stdout.write(f"[{label}] safety warning [{f['category']}]: {f['snippet']}\n")
            sys.stdout.flush()
        return True, note
    orig_path = _orig_backup_path(script_path) if script_path is not None else None
    is_edited = _is_file_edited(script_path, orig_path)
    default_yes = (len(findings) == 0 and approve_decision != "prompt")
    prev_cols = _hr_width()
    box, rule_width, cursor_offset = format_safety_box(
        label,
        findings,
        default_yes=default_yes,
        summary=summary,
        note=note,
        script_path=script_path,
        edited=is_edited,
    )
    _, border_col = _block_colors("PLAN")
    bottom = _format_bottom_rule(rule_width, border_color=border_col)
    prefixed_prompt = _safety_prompt_prefix(default_yes, bool(findings), border_col)
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_confirm_key(tty_r, default_yes=default_yes)
                if action in ("edit", "view"):
                    if script_path is not None and script_path.is_file():
                        try:
                            before_bytes: bytes | None = script_path.read_bytes()
                        except OSError:
                            before_bytes = None
                        open_script_in_editor(script_path, tty_r, tty_w)
                        try:
                            after_bytes: bytes | None = script_path.read_bytes() if script_path.is_file() else None
                        except OSError:
                            after_bytes = None
                        if before_bytes is not None and after_bytes is not None and after_bytes != before_bytes:
                            if orig_path is not None:
                                _write_orig_backup_once(orig_path, before_bytes)
                            script_text = after_bytes.decode("utf-8", errors="replace")
                            summary = summarize_script_actions(script_text, work_dir=wdir)
                            if orig_sandbox:
                                summary["sandbox"] = orig_sandbox
                            findings = scan_script_risks(script_text)
                            if approve_cmd:
                                plan_obj = analyze_script(script_text, work_dir=wdir, label=label, check_syntax=False)
                                approve_decision, note = run_approve_cmd(
                                    approve_cmd, label, script_text, plan_obj, script_path=script_path
                                )
                                if approve_decision == "reject":
                                    reject_msg = note or "rejected by RUN_BLOCK_APPROVE_CMD"
                                    prefixed_rej = _prefix_block_line(f"✗ {reject_msg}", border_color=border_col)
                                    tty_w.write(f"\r\033[K{prefixed_rej}\n\r\033[K{bottom}\n")
                                    tty_w.flush()
                                    return False, reject_msg
                            default_yes = (len(findings) == 0 and approve_decision != "prompt")
                            is_edited = _is_file_edited(script_path, orig_path)
                            up_rows = _box_rows_above_prompt(box, prev_cols)
                            prev_cols = _hr_width()
                            box, rule_width, cursor_offset = format_safety_box(
                                label,
                                findings,
                                default_yes=default_yes,
                                summary=summary,
                                note=note,
                                script_path=script_path,
                                edited=is_edited,
                            )
                            bottom = _format_bottom_rule(rule_width, border_color=border_col)
                            prefixed_prompt = _safety_prompt_prefix(default_yes, bool(findings), border_col)
                            move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                            tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                            tty_w.flush()
                        else:
                            tty_w.write(f"\r\033[K{prefixed_prompt}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                            tty_w.flush()
                    continue
                if action == "yes":
                    approved = True
                    break
                if action == "no":
                    approved = False
                    break
            run_target = str(script_path) if script_path is not None else label
            status_line = f"✓ Running {run_target} ..." if approved else f"✗ Aborted (--retry {label})"
            prefixed_status = _prefix_block_line(status_line, border_color=border_col)
            tty_w.write(f"\r\033[K{prefixed_status}\n\r\033[K{bottom}\n")
            tty_w.flush()
            return approved, ("" if approved else "USER_ABORTED")
    except OSError:
        return True, note


# --- Built-in token and byte statistics ---
_ENC = None
_ENC_TRIED = False


def gpt_encoder():
    global _ENC, _ENC_TRIED
    if not _ENC_TRIED:
        _ENC_TRIED = True
        try:
            import tiktoken  # type: ignore[import-not-found]
            _ENC = tiktoken.get_encoding("o200k_base")
        except Exception:
            _ENC = None
    return _ENC


def count_tokens(data: bytes) -> dict[str, int | bool]:
    text = data.decode("utf-8", "replace")
    chars = len(text)
    lines = text.count("\n") + (1 if text and not text.endswith("\n") else 0)
    enc = gpt_encoder()
    if enc is not None:
        gpt = len(enc.encode(text, disallowed_special=()))
    else:
        gpt = math.ceil(chars / 4)
    return {
        "bytes": len(data),
        "chars": chars,
        "lines": lines,
        "claude": math.ceil(chars / 3.5),
        "gpt": gpt,
        "gpt_exact": enc is not None,
        "gemini": math.ceil(chars / 4),
    }


def _human_size(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    if num_bytes < 1024 * 1024:
        return f"{num_bytes / 1024:.1f} KB"
    if num_bytes < 1024 * 1024 * 1024:
        return f"{num_bytes / (1024 * 1024):.1f} MB"
    return f"{num_bytes / (1024 * 1024 * 1024):.1f} GB"


def _human_tok(n: int) -> str:
    if n < 1000:
        return f"{n}"
    if n < 1_000_000:
        return f"{n / 1000:.1f}k"
    return f"{n / 1_000_000:.1f}M"


def _human_chars(num_chars: int, *, short: bool = False) -> str:
    n = max(0, int(num_chars))
    if short:
        return f"{_human_tok(n)} ch"
    if n < 1000:
        return f"{n} char{'s' if n != 1 else ''}"
    return f"{_human_tok(n)} chars"


def format_stats(data: bytes) -> str:
    s = count_tokens(data)
    lines = int(s["lines"])
    sz = _human_chars(int(s["chars"]))
    lo = min(int(s["gpt"]), int(s["claude"]))
    hi = max(int(s["gpt"]), int(s["claude"]))
    tok_str = f"~{_human_tok(lo)}–{_human_tok(hi)} tokens" if lo != hi else f"~{_human_tok(lo)} tokens"
    line_lbl = f"{lines} line{'s' if lines != 1 else ''}"
    return f"{line_lbl} · {sz} · {tok_str}"


def stats_line(path: Path) -> str | None:
    enabled, _ = get_setting("token_stats")
    if enabled == "false":
        return None
    try:
        return format_stats(path.read_bytes())
    except Exception:
        return None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
CR_LINE_RE = re.compile(r"[^\n]*\r(?!\n)")


def resolve_clipboard_target(out_path: Path, full_output: str) -> Path:
    matches = re.findall(
        r"^(?:\[[A-Za-z0-9._-]+\] Attach:|\s*Bundle:)\s*(\S+)\s*$",
        full_output,
        flags=re.MULTILINE,
    )
    if matches:
        candidate = Path(matches[-1])
        if candidate.is_file():
            return candidate
    return out_path


def clipboard_command(out_path: Path) -> tuple[list[str], str] | None:
    if shutil.which("xclip") and os.environ.get("DISPLAY"):
        return ["xclip", "-selection", "clipboard"], f"xclip -selection clipboard < {out_path}"
    if shutil.which("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
        return ["wl-copy"], f"wl-copy < {out_path}"
    if shutil.which("pbcopy"):
        return ["pbcopy"], f"pbcopy < {out_path}"
    if shutil.which("xsel") and os.environ.get("DISPLAY"):
        return ["xsel", "--clipboard", "--input"], f"xsel --clipboard --input < {out_path}"
    if shutil.which("clip.exe"):
        return ["clip.exe"], f"clip.exe < {out_path}"
    return None


def copy_file_to_clipboard(cmd: list[str], out_path: Path) -> bool:
    try:
        with open(out_path, "rb") as f_in:
            r = subprocess.run(
                cmd,
                stdin=f_in,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        return r.returncode == 0
    except Exception:
        return False


_KV_LINE_RE = re.compile(r"^([A-Za-z][A-Za-z0-9_-]*:)\s+(.*\S.*)$")
_TITLE_COLORS = {
    "BUNDLE": "\x1b[1;96m",
    "PLAN": "\x1b[1;93m",
    "END": "\x1b[1;92m",
    "SYNTAX ERROR": "\x1b[1;91m",
    "NOT RUN": "\x1b[1;91m",
    "MISSING PREVIOUS STEP": "\x1b[1;93m",
    "STEP ALREADY EXISTS": "\x1b[1;93m",
}
_BORDER_COLOR = "\x1b[96m"
_KEY_COLOR = "\x1b[2m"
_ERROR_COLOR = "\x1b[1;91m"
_WARN_COLOR = "\x1b[1;31m"
_HIGHLIGHT_COLOR = "\x1b[1;33m"
_PROMPT_WARN_COLOR = "\x1b[1;93m"
_TAG_COLORS = {
    "read": "\x1b[1;94m",
    "write": "\x1b[1;33m",
    "exec": "\x1b[1;35m",
    "git": "\x1b[1;36m",
    "python": "\x1b[1;32m",
}
_BUNDLE_TAG_COLORS = {
    "header": "\x1b[2m",
    "bundle": "\x1b[1;34m",
    "ruleset": "\x1b[1;36m",
    "group": "\x1b[1;34m",
    "rule": "\x1b[1;36m",
    "rules": "\x1b[1;36m",
    "cmd": "\x1b[1;35m",
    "file": "\x1b[1;94m",
    "include": "\x1b[1;94m",
    "prompt": "\x1b[1;33m",
    "section": "\x1b[1;32m",
    "text": "\x1b[1;32m",
    "body": "\x1b[1;32m",
}
_ANSI_RESET = "\x1b[0m"


def _block_colors(title: str, has_exit: bool = False) -> tuple[str, str]:
    clean_title = title.strip()
    if clean_title == "END" and has_exit:
        t_col = "\x1b[1;91m"
    else:
        t_col = _TITLE_COLORS.get(clean_title, "\x1b[1;96m")
    if t_col.startswith("\x1b[1;"):
        b_col = "\x1b[" + t_col[4:]
    else:
        b_col = _BORDER_COLOR
    return t_col, b_col


def _supports_utf8(stream=None) -> bool:
    target = stream if stream is not None else sys.stdout
    enc = getattr(target, "encoding", None)
    if not enc:
        enc = sys.getdefaultencoding()
    return "utf" in str(enc).lower()


def _use_color(stream=None) -> bool:
    if os.environ.get("NO_COLOR", "") != "":
        return False
    if os.environ.get("TERM", "") == "dumb":
        return False
    target = stream if stream is not None else sys.stdout
    try:
        return bool(target.isatty())
    except Exception:
        return False


def _align_kv_lines(lines: list[str]) -> list[str]:
    out = list(lines)
    i = 0
    n = len(out)
    while i < n:
        m = _KV_LINE_RE.match(out[i])
        if not m:
            i += 1
            continue
        j = i
        parsed: list[tuple[str, str]] = []
        while j < n:
            mj = _KV_LINE_RE.match(out[j])
            if not mj:
                break
            parsed.append((mj.group(1), mj.group(2).lstrip()))
            j += 1
        if len(parsed) >= 2:
            key_w = max(len(k) for k, _ in parsed)
            for idx, (k, v) in enumerate(parsed):
                out[i + idx] = f"{k.ljust(key_w)} {v}"
        i = j
    return out


def _is_same_cwd(wdir_val: str) -> bool:
    wdir_part = wdir_val.split("  (cd ->", 1)[0].strip()
    if not wdir_part:
        return False
    try:
        return Path(wdir_part).resolve() == Path(os.getcwd()).resolve()
    except OSError:
        return os.path.abspath(wdir_part) == os.path.abspath(os.getcwd())


def _colorize_kv_line(line: str) -> str:
    if not _use_color():
        return line
    m = re.match(r"^([A-Za-z][A-Za-z0-9_-]*:)(\s+)(.*)$", line)
    if m:
        key, spaces, val = m.group(1), m.group(2), m.group(3)
        if key == "Workdir:":
            if _is_same_cwd(val):
                return f"{_KEY_COLOR}{key}{spaces}{val}{_ANSI_RESET}"
            return f"{_KEY_COLOR}{key}{_ANSI_RESET}{spaces}{_HIGHLIGHT_COLOR}{val}{_ANSI_RESET}"
        if key == "Sandbox:" and val.strip() == "off":
            return f"{_KEY_COLOR}{key}{spaces}{val}{_ANSI_RESET}"
        if key == "Exit:" and val.strip() != "0":
            return f"{_KEY_COLOR}{key}{_ANSI_RESET}{spaces}{_WARN_COLOR}{val}{_ANSI_RESET}"
        if key == "Error:":
            return f"{_KEY_COLOR}{key}{_ANSI_RESET}{spaces}{_ERROR_COLOR}{val}{_ANSI_RESET}"
        if key in ("Fix:", "Output:", "Stats:"):
            return f"{_KEY_COLOR}{key}{spaces}{val}{_ANSI_RESET}"
        return f"{_KEY_COLOR}{key}{_ANSI_RESET}{spaces}{val}"
    return line


def _regular_color(ansi_col: str) -> str:
    return ("\x1b[" + ansi_col[4:]) if ansi_col.startswith("\x1b[1;") else ansi_col

def _colorize_python_op_rest(rest: str) -> str:
    py_col = _regular_color(_TAG_COLORS["python"])
    write_col = _regular_color(_TAG_COLORS["write"])
    read_col = _regular_color(_TAG_COLORS["read"])
    parts: list[str] = []
    pos = 0
    for m in re.finditer(r"\b(writes:|reads:)\s+([^;]+)", rest):
        if m.start() > pos:
            parts.append(f"{py_col}{rest[pos:m.start()]}{_ANSI_RESET}")
        kind, body = m.group(1), m.group(2)
        seg_col = read_col if kind == "reads:" else write_col
        parts.append(f"{seg_col}{kind} {body}{_ANSI_RESET}")
        pos = m.end()
    if pos < len(rest):
        parts.append(f"{py_col}{rest[pos:]}{_ANSI_RESET}")
    return "".join(parts)

def _colorize_operation_lines(lines: list[str]) -> list[str]:
    if not _use_color():
        return lines
    out: list[str] = []
    last_tag = ""
    for line in lines:
        m = re.match(r"^(\s*)(\d+\.\s+|(?:├─|└─|\|-|`-)\s+)?(\[([a-z0-9_-]+)\])(\s+)(.*)$", line)
        if m:
            indent, num_part, tag_br, tag, spaces, rest = m.groups()
            num_str = num_part or ""
            if num_str and num_str.lstrip().startswith(("├─", "└─", "|-", "`-")):
                num_str = f"{_KEY_COLOR}{num_str}{_ANSI_RESET}"
            if tag in _TAG_COLORS:
                last_tag = tag
                t_col = _TAG_COLORS[tag]
                if tag == "python":
                    out.append(f"{indent}{num_str}{t_col}{tag_br}{_ANSI_RESET}{spaces}{_colorize_python_op_rest(rest)}")
                else:
                    body_col = _regular_color(t_col)
                    out.append(f"{indent}{num_str}{t_col}{tag_br}{_ANSI_RESET}{spaces}{body_col}{rest}{_ANSI_RESET}")
            else:
                last_tag = ""
                out.append(line)
        elif line.startswith("  ") and not line.lstrip().startswith("[") and not line.rstrip().endswith(":"):
            if last_tag == "python":
                out.append(_colorize_python_op_rest(line))
            elif last_tag in _TAG_COLORS:
                body_col = _regular_color(_TAG_COLORS[last_tag])
                out.append(f"{body_col}{line}{_ANSI_RESET}")
            else:
                out.append(line)
        else:
            last_tag = ""
            out.append(line)
    return out
def _colorize_warning_lines(lines: list[str]) -> list[str]:
    if not _use_color():
        return lines
    out: list[str] = []
    for line in lines:
        m = re.match(r"^(\s*)(\[[^\]]+\])(\s+)(.*)$", line)
        if m:
            indent, tag_br, spaces, rest = m.groups()
            out.append(f"{indent}{_WARN_COLOR}{tag_br}{_ANSI_RESET}{spaces}{rest}")
        else:
            out.append(line)
    return out


def _colorize_bundle_lines(lines: list[str]) -> list[str]:
    if not _use_color():
        return lines
    out: list[str] = []
    tree_re = re.compile(r"^((?:│  |\|  |   )*(?:├─ |└─ |\|- |`- ))(.*)$")
    tab_re = re.compile(r"^(\s*\S+%\s+\S+\s+ch\s+\S+L\s+~\S+\s+tok\s+)(\[([a-z0-9_-]+)\])(\s+)(.*)$")
    for line in lines:
        m_tab = tab_re.match(line)
        if m_tab:
            num_prefix, tag_br, tag, spaces, rest = m_tab.groups()
            t_col = _BUNDLE_TAG_COLORS.get(tag, _TAG_COLORS.get(tag, _BORDER_COLOR))
            m_tree = tree_re.match(rest)
            if m_tree:
                rest = f"{_KEY_COLOR}{m_tree.group(1)}{_ANSI_RESET}{m_tree.group(2)}"
            out.append(f"{num_prefix}{t_col}{tag_br}{_ANSI_RESET}{spaces}{rest}")
            continue
        m = re.match(r"^(\s*)(\d+\.\s+)?(\[([a-z0-9_-]+)\])(\s+)(.*)$", line)
        if m:
            indent, num_part, tag_br, tag, spaces, rest = m.groups()
            num_str = num_part or ""
            t_col = _BUNDLE_TAG_COLORS.get(tag, _TAG_COLORS.get(tag, _BORDER_COLOR))
            out.append(f"{indent}{num_str}{t_col}{tag_br}{_ANSI_RESET}{spaces}{rest}")
        else:
            out.append(line)
    return out


def display_width(text: str) -> int:
    clean = ANSI_RE.sub("", text)
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in clean)


def _hr_width() -> int:
    return max(40, shutil.get_terminal_size((80, 24)).columns)


def _format_top_rule(
    title: str,
    width: int,
    title_color: str | None = None,
    border_color: str | None = None,
) -> str:
    clean_title = title.strip()
    hdr = clean_title
    right_len = max(4, width - 4 - display_width(hdr))
    if _supports_utf8():
        left = "╭─ "
        fill = "─" * right_len
    else:
        left = "+- "
        fill = "-" * right_len
    if _use_color():
        default_t, default_b = _block_colors(clean_title)
        t_col = title_color or default_t
        b_col = border_color or default_b
        return f"{b_col}{left}{_ANSI_RESET}{t_col}{hdr}{_ANSI_RESET} {b_col}{fill}{_ANSI_RESET}"
    return f"{left}{hdr} {fill}"


def _format_bottom_rule(width: int, border_color: str | None = None) -> str:
    dash_len = max(3, width - 1)
    rule = f"╰{'─' * dash_len}" if _supports_utf8() else f"+{'-' * dash_len}"
    if _use_color():
        b_col = border_color or _BORDER_COLOR
        return f"{b_col}{rule}{_ANSI_RESET}"
    return rule


def _prefix_block_line(line: str, border_color: str | None = None) -> str:
    bar = "│" if _supports_utf8() else "|"
    if _use_color():
        b_col = border_color or _BORDER_COLOR
        bar_str = f"{b_col}{bar}{_ANSI_RESET}"
        return f"{bar_str} {line}" if line else bar_str
    return f"{bar} {line}" if line else bar


def _render_block(
    title: str,
    content_lines: list[str],
    prompt_line: str | None = None,
    term_cols: int | None = None,
) -> tuple[str, int, int]:
    clean_title = title.strip()
    hdr = clean_title
    cols = term_cols if term_cols is not None else _hr_width()
    width = max(min(cols, 48), display_width(hdr) + 8)
    aligned_lines = _align_kv_lines(content_lines)
    has_exit = any(l.startswith("Exit:") for l in aligned_lines)
    title_color, border_color = _block_colors(clean_title, has_exit=has_exit)
    top = _format_top_rule(title, width, title_color=title_color, border_color=border_color)
    bottom = _format_bottom_rule(width, border_color=border_color)
    rows = [_prefix_block_line(_colorize_kv_line(line), border_color=border_color) for line in aligned_lines]
    if not rows and prompt_line is None:
        rows = [_prefix_block_line("", border_color=border_color)]
    cursor_col_offset = 0
    if prompt_line is not None:
        if aligned_lines:
            rows.append(_prefix_block_line("", border_color=border_color))
        prefixed_prompt = _prefix_block_line(prompt_line, border_color=border_color)
        rows.append(prefixed_prompt)
        cursor_col_offset = display_width(prefixed_prompt)
    box = "\n".join([top, *rows, bottom])
    return box, width, cursor_col_offset


def _last_nonempty_line(path: Path, skip_prefixes: tuple[str, ...], max_len: int) -> str:
    try:
        if not path.is_file():
            return ""
        raw = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""
    for line in reversed(raw.splitlines()):
        s = line.strip()
        if not s:
            continue
        if skip_prefixes and any(s.startswith(p) for p in skip_prefixes):
            continue
        if len(s) > max_len:
            return s[: max_len - 3] + "..."
        return s
    return ""


def _extract_last_error_line(out_path: Path, label: str | None = None) -> str:
    skip_prefixes: tuple[str, ...] = ()
    if label:
        skip_prefixes = (
            f"[{label}] START",
            f"[{label}] END",
            f"[{label}] STOP --fix",
            f"[{label}] <stdin> line ",
            f"[{label}] patched ",
            f"[{label}] SECURITY WARNING:",
        )
    max_len = max(60, _hr_width() - 8)
    if out_path.name == "out" and not _is_file_edited(out_path):
        err_line = _last_nonempty_line(out_path.with_name("err"), skip_prefixes, max_len)
        if err_line:
            return err_line
    return _last_nonempty_line(out_path, skip_prefixes, max_len)


def _format_end_fix_status(label: str, resolved_sdir: Path | None) -> str:
    if "/" not in label:
        return ""
    sess, step = label.split("/", 1)
    base_step = step.split("_", 1)[0]
    try:
        max_attempts = int(get_setting("max_fix_attempts")[0])
    except Exception:
        max_attempts = 2
    used = 0
    fn_failed = globals().get("_consecutive_failed_fixes")
    if callable(fn_failed) and resolved_sdir is not None:
        try:
            used = int(fn_failed(resolved_sdir, base_step))
        except Exception:
            used = 0
    if used >= max_attempts:
        next_hint = f"; emit a fresh {sess}/{int(base_step) + 1} block instead" if base_step.isdigit() else ""
        return f"STOP --fix ({used}/{max_attempts} failed attempts{next_hint})"
    return f"{prog_name()} --fix {label} ({used}/{max_attempts} failed attempts)"


def _format_step_timings_summary(
    op_timings: list[dict[str, object]],
    *,
    failed_step: int | None = None,
    rc: int | None = None,
) -> str:
    parts: list[str] = []
    for item in op_timings:
        step_num = item.get("step")
        tag = str(item.get("tag") or "exec")
        try:
            dur_ms = int(item.get("duration_ms") or 0)
        except (TypeError, ValueError):
            dur_ms = 0
        entry = f"{step_num}. [{tag}] {format_duration(dur_ms / 1000.0)}"
        if rc is not None and rc != 0 and failed_step is not None and step_num == failed_step:
            entry += " (failed)"
        parts.append(entry)
    return " · ".join(parts)


def _build_start_bundle_parts(
    sdir: Path | None,
    bundle_path: Path,
    *,
    details: bool = False,
    max_width: int | None = None,
    plan: dict[str, object] | None = None,
    include_part_count: bool = True,
) -> tuple[list[str], list[str]]:
    if plan is None:
        fn_load = globals().get("load_session_bundle_plan")
        if callable(fn_load):
            loaded = fn_load(sdir, bundle_path)
            if isinstance(loaded, dict):
                plan = loaded
    if not isinstance(plan, dict):
        return [], []
    max_row_len = max_width if max_width is not None else max(24, _hr_width() - 2)
    breakdown: list[str] = []
    part_cnt = int(plan.get("part_count") or 0)
    count_suffix = f" ({part_cnt} part{'s' if part_cnt != 1 else ''})" if include_part_count else ""
    if details:
        fn_parts = globals().get("format_bundle_parts_lines")
        part_lines = fn_parts(plan, max_width=max_row_len) if callable(fn_parts) else []
        if part_lines:
            hdr = f"Parts{count_suffix}:"
            breakdown.append(f"{_KEY_COLOR}{hdr}{_ANSI_RESET}" if _use_color() else hdr)
            breakdown.extend(_colorize_bundle_lines(part_lines))
    else:
        fn_summary = globals().get("format_bundle_summary_lines")
        sum_lines = fn_summary(plan, max_width=max_row_len) if callable(fn_summary) else []
        if sum_lines:
            hdr = f"Summary{count_suffix}:"
            breakdown.append(f"{_KEY_COLOR}{hdr}{_ANSI_RESET}" if _use_color() else hdr)
            breakdown.extend(_colorize_bundle_lines(sum_lines))
    warnings_sec: list[str] = []
    fn_warns = globals().get("format_bundle_warning_items")
    warn_items = fn_warns(plan) if callable(fn_warns) else []
    if warn_items:
        whdr = f"Bundle warnings ({len(warn_items)}):"
        warnings_sec.append(f"{_WARN_COLOR}{whdr}{_ANSI_RESET}" if _use_color() else whdr)
        warnings_sec.extend(_colorize_warning_lines(_wrap_labeled_items(warn_items, max_row_len, indent="  ")))
    return breakdown, warnings_sec

def _build_start_bundle_sections(
    sdir: Path | None,
    bundle_path: Path,
    *,
    details: bool = False,
    max_width: int | None = None,
) -> list[str]:
    b, w = _build_start_bundle_parts(sdir, bundle_path, details=details, max_width=max_width)
    return [*b, "", *w] if (b and w) else [*b, *w]


def build_box_body_lines(
    out_path: Path,
    rc: int | None = None,
    stats: str | None = None,
    extra_lines: list[str] | None = None,
    label: str | None = None,
    sdir: Path | None = None,
    edited: bool | None = None,
    error_source: Path | None = None,
    duration_s: float | None = None,
    op_timings: list[dict[str, object]] | None = None,
    failed_step: int | None = None,
    title_kind: str | None = None,
    bundle_details: bool = False,
    max_width: int | None = None,
) -> list[str]:
    err_src = error_source if error_source is not None else out_path
    resolved_sdir = sdir if sdir is not None else _resolve_session_dir(label, err_src)
    is_edited = _is_file_edited(err_src) if edited is None else edited
    is_bundle_box = bool(title_kind and title_kind.strip() == "BUNDLE")
    bundle_plan_obj: dict[str, object] | None = None
    if is_bundle_box:
        fn_load = globals().get("load_session_bundle_plan")
        if callable(fn_load):
            loaded_plan = fn_load(resolved_sdir, err_src)
            if isinstance(loaded_plan, dict):
                bundle_plan_obj = loaded_plan
    if (duration_s is None or op_timings is None) and err_src.name == "out":
        step_meta = read_step_meta(err_src.parent)
        if duration_s is None and isinstance(step_meta.get("duration_ms"), (int, float)):
            duration_s = float(step_meta["duration_ms"]) / 1000.0
        if op_timings is None and isinstance(step_meta.get("operations"), list):
            op_timings = [x for x in step_meta["operations"] if isinstance(x, dict)]
        if failed_step is None and isinstance(step_meta.get("failed_step"), int):
            failed_step = int(step_meta["failed_step"])
    duration_str = format_duration(duration_s) if duration_s is not None else None
    steps_summary = (
        _format_step_timings_summary(op_timings, failed_step=failed_step, rc=rc)
        if op_timings
        else ""
    )
    if extra_lines is not None:
        detail_lines = list(extra_lines)
    else:
        detail_lines = []
        if rc is not None and rc != 0:
            detail_lines.append(f"Exit: {rc}")
            last_err = _extract_last_error_line(err_src, label=label)
            if last_err:
                detail_lines.append(f"Error: {last_err}")
            if label:
                fix_status = _format_end_fix_status(label, resolved_sdir)
                if fix_status:
                    detail_lines.append(f"Fix: {fix_status}")
        if steps_summary:
            detail_lines.append(f"Steps: {steps_summary}")
        detail_lines.append(f"Output: {out_path}")
    if not any(line.startswith("Stats:") for line in detail_lines):
        stats_parts: list[str] = []
        if stats:
            stats_parts.append(stats)
        if duration_str:
            stats_parts.append(duration_str)
        if stats_parts:
            joined_stats = " · ".join(stats_parts)
            if is_bundle_box and isinstance(bundle_plan_obj, dict):
                p_cnt = int(bundle_plan_obj.get("part_count") or 0)
                if p_cnt > 0:
                    joined_stats += f" ({p_cnt} part{'s' if p_cnt != 1 else ''})"
            detail_lines.append(f"Stats: {joined_stats} (edited)" if is_edited else f"Stats: {joined_stats}")
        elif is_edited:
            detail_lines.append("Stats: (edited)")
    has_header = any(line.startswith(("Block:", "Session:")) for line in detail_lines)
    if has_header or (label is None and sdir is None):
        base_lines = _align_kv_lines(detail_lines)
    else:
        hdr_lines = format_session_header_lines(label=label, sdir=resolved_sdir, clamp_width=max_width)
        if detail_lines:
            base_lines = _align_kv_lines([*hdr_lines, "", *detail_lines])
        else:
            base_lines = hdr_lines
    if is_bundle_box:
        has_stats_line = any(line.startswith("Stats:") for line in base_lines)
        has_stats_count = bool(
            stats and isinstance(bundle_plan_obj, dict) and int(bundle_plan_obj.get("part_count") or 0) > 0
        )
        b_breakdown, b_warnings = _build_start_bundle_parts(
            resolved_sdir,
            err_src,
            details=bundle_details,
            max_width=max_width,
            plan=bundle_plan_obj,
            include_part_count=not has_stats_count,
        )
        out_lines = list(base_lines)
        if b_breakdown:
            if out_lines and not has_stats_line:
                out_lines.append("")
            out_lines.extend(b_breakdown)
        if b_warnings:
            if out_lines:
                out_lines.append("")
            out_lines.extend(b_warnings)
        return out_lines
    return base_lines


def _clipboard_prompt_line(title_kind: str) -> str:
    kind = title_kind.strip()
    if kind == "BUNDLE":
        return "-> Copy to clipboard? [Enter/e(dit)/d(etails)/Esc]:"
    if kind == "END":
        return "-> Copy to clipboard? [Enter/e(dit)/Esc]:"
    return "-> Copy to clipboard? [Enter/v(iew)/Esc]:"


def format_clipboard_box(
    label: str,
    out_path: Path,
    ok: bool = True,
    rc: int | None = None,
    stats: str | None = None,
    title_kind: str = "END",
    extra_lines: list[str] | None = None,
    cmd_str: str | None = None,
    edited: bool | None = None,
    error_source: Path | None = None,
    duration_s: float | None = None,
    op_timings: list[dict[str, object]] | None = None,
    failed_step: int | None = None,
    bundle_details: bool = False,
    sdir: Path | None = None,
) -> tuple[str, int, int]:
    _ = ok, cmd_str
    cols = _hr_width()
    body_lines = build_box_body_lines(
        out_path,
        rc=rc,
        stats=stats,
        extra_lines=extra_lines,
        label=label,
        sdir=sdir,
        edited=edited,
        error_source=error_source,
        duration_s=duration_s,
        op_timings=op_timings,
        failed_step=failed_step,
        title_kind=title_kind,
        bundle_details=bundle_details,
        max_width=max(24, cols - 2),
    )
    prompt_line = _clipboard_prompt_line(title_kind)
    return _render_block(title_kind, body_lines, prompt_line=prompt_line, term_cols=cols)


def _box_rows_above_prompt(box_text: str, term_cols: int) -> int:
    lines = box_text.splitlines()
    if len(lines) <= 2:
        return 0
    cols = max(1, term_cols)
    return sum(max(1, (display_width(ln) + cols - 1) // cols) for ln in lines[:-2])


def offer_clipboard_copy(
    label: str,
    out_path: Path,
    ok: bool = True,
    rc: int | None = None,
    title_kind: str = "END",
    extra_lines: list[str] | None = None,
    duration_s: float | None = None,
    op_timings: list[dict[str, object]] | None = None,
    failed_step: int | None = None,
    sdir: Path | None = None,
) -> None:
    if in_run_block():
        return
    mode = clipboard_mode()
    if mode == "never":
        return
    is_start_bundle = title_kind.strip() == "BUNDLE"
    is_end_box = title_kind.strip() == "END"
    edit_target = out_path
    copy_target = edit_target
    if is_end_box and edit_target.is_file():
        try:
            copy_target = resolve_clipboard_target(
                edit_target, edit_target.read_text(encoding="utf-8", errors="replace")
            )
        except OSError:
            copy_target = edit_target
    clip = clipboard_command(copy_target)
    if clip is None:
        return
    cmd, cmd_str = clip
    if mode == "auto":
        if copy_file_to_clipboard(cmd, copy_target):
            sys.stdout.write(f"✓ Copied {copy_target} to clipboard.\n")
        else:
            sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    if not sys.stdout.isatty():
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    orig_path = _orig_file_backup_path(edit_target)
    is_edited = _is_file_edited(edit_target, orig_path)
    show_details = False
    prev_cols = _hr_width()
    box, rule_width, cursor_offset = format_clipboard_box(
        label,
        copy_target,
        ok=ok,
        rc=rc,
        stats=stats_line(copy_target),
        title_kind=title_kind,
        extra_lines=extra_lines,
        cmd_str=cmd_str,
        edited=is_edited,
        error_source=edit_target,
        duration_s=duration_s,
        op_timings=op_timings,
        failed_step=failed_step,
        bundle_details=show_details,
        sdir=sdir,
    )
    _, border_col = _block_colors(title_kind, has_exit=(rc is not None and rc != 0))
    bottom = _format_bottom_rule(rule_width, border_color=border_col)
    prefixed_line2 = _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"\n{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_clipboard_key(tty_r)
                if is_start_bundle and action == "details":
                    show_details = not show_details
                    up_rows = _box_rows_above_prompt(box, prev_cols)
                    prev_cols = _hr_width()
                    box, rule_width, cursor_offset = format_clipboard_box(
                        label,
                        copy_target,
                        ok=ok,
                        rc=rc,
                        stats=stats_line(copy_target),
                        title_kind=title_kind,
                        extra_lines=extra_lines,
                        cmd_str=cmd_str,
                        edited=is_edited,
                        error_source=edit_target,
                        duration_s=duration_s,
                        op_timings=op_timings,
                        failed_step=failed_step,
                        bundle_details=show_details,
                        sdir=sdir,
                    )
                    bottom = _format_bottom_rule(rule_width, border_color=border_col)
                    prefixed_line2 = _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
                    move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                    tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                    tty_w.flush()
                    continue
                if (is_start_bundle and action == "edit") or (is_end_box and action in ("edit", "view")):
                    if edit_target.is_file():
                        try:
                            before_bytes: bytes | None = edit_target.read_bytes()
                        except OSError:
                            before_bytes = None
                        open_script_in_editor(edit_target, tty_r, tty_w)
                        try:
                            after_bytes: bytes | None = edit_target.read_bytes() if edit_target.is_file() else None
                        except OSError:
                            after_bytes = None
                        changed = before_bytes is not None and after_bytes is not None and after_bytes != before_bytes
                        if changed:
                            assert before_bytes is not None and after_bytes is not None
                            _write_orig_backup_once(orig_path, before_bytes)
                            if is_start_bundle:
                                fn_refresh = globals().get("refresh_bundle_meta")
                                if callable(fn_refresh):
                                    fn_refresh(edit_target)
                            elif is_end_box:
                                after_text = after_bytes.decode("utf-8", errors="replace")
                                copy_target = resolve_clipboard_target(edit_target, after_text)
                                new_clip = clipboard_command(copy_target)
                                if new_clip is not None:
                                    cmd, cmd_str = new_clip
                        if is_start_bundle or changed:
                            is_edited = _is_file_edited(edit_target, orig_path)
                            up_rows = _box_rows_above_prompt(box, prev_cols)
                            prev_cols = _hr_width()
                            box, rule_width, cursor_offset = format_clipboard_box(
                                label,
                                copy_target,
                                ok=ok,
                                rc=rc,
                                stats=stats_line(copy_target),
                                title_kind=title_kind,
                                extra_lines=extra_lines,
                                cmd_str=cmd_str,
                                edited=is_edited,
                                error_source=edit_target,
                                duration_s=duration_s,
                                op_timings=op_timings,
                                failed_step=failed_step,
                                bundle_details=show_details,
                                sdir=sdir,
                            )
                            bottom = _format_bottom_rule(rule_width, border_color=border_col)
                            prefixed_line2 = _prefix_block_line(_clipboard_prompt_line(title_kind), border_color=border_col)
                            move_up = f"\033[{up_rows}A" if up_rows > 0 else ""
                            tty_w.write(f"\r{move_up}\033[J{box}\r\033[1A\033[{cursor_offset}C")
                            tty_w.flush()
                        else:
                            tty_w.write(f"\r\033[K{prefixed_line2}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                            tty_w.flush()
                    continue
                if not is_start_bundle and not is_end_box and action == "view":
                    if edit_target.is_file():
                        open_script_in_editor(edit_target, tty_r, tty_w)
                        tty_w.write(f"\r\033[K{prefixed_line2}\n\r\033[K{bottom}\r\033[1A\033[{cursor_offset}C")
                        tty_w.flush()
                    continue
                if action in ("view", "edit", "details"):
                    continue
                if action == "copy":
                    if copy_file_to_clipboard(cmd, copy_target):
                        status_line = f"✓ Copied {copy_target} to clipboard."
                    else:
                        status_line = f"✗ Clipboard copy failed; run: {cmd_str}"
                else:
                    status_line = "Skipped clipboard copy."
                break
            prefixed_status = _prefix_block_line(status_line, border_color=border_col)
            tty_w.write(f"\r\033[K{prefixed_status}\n\r\033[K{bottom}\n")
            tty_w.flush()
    except OSError:
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()


BUNDLE_BOUNDARY_HEADER = "bundle-boundary"
BUNDLE_EXPOSE_HEADER = "bundle-expose"
BUNDLE_HIDE_HEADER = "bundle-hide"
DEFAULT_BUNDLE_TOKEN_BUDGET = 100000
DEFAULT_FRAGMENT_MAX_TOKENS = 20000

SECTION_HEADER_RE = re.compile(r"^={5,}\s*(.+?)\s*={5,}$")


def _parse_header_filter_tokens(raw: str) -> set[str]:
    tokens: set[str] = set()
    for tok in re.split(r"[\s,]+", raw or ""):
        cleaned = re.sub(r"\s+", "-", tok.strip().lower())
        if cleaned:
            tokens.add(cleaned)
    return tokens


def extract_bundle_transport_headers(headers: list[tuple[str, str]]) -> dict[str, str]:
    out: dict[str, str] = {}
    for k, v in headers:
        if is_bundle_transport_header(k):
            norm = re.sub(r"\s+", "-", k.strip().lower())
            out[norm] = v.strip()
    return out


def get_bundle_boundary(headers: list[tuple[str, str]]) -> str | None:
    transport = extract_bundle_transport_headers(headers)
    val = transport.get(BUNDLE_BOUNDARY_HEADER, "").strip()
    return val or None


def filter_exposed_headers(headers: list[tuple[str, str]]) -> list[tuple[str, str]]:
    transport = extract_bundle_transport_headers(headers)
    raw_expose = transport.get(BUNDLE_EXPOSE_HEADER, "")
    if not raw_expose:
        return []
    expose_set = _parse_header_filter_tokens(raw_expose)
    hide_set = _parse_header_filter_tokens(transport.get(BUNDLE_HIDE_HEADER, ""))
    if "*" in hide_set or "all" in hide_set:
        return []
    expose_all = "*" in expose_set or "all" in expose_set
    if not expose_all and (not expose_set or expose_set == {"none"}):
        return []

    exposed: list[tuple[str, str]] = []
    for k, v in headers:
        norm_k = re.sub(r"\s+", "-", k.strip().lower())
        if is_bundle_transport_header(norm_k):
            continue
        if norm_k in HIDDEN_SESSION_HEADER_KEYS:
            continue
        if norm_k in hide_set:
            continue
        if not expose_all and norm_k not in expose_set:
            continue
        if not v.strip():
            continue
        exposed.append((k, v))
    return exposed


def _infer_section_meta(title: str | None, *, is_sections: bool, is_preamble: bool = False) -> dict[str, object]:
    if title is None:
        if is_sections:
            return {"kind": "text", "name": "Preamble" if is_preamble else "Text"}
        return {"kind": "body", "name": "Body"}
    low = title.lower()
    if low == "rules":
        return {"kind": "rules", "name": "Rules"}
    if low == "prompt":
        return {"kind": "prompt", "name": "Prompt"}
    if title.startswith(chr(36) + " "):
        return {"kind": "cmd", "name": title[2:].strip()}
    if low.startswith("file:"):
        return {"kind": "file", "name": title.split(":", 1)[1].strip()}
    return {"kind": "section", "name": title}


def _bundle_thresholds() -> tuple[int, int]:
    try:
        bundle_max = int(get_setting("bundle_max_tokens")[0])
    except Exception:
        bundle_max = DEFAULT_BUNDLE_TOKEN_BUDGET
    try:
        frag_max = int(get_setting("fragment_max_tokens")[0])
    except Exception:
        frag_max = DEFAULT_FRAGMENT_MAX_TOKENS
    return max(0, bundle_max), max(0, frag_max)


def _part_label(entry: dict[str, object]) -> str:
    name = str(entry.get("name") or entry.get("id") or "")
    if name:
        return name
    grp = str(entry.get("group") or "")
    if grp:
        return grp
    kind = str(entry.get("kind") or "part")
    idx = entry.get("index")
    return f"{kind} #{idx}" if idx is not None else kind


def _is_cmd_output_empty(part_lines: list[str]) -> bool:
    non_empty = [ln for ln in part_lines if ln.strip()]
    if not non_empty:
        return True
    if SECTION_HEADER_RE.match(non_empty[0].strip()):
        return len(non_empty) == 1
    return False


def analyze_bundle_warnings(
    parts: list[dict[str, object]],
    part_texts: list[str] | None = None,
    part_lines_list: list[list[str]] | None = None,
    total_gpt: int | None = None,
) -> list[dict[str, object]]:
    bundle_budget, frag_limit = _bundle_thresholds()
    warnings: list[dict[str, object]] = []
    computed_gpt = 0
    for idx_0, entry in enumerate(parts):
        idx = int(entry.get("index") or (idx_0 + 1))
        kind = str(entry.get("kind") or "part").lower()
        label = _part_label(entry)
        gpt_cnt = int(entry.get("gpt") or 0)
        computed_gpt += gpt_cnt
        rc_val = entry.get("rc")
        if isinstance(rc_val, int) and rc_val != 0:
            warnings.append(
                {
                    "code": "cmd_rc",
                    "severity": "warn",
                    "part_index": idx,
                    "part_name": label,
                    "message": f"command {label!r} exited with rc={rc_val}",
                }
            )
        if kind == "cmd" and part_lines_list is not None and idx_0 < len(part_lines_list):
            if _is_cmd_output_empty(part_lines_list[idx_0]):
                warnings.append(
                    {
                        "code": "cmd_empty",
                        "severity": "warn",
                        "part_index": idx,
                        "part_name": label,
                        "message": f"command {label!r} produced empty output",
                    }
                )
        if frag_limit > 0 and gpt_cnt > frag_limit:
            warnings.append(
                {
                    "code": "fragment_oversized",
                    "severity": "warn",
                    "part_index": idx,
                    "part_name": label,
                    "message": f"fragment {label!r} is oversized (~{_human_tok(gpt_cnt)} > {_human_tok(frag_limit)} tokens)",
                }
            )
        if kind not in ("rule", "rules") and part_texts is not None and idx_0 < len(part_texts):
            sec_hits = scan_content_secrets(part_texts[idx_0])
            if sec_hits:
                labels: list[str] = []
                for h in sec_hits:
                    lbl = str(h.get("label") or h.get("category") or "secret")
                    if lbl not in labels:
                        labels.append(lbl)
                cat_str = ", ".join(labels)
                warnings.append(
                    {
                        "code": "secret_detected",
                        "severity": "warn",
                        "part_index": idx,
                        "part_name": label,
                        "message": f"potential secret in {label!r} ({cat_str})",
                    }
                )
    eff_total_gpt = total_gpt if total_gpt is not None else computed_gpt
    if bundle_budget > 0 and eff_total_gpt > bundle_budget:
        warnings.append(
            {
                "code": "token_budget",
                "severity": "warn",
                "message": f"total bundle (~{_human_tok(eff_total_gpt)} tokens) exceeds {_human_tok(bundle_budget)} token budget",
            }
        )
    return warnings


def _part_chars(entry: dict[str, object]) -> int:
    raw = entry.get("chars")
    if isinstance(raw, (int, float)) and not isinstance(raw, bool):
        return int(raw)
    return int(entry.get("bytes") or 0)


def _resolve_part_chain(entry: dict[str, object]) -> list[str]:
    if "chain" in entry and isinstance(entry.get("chain"), (list, tuple)):
        return [str(x).strip() for x in entry["chain"] if str(x).strip()]
    grp = str(entry.get("group") or "").strip()
    if not grp:
        return []
    via = str(entry.get("via") or "").strip()
    if via and via != grp:
        return [via, grp]
    return [grp]


def _join_chain_label(chain: list[str], name: str) -> str:
    if not chain:
        return name
    if not name:
        return " -> ".join(chain) if len(chain) > 1 else chain[0]
    cur = name
    for seg in reversed(chain):
        if cur == seg or cur.startswith(seg + ":") or cur.startswith(seg + "/"):
            continue
        cur = f"{seg}: {cur}"
    return cur


def _child_rel_label(prefix: str, name: str) -> str:
    if not prefix or not name or name == prefix:
        return name
    for sep in (":", "/"):
        if name.startswith(prefix + sep):
            return name[len(prefix) + 1 :].lstrip() or name
    return name


def _recompute_share_pct(plan: dict[str, object]) -> None:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    hdr = plan.get("header") if isinstance(plan.get("header"), dict) else None
    total_chars = int(plan.get("chars") if plan.get("chars") is not None else (plan.get("bytes") or 0))
    total_bytes = int(plan.get("bytes") or 0)
    denom = total_chars if total_chars > 0 else total_bytes
    use_chars = total_chars > 0
    for entry in parts:
        val = _part_chars(entry) if use_chars else int(entry.get("bytes") or 0)
        entry["share_pct"] = round(val * 100.0 / denom, 1) if denom > 0 else 0.0
    if hdr is not None:
        hval = _part_chars(hdr) if use_chars else int(hdr.get("bytes") or 0)
        hdr["share_pct"] = round(hval * 100.0 / denom, 1) if denom > 0 else 0.0


def reconcile_bundle_plan(plan: dict[str, object], full_text: str) -> dict[str, object]:
    out = dict(plan)
    parts = [p for p in (out.get("parts") or []) if isinstance(p, dict)]
    out["parts"] = parts
    sum_lines = sum(int(p.get("lines") or 0) for p in parts)
    sum_chars = sum(_part_chars(p) for p in parts)
    sum_bytes = sum(int(p.get("bytes") or 0) for p in parts)
    sum_gpt = sum(int(p.get("gpt") or 0) for p in parts)
    sum_claude = sum(int(p.get("claude") or 0) for p in parts)
    full_tok = count_tokens(full_text.encode("utf-8"))
    f_lines = int(full_tok["lines"])
    f_chars = int(full_tok["chars"])
    f_bytes = int(full_tok["bytes"])
    f_gpt = int(full_tok["gpt"])
    f_claude = int(full_tok["claude"])
    rem_lines = f_lines - sum_lines
    rem_chars = f_chars - sum_chars
    rem_bytes = f_bytes - sum_bytes
    if (rem_lines > 0 or rem_chars > 0) and f_chars >= sum_chars and f_lines >= sum_lines:
        out["lines"] = f_lines
        out["chars"] = f_chars
        out["bytes"] = f_bytes
        out["gpt"] = f_gpt
        out["claude"] = f_claude
        out["gpt_exact"] = bool(full_tok["gpt_exact"])
        out["header"] = {
            "kind": "header",
            "name": "Headers & spacing",
            "lines": max(0, rem_lines),
            "chars": max(0, rem_chars),
            "bytes": max(0, rem_bytes),
            "gpt": max(0, f_gpt - sum_gpt),
            "claude": max(0, f_claude - sum_claude),
        }
    else:
        out.pop("header", None)
        out["lines"] = sum_lines
        out["chars"] = sum_chars
        out["bytes"] = sum_bytes
        out["gpt"] = sum_gpt
        out["claude"] = sum_claude
    _recompute_share_pct(out)
    return out


def group_bundle_parts(parts: list[dict[str, object]]) -> list[dict[str, object]]:
    buckets: dict[tuple[str, tuple[str, ...]], dict[str, object]] = {}
    order: list[tuple[str, tuple[str, ...]]] = []
    for entry in parts:
        kind = str(entry.get("kind") or "part")
        chain = tuple(_resolve_part_chain(entry))
        group = " / ".join(chain) if chain else ""
        key = (kind, chain)
        if key not in buckets:
            order.append(key)
            buckets[key] = {
                "kind": kind,
                "group": group,
                "chain": list(chain),
                "count": 0,
                "lines": 0,
                "chars": 0,
                "bytes": 0,
                "gpt": 0,
                "claude": 0,
                "share_pct": 0.0,
                "names": [],
                "rc_errors": 0,
            }
        b = buckets[key]
        b["count"] = int(b["count"]) + 1
        b["lines"] = int(b["lines"]) + int(entry.get("lines") or 0)
        b["chars"] = int(b["chars"]) + _part_chars(entry)
        b["bytes"] = int(b["bytes"]) + int(entry.get("bytes") or 0)
        b["gpt"] = int(b["gpt"]) + int(entry.get("gpt") or 0)
        b["claude"] = int(b["claude"]) + int(entry.get("claude") or 0)
        b["share_pct"] = round(float(b["share_pct"]) + float(entry.get("share_pct") or 0.0), 1)
        name = str(entry.get("name") or entry.get("id") or "")
        names_list = b["names"]
        if name and isinstance(names_list, list) and name not in names_list:
            names_list.append(name)
        rc_val = entry.get("rc")
        if isinstance(rc_val, int) and rc_val != 0:
            b["rc_errors"] = int(b["rc_errors"]) + 1
    return [buckets[k] for k in order]


def _build_bundle_plan(
    protocol: str,
    boundary: str | None,
    raw_parts: list[tuple[dict[str, object], list[str]]],
) -> dict[str, object]:
    parts: list[dict[str, object]] = []
    part_texts: list[str] = []
    part_lines_list: list[list[str]] = []
    total_lines = 0
    total_chars = 0
    total_bytes = 0
    total_gpt = 0
    total_claude = 0
    gpt_exact = gpt_encoder() is not None

    for idx, (meta, part_lines) in enumerate(raw_parts, 1):
        part_text = "\n".join(part_lines) + ("\n" if part_lines else "")
        part_texts.append(part_text)
        part_lines_list.append(part_lines)
        tok = count_tokens(part_text.encode("utf-8"))
        gpt_exact = bool(tok["gpt_exact"])
        lines_cnt = int(tok["lines"])
        chars_cnt = int(tok["chars"])
        bytes_cnt = int(tok["bytes"])
        gpt_cnt = int(tok["gpt"])
        claude_cnt = int(tok["claude"])

        entry: dict[str, object] = {
            "index": idx,
            "kind": str(meta.get("kind") or "part"),
        }
        if meta.get("id"):
            entry["id"] = str(meta["id"])
        name_val = str(meta.get("name") or meta.get("id") or "")
        if name_val:
            entry["name"] = name_val
        if "chain" in meta and isinstance(meta.get("chain"), (list, tuple)):
            entry["chain"] = [str(x).strip() for x in meta["chain"] if str(x).strip()]
        if meta.get("group"):
            entry["group"] = str(meta["group"])
        if meta.get("via"):
            entry["via"] = str(meta["via"])
        rc_val = meta.get("rc")
        if isinstance(rc_val, (int, float)) and not isinstance(rc_val, bool):
            entry["rc"] = int(rc_val)
        ms_val = meta.get("ms")
        if isinstance(ms_val, (int, float)) and not isinstance(ms_val, bool):
            ms_f = float(ms_val)
            entry["ms"] = int(round(ms_f)) if ms_f.is_integer() else ms_f
        entry["lines"] = lines_cnt
        entry["chars"] = chars_cnt
        entry["bytes"] = bytes_cnt
        entry["gpt"] = gpt_cnt
        entry["claude"] = claude_cnt

        total_lines += lines_cnt
        total_chars += chars_cnt
        total_bytes += bytes_cnt
        total_gpt += gpt_cnt
        total_claude += claude_cnt
        parts.append(entry)

    plan: dict[str, object] = {
        "protocol": protocol,
        "boundary": boundary or None,
        "part_count": len(parts),
        "lines": total_lines,
        "chars": total_chars,
        "bytes": total_bytes,
        "gpt": total_gpt,
        "claude": total_claude,
        "gpt_exact": gpt_exact,
        "parts": parts,
        "warnings": analyze_bundle_warnings(
            parts,
            part_texts=part_texts,
            part_lines_list=part_lines_list,
            total_gpt=total_gpt,
        ),
    }
    _recompute_share_pct(plan)
    return plan


def _split_section_fallback(norm_text: str, boundary_val: str | None) -> tuple[str, dict[str, object]]:
    clean_body = norm_text.strip("\n")
    if not clean_body.strip():
        return "", _build_bundle_plan("empty", boundary_val, [])

    lines = clean_body.splitlines()
    raw_sections: list[tuple[str | None, list[str]]] = []
    cur_title: str | None = None
    cur_lines: list[str] = []
    saw_section = False

    for line in lines:
        m = SECTION_HEADER_RE.match(line.strip())
        if m:
            if saw_section or any(x.strip() for x in cur_lines):
                while cur_lines and not cur_lines[-1].strip():
                    cur_lines.pop()
                raw_sections.append((cur_title, cur_lines))
            saw_section = True
            cur_title = m.group(1).strip()
            cur_lines = [line]
        else:
            cur_lines.append(line)

    if saw_section or any(x.strip() for x in cur_lines):
        while cur_lines and not cur_lines[-1].strip():
            cur_lines.pop()
        raw_sections.append((cur_title, cur_lines))

    protocol = "sections" if saw_section else "body"
    raw_parts: list[tuple[dict[str, object], list[str]]] = []
    for idx, (sec_title, sec_lines) in enumerate(raw_sections):
        meta = _infer_section_meta(sec_title, is_sections=saw_section, is_preamble=(idx == 0))
        raw_parts.append((meta, sec_lines))
    plan = _build_bundle_plan(protocol, boundary_val, raw_parts)
    if clean_body:
        plan = reconcile_bundle_plan(plan, clean_body + "\n")
    return clean_body, plan


def parse_bundle_fragments(body_text: str, boundary: str | None = None) -> tuple[str, dict[str, object]]:
    if not body_text:
        return "", _build_bundle_plan("empty", boundary, [])

    norm_text = body_text.replace("\r\n", "\n")
    boundary_val = (boundary or "").strip() or None

    if boundary_val:
        esc = re.escape(boundary_val)
        part_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:part(?:\s+(\{{.*\}}))?\s*-->\s*$")
        end_re = re.compile(rf"^\s*<!--\s*bundle:{esc}:end\s*-->\s*$")

        raw_parts: list[tuple[dict[str, object], list[str]]] = []
        stripped_lines: list[str] = []
        in_part = False
        cur_meta: dict[str, object] = {}
        cur_lines: list[str] = []
        unframed_lines: list[str] = []
        found_markers = 0

        for line in norm_text.splitlines():
            m_part = part_re.match(line)
            if m_part:
                found_markers += 1
                if in_part:
                    raw_parts.append((cur_meta, cur_lines))
                else:
                    real_unframed = [ln for ln in unframed_lines if not SECTION_HEADER_RE.match(ln.strip())]
                    while real_unframed and not real_unframed[0].strip():
                        real_unframed.pop(0)
                    while real_unframed and not real_unframed[-1].strip():
                        real_unframed.pop()
                    if any(x.strip() for x in real_unframed):
                        raw_parts.append((_infer_section_meta(None, is_sections=True, is_preamble=(len(raw_parts) == 0)), real_unframed))
                unframed_lines = []
                in_part = True
                cur_lines = []
                cur_meta = {}
                raw_json = m_part.group(1)
                if raw_json:
                    try:
                        parsed = json.loads(raw_json)
                        if isinstance(parsed, dict):
                            cur_meta = parsed
                    except ValueError:
                        cur_meta = {"kind": "part"}
                continue

            if end_re.match(line):
                found_markers += 1
                if in_part:
                    raw_parts.append((cur_meta, cur_lines))
                    in_part = False
                    cur_meta = {}
                    cur_lines = []
                continue

            stripped_lines.append(line)
            if in_part:
                cur_lines.append(line)
            else:
                unframed_lines.append(line)

        if in_part:
            raw_parts.append((cur_meta, cur_lines))
        else:
            real_unframed = [ln for ln in unframed_lines if not SECTION_HEADER_RE.match(ln.strip())]
            while real_unframed and not real_unframed[0].strip():
                real_unframed.pop(0)
            while real_unframed and not real_unframed[-1].strip():
                real_unframed.pop()
            if any(x.strip() for x in real_unframed):
                raw_parts.append((_infer_section_meta(None, is_sections=True, is_preamble=(len(raw_parts) == 0)), real_unframed))

        if found_markers > 0:
            clean_body = "\n".join(stripped_lines)
            clean_body = re.sub(r"\n{3,}", "\n\n", clean_body).strip("\n")
            plan = _build_bundle_plan("boundary", boundary_val, raw_parts)
            if clean_body:
                plan = reconcile_bundle_plan(plan, clean_body + "\n")
            return clean_body, plan

    return _split_section_fallback(norm_text, boundary_val)


def refresh_bundle_plan_meta(sdir: Path, bundle_path: Path) -> None:
    if not bundle_path.is_file():
        return
    text = bundle_path.read_text(encoding="utf-8", errors="replace")
    _, body = parse_stdin_preamble(text)
    meta_hdrs = _parse_meta_header_items(sdir)
    boundary = get_bundle_boundary(meta_hdrs)
    _, plan = parse_bundle_fragments(body, boundary=boundary)
    plan = reconcile_bundle_plan(plan, text)
    update_session_meta(sdir, bundle_plan=plan)


def _format_tok_pair(gpt_cnt: int, claude_cnt: int) -> str:
    lo = min(gpt_cnt, claude_cnt)
    hi = max(gpt_cnt, claude_cnt)
    return f"~{_human_tok(lo)}–{_human_tok(hi)} tok" if lo != hi else f"~{_human_tok(lo)} tok"


def _new_tree_node(name: str, chain: list[str]) -> dict[str, object]:
    return {
        "name": name,
        "chain": list(chain),
        "items": [],
        "children_by_name": {},
        "direct_parts": [],
        "total_count": 0,
        "lines": 0,
        "chars": 0,
        "bytes": 0,
        "gpt": 0,
        "claude": 0,
        "share_pct": 0.0,
        "kinds": [],
        "rc_errors": 0,
    }


def _add_part_to_node(node: dict[str, object], entry: dict[str, object]) -> None:
    node["total_count"] = int(node["total_count"]) + 1
    node["lines"] = int(node["lines"]) + int(entry.get("lines") or 0)
    node["chars"] = int(node["chars"]) + _part_chars(entry)
    node["bytes"] = int(node["bytes"]) + int(entry.get("bytes") or 0)
    node["gpt"] = int(node["gpt"]) + int(entry.get("gpt") or 0)
    node["claude"] = int(node["claude"]) + int(entry.get("claude") or 0)
    node["share_pct"] = round(float(node["share_pct"]) + float(entry.get("share_pct") or 0.0), 1)
    kind = str(entry.get("kind") or "part")
    kinds = node["kinds"]
    if isinstance(kinds, list) and kind not in kinds:
        kinds.append(kind)
    rc_val = entry.get("rc")
    if isinstance(rc_val, int) and rc_val != 0:
        node["rc_errors"] = int(node["rc_errors"]) + 1


def _build_bundle_tree(parts: list[dict[str, object]]) -> list[tuple[str, dict[str, object]]]:
    root_items: list[tuple[str, dict[str, object]]] = []
    root_nodes: dict[str, dict[str, object]] = {}
    for entry in parts:
        chain = _resolve_part_chain(entry)
        if not chain:
            root_items.append(("part", entry))
            continue
        cur_items = root_items
        cur_map = root_nodes
        cur_node: dict[str, object] | None = None
        for depth_idx, seg in enumerate(chain):
            if seg not in cur_map:
                new_n = _new_tree_node(seg, chain[: depth_idx + 1])
                cur_map[seg] = new_n
                cur_items.append(("node", new_n))
            cur_node = cur_map[seg]
            _add_part_to_node(cur_node, entry)
            cur_items = cur_node["items"]  # type: ignore[assignment]
            cur_map = cur_node["children_by_name"]  # type: ignore[assignment]
        if cur_node is not None:
            cur_node["items"].append(("part", entry))  # type: ignore[union-attr]
            cur_node["direct_parts"].append(entry)  # type: ignore[union-attr]
    return root_items


def _node_display_kind(node: dict[str, object]) -> str:
    kinds = node.get("kinds") or []
    return str(kinds[0]) if isinstance(kinds, list) and len(kinds) == 1 else "bundle"


def _tree_connector(ancestors_more: list[bool], is_last: bool) -> str:
    utf8_ok = _supports_utf8()
    bar = "│  " if utf8_ok else "|  "
    branch = ("└─ " if is_last else "├─ ") if utf8_ok else ("`- " if is_last else "|- ")
    return "".join(bar if more else "   " for more in ancestors_more) + branch


def _make_table_row(
    *,
    kind: str,
    desc: str,
    lines_cnt: int,
    chars_cnt: int,
    gpt_cnt: int,
    claude_cnt: int,
    share_pct: float,
    tree_prefix: str = "",
    num: int | None = None,
) -> dict[str, object]:
    return {
        "pct_str": f"{share_pct:.1f}%",
        "chars_str": _human_chars(chars_cnt, short=True),
        "lines_str": f"{lines_cnt}L",
        "tok_str": _format_tok_pair(gpt_cnt, claude_cnt),
        "kind": kind,
        "tree_prefix": tree_prefix,
        "num": num,
        "desc": desc,
    }


def _part_extras_suffix(p: dict[str, object], *, include_ms: bool = True) -> str:
    extras: list[str] = []
    rc_val = p.get("rc")
    if isinstance(rc_val, int) and (include_ms or rc_val != 0):
        extras.append(f"rc={rc_val}")
    if include_ms and "ms" in p:
        extras.append(f"{p['ms']}ms")
    return f" ({', '.join(extras)})" if extras else ""


def _collect_hierarchy_rows(plan: dict[str, object], *, details: bool) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    hdr = plan.get("header")
    if isinstance(hdr, dict) and (_part_chars(hdr) > 0 or int(hdr.get("lines") or 0) > 0):
        rows.append(
            _make_table_row(
                kind="header",
                desc=str(hdr.get("name") or "Headers & spacing"),
                lines_cnt=int(hdr.get("lines") or 0),
                chars_cnt=_part_chars(hdr),
                gpt_cnt=int(hdr.get("gpt") or 0),
                claude_cnt=int(hdr.get("claude") or 0),
                share_pct=float(hdr.get("share_pct") or 0.0),
            )
        )
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    root_items = _build_bundle_tree(parts)

    def _emit_part(p: dict[str, object], parent_name: str, ancestors_more: list[bool], is_last: bool | None) -> None:
        t_pfx = _tree_connector(ancestors_more, is_last) if is_last is not None else ""
        raw_lbl = _part_label(p)
        lbl = _child_rel_label(parent_name, raw_lbl) if parent_name else raw_lbl
        lbl += _part_extras_suffix(p, include_ms=details)
        p_idx = int(p["index"]) if (details and isinstance(p.get("index"), int)) else None
        rows.append(
            _make_table_row(
                kind=str(p.get("kind") or "part"),
                desc=lbl,
                lines_cnt=int(p.get("lines") or 0),
                chars_cnt=_part_chars(p),
                gpt_cnt=int(p.get("gpt") or 0),
                claude_cnt=int(p.get("claude") or 0),
                share_pct=float(p.get("share_pct") or 0.0),
                tree_prefix=t_pfx,
                num=p_idx,
            )
        )

    def _emit_node(node: dict[str, object], ancestors_more: list[bool], is_last: bool | None) -> None:
        t_pfx = _tree_connector(ancestors_more, is_last) if is_last is not None else ""
        has_children = bool(node.get("children_by_name"))
        direct_parts: list[dict[str, object]] = list(node.get("direct_parts") or [])  # type: ignore[arg-type]
        if not has_children and len(direct_parts) == 1:
            p = direct_parts[0]
            lbl = _join_chain_label([str(node["name"])], _part_label(p)) + _part_extras_suffix(p, include_ms=details)
            p_idx = int(p["index"]) if (details and isinstance(p.get("index"), int)) else None
            rows.append(
                _make_table_row(
                    kind=str(p.get("kind") or "part"),
                    desc=lbl,
                    lines_cnt=int(p.get("lines") or 0),
                    chars_cnt=_part_chars(p),
                    gpt_cnt=int(p.get("gpt") or 0),
                    claude_cnt=int(p.get("claude") or 0),
                    share_pct=float(p.get("share_pct") or 0.0),
                    tree_prefix=t_pfx,
                    num=p_idx,
                )
            )
            return
        cnt = int(node.get("total_count") or 0)
        rc_errs = int(node.get("rc_errors") or 0)
        lbl = f"{node['name']} ({cnt})" + (f" ({rc_errs} rc!=0)" if rc_errs else "")
        rows.append(
            _make_table_row(
                kind=_node_display_kind(node),
                desc=lbl,
                lines_cnt=int(node.get("lines") or 0),
                chars_cnt=int(node.get("chars") or 0),
                gpt_cnt=int(node.get("gpt") or 0),
                claude_cnt=int(node.get("claude") or 0),
                share_pct=float(node.get("share_pct") or 0.0),
                tree_prefix=t_pfx,
            )
        )
        if details or has_children:
            child_items: list[tuple[str, dict[str, object]]] = list(node.get("items") or [])  # type: ignore[arg-type]
            next_anc = ([*ancestors_more, not is_last] if is_last is not None else [])
            for c_idx, (c_type, c_obj) in enumerate(child_items):
                c_last = c_idx == len(child_items) - 1
                if c_type == "node":
                    _emit_node(c_obj, next_anc, c_last)
                else:
                    _emit_part(c_obj, str(node["name"]), next_anc, c_last)

    for it_type, it_obj in root_items:
        if it_type == "node":
            _emit_node(it_obj, [], None)
        else:
            _emit_part(it_obj, "", [], None)
    return rows


def _render_bundle_table(rows: list[dict[str, object]], max_width: int, indent: str = "  ") -> list[str]:
    if not rows:
        return []
    w_pct = max(len(str(r["pct_str"])) for r in rows)
    w_ch = max(len(str(r["chars_str"])) for r in rows)
    w_ln = max(len(str(r["lines_str"])) for r in rows)
    w_tok = max(len(str(r["tok_str"])) for r in rows)
    w_kind = max(len(f"[{r['kind']}]") for r in rows)
    nums = [r["num"] for r in rows if r.get("num") is not None]
    num_w = max((len(f"{n}.") for n in nums), default=0)

    out: list[str] = []
    for r in rows:
        kind_col = f"[{r['kind']}]".ljust(w_kind)
        cols_prefix = (
            f"{indent}{str(r['pct_str']).rjust(w_pct)} "
            f"{str(r['chars_str']).rjust(w_ch)} "
            f"{str(r['lines_str']).rjust(w_ln)} "
            f"{str(r['tok_str']).rjust(w_tok)}  "
            f"{kind_col}  "
        )
        t_pfx = str(r.get("tree_prefix") or "")
        n_val = r.get("num")
        n_pfx = (f"{n_val}.".rjust(num_w) + " ") if n_val is not None else ""
        full_pfx = f"{cols_prefix}{t_pfx}{n_pfx}"
        sub_indent = " " * display_width(full_pfx)
        avail = max(16, max_width - display_width(full_pfx))
        desc = str(r.get("desc") or "")
        wrapped = textwrap.wrap(desc, width=avail, break_long_words=True, break_on_hyphens=False) or [desc]
        out.append(full_pfx + wrapped[0])
        for cont in wrapped[1:]:
            out.append(sub_indent + cont)
    return out


def format_bundle_summary_lines(plan: dict[str, object], max_width: int = 120) -> list[str]:
    return _render_bundle_table(_collect_hierarchy_rows(plan, details=False), max_width=max_width)


def format_bundle_parts_lines(plan: dict[str, object], max_width: int = 120) -> list[str]:
    return _render_bundle_table(_collect_hierarchy_rows(plan, details=True), max_width=max_width)


def format_bundle_group_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    if not parts:
        return []
    groups = group_bundle_parts(parts)
    items: list[tuple[str, str]] = []
    for g in groups:
        kind = str(g.get("kind") or "part")
        chain = [str(x) for x in (g.get("chain") or []) if str(x)]
        grp = str(g.get("group") or "")
        cnt = int(g.get("count") or 0)
        names = list(g.get("names") or [])
        if chain:
            if cnt == 1 and names:
                lbl = _join_chain_label(chain, str(names[0]))
            elif cnt > 1:
                lbl = f"{grp} ({cnt})"
            else:
                lbl = grp
        elif cnt == 1 and names:
            lbl = str(names[0])
        else:
            lbl = f"{cnt} part" + ("s" if cnt != 1 else "")
        lines_cnt = int(g.get("lines") or 0)
        chars_cnt = int(g.get("chars") if g.get("chars") is not None else (g.get("bytes") or 0))
        gpt_cnt = int(g.get("gpt") or 0)
        claude_cnt = int(g.get("claude") or 0)
        share = float(g.get("share_pct") or 0.0)
        err_cnt = int(g.get("rc_errors") or 0)
        meta = f"{lines_cnt}L · {_human_chars(chars_cnt, short=True)} · {_format_tok_pair(gpt_cnt, claude_cnt)} ({share:.1f}%)"
        if err_cnt:
            meta += f" · {err_cnt} rc!=0"
        items.append((kind, f"{lbl}  [{meta}]"))
    return items


def format_bundle_part_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    parts = [p for p in (plan.get("parts") or []) if isinstance(p, dict)]
    items: list[tuple[str, str]] = []
    for p in parts:
        kind = str(p.get("kind") or "part")
        chain = _resolve_part_chain(p)
        lbl = _join_chain_label(chain, _part_label(p))
        lines_cnt = int(p.get("lines") or 0)
        chars_cnt = _part_chars(p)
        gpt_cnt = int(p.get("gpt") or 0)
        claude_cnt = int(p.get("claude") or 0)
        share = float(p.get("share_pct") or 0.0)
        extras: list[str] = [f"{lines_cnt}L", _human_chars(chars_cnt, short=True), f"{_format_tok_pair(gpt_cnt, claude_cnt)} ({share:.1f}%)"]
        if "rc" in p:
            extras.append(f"rc={p['rc']}")
        if "ms" in p:
            extras.append(f"{p['ms']}ms")
        items.append((kind, f"{lbl}  [{' · '.join(extras)}]"))
    return items


def format_bundle_warning_items(plan: dict[str, object]) -> list[tuple[str, str]]:
    warns = [w for w in (plan.get("warnings") or []) if isinstance(w, dict)]
    return [
        (str(w.get("code") or "warn"), str(w.get("message") or ""))
        for w in warns
        if w.get("message")
    ]


def _enrich_bundle_plan(plan: dict[str, object], full_text: str | None = None) -> dict[str, object]:
    out = dict(plan)
    parts = [dict(p) for p in (out.get("parts") or []) if isinstance(p, dict)]
    for part in parts:
        if part.get("chars") is None:
            part["chars"] = int(part.get("bytes") or 0)
    out["parts"] = parts
    if out.get("chars") is None:
        out["chars"] = int(out.get("bytes") or sum(_part_chars(p) for p in parts))
    if full_text is not None and "header" not in out:
        out = reconcile_bundle_plan(out, full_text)
    if "warnings" not in out:
        out["warnings"] = analyze_bundle_warnings(parts, total_gpt=int(out.get("gpt") or 0))
    return out


def load_session_bundle_plan(sdir: Path | None, bundle_path: Path | None = None) -> dict[str, object] | None:
    meta = read_session_meta(sdir) if sdir is not None else {}
    raw_plan = meta.get("bundle_plan")
    bpath = bundle_path if bundle_path is not None else (sdir / "0" if sdir is not None else None)
    btext = bpath.read_text(encoding="utf-8", errors="replace") if (bpath is not None and bpath.is_file()) else None
    if isinstance(raw_plan, dict) and "parts" in raw_plan and "warnings" in raw_plan:
        return _enrich_bundle_plan(raw_plan, full_text=btext)
    if btext is not None:
        _, body = parse_stdin_preamble(btext)
        meta_hdrs = _parse_meta_header_items(sdir) if sdir is not None else []
        boundary = get_bundle_boundary(meta_hdrs)
        _, parsed_plan = parse_bundle_fragments(body, boundary=boundary)
        if isinstance(raw_plan, dict) and raw_plan.get("protocol") == "boundary" and parsed_plan.get("protocol") != "boundary":
            return _enrich_bundle_plan(raw_plan, full_text=btext)
        return reconcile_bundle_plan(parsed_plan, btext)
    if isinstance(raw_plan, dict):
        return _enrich_bundle_plan(raw_plan)
    return None


def format_bundle_plan_text(
    plan: dict[str, object],
    *,
    full: bool = False,
    session: str | None = None,
) -> str:
    protocol = str(plan.get("protocol") or "empty")
    part_cnt = int(plan.get("part_count") or 0)
    lines_cnt = int(plan.get("lines") or 0)
    chars_cnt = int(plan.get("chars") if plan.get("chars") is not None else (plan.get("bytes") or 0))
    gpt_cnt = int(plan.get("gpt") or 0)
    claude_cnt = int(plan.get("claude") or 0)
    hdr_target = session if session else "stdin"
    out_lines: list[str] = [
        f"Bundle Plan ({hdr_target}, protocol: {protocol}):",
        f"Total: {lines_cnt} line{'s' if lines_cnt != 1 else ''} · {_human_chars(chars_cnt)} · {_format_tok_pair(gpt_cnt, claude_cnt)} ({part_cnt} part{'s' if part_cnt != 1 else ''})",
    ]
    sum_lines = format_bundle_summary_lines(plan, max_width=120)
    if sum_lines:
        out_lines.append("")
        out_lines.append(f"Summary ({part_cnt} part{'s' if part_cnt != 1 else ''}):")
        out_lines.extend(sum_lines)
    if full:
        part_lines = format_bundle_parts_lines(plan, max_width=120)
        if part_lines:
            out_lines.append("")
            out_lines.append(f"Parts ({part_cnt}):")
            out_lines.extend(part_lines)
    warn_items = format_bundle_warning_items(plan)
    if warn_items:
        out_lines.append("")
        out_lines.append(f"Warnings ({len(warn_items)}):")
        out_lines.extend(_wrap_labeled_items(warn_items, 120, indent="  "))
    return "\n".join(out_lines) + "\n"


def cmd_bundle_plan(argv: list[str], stdin_text: str | None = None) -> int:
    prog = prog_name()
    as_json = False
    full = False
    session_arg: str | None = None
    for a in argv:
        if a == "--json":
            as_json = True
        elif a == "--full":
            full = True
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: usage: {prog} --bundle-plan [<session>] [--json] [--full]")
        elif session_arg is None:
            session_arg = a
        else:
            raise SystemExit(f"{prog}: usage: {prog} --bundle-plan [<session>] [--json] [--full]")

    plan: dict[str, object] | None = None
    if session_arg is not None:
        sess = session_arg.split("/", 1)[0] if session_arg.endswith("/0") else session_arg
        if not re.fullmatch(r"[A-Za-z0-9._-]+", sess):
            raise SystemExit(f"{prog}: invalid session name: {session_arg!r}")
        sdir = BASE_DIR / sess
        if not sdir.is_dir():
            raise SystemExit(f"{prog}: session {sess!r} not found in {BASE_DIR}")
        plan = load_session_bundle_plan(sdir)
        if plan is None:
            raise SystemExit(f"{prog}: no bundle data found for session {sess!r}")
        session_arg = sess
    else:
        if stdin_text is None:
            if sys.stdin.isatty():
                sys.stderr.write(
                    f"{prog}: --bundle-plan expects a session name or a bundle on stdin "
                    f"(e.g. '{prog} --bundle-plan s1' or 'cat bundle.txt | {prog} --bundle-plan')\n"
                )
                return 2
            stdin_text = sys.stdin.read()
        stdin_headers, raw_body = parse_stdin_preamble(stdin_text)
        boundary = get_bundle_boundary(stdin_headers)
        _, plan = parse_bundle_fragments(raw_body, boundary=boundary)

    if as_json:
        payload = dict(plan)
        if session_arg is not None:
            payload["session"] = session_arg
        sys.stdout.write(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
    else:
        sys.stdout.write(format_bundle_plan_text(plan, full=full, session=session_arg))
    sys.stdout.flush()
    return 0


def ensure_base() -> Path:
    BASE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        BASE_DIR.chmod(0o700)
    except OSError:
        pass
    return BASE_DIR


def next_session_name(base: Path) -> str:
    used = set()
    for p in base.iterdir():
        m = re.fullmatch(r"s(\d+)", p.name)
        if m:
            used.add(int(m.group(1)))
    n = 1
    while n in used:
        n += 1
    return f"s{n}"


def start_session(name: str | None = None, force: bool = False, sandbox_mode: str | None = None) -> Path:
    base = ensure_base()
    _warn_if_state_oversized(base)
    if not name:
        name = next_session_name(base)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        raise SystemExit(f"{prog_name()}: invalid session name: {name!r}")
    sdir = base / name
    if sdir.exists():
        if not force:
            if not sys.stdin.isatty():
                raise SystemExit(f"{prog_name()}: session {sdir} already exists (use --force to overwrite)")
            if sys.stdout.isatty() and not no_clipboard():
                sess_hdr = format_session_header_lines(
                    label=name, sdir=sdir, sandbox_mode=sandbox_mode
                )
                ok = prompt_yes_no_box(
                    "SESSION ALREADY EXISTS",
                    [*sess_hdr, "", f"Directory: {sdir}"],
                    f"Overwrite session {name}?",
                    default_yes=False,
                    yes_status=f"✓ Overwriting session {name}.",
                    no_status=f"✗ Aborted overwriting session {name}.",
                )
                if not ok:
                    raise SystemExit(f"{prog_name()}: aborted")
            else:
                sys.stderr.write(f"Session {sdir} already exists. Overwrite? [y/N] ")
                sys.stderr.flush()
                ans = sys.stdin.readline().strip().lower()
                if ans not in ("y", "yes"):
                    raise SystemExit(f"{prog_name()}: aborted")
        shutil.rmtree(sdir)
    sdir.mkdir(mode=0o700, parents=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_mode)
    return sdir


def parse_ref(ref: str, allow_fix_step: bool) -> tuple[str, str]:
    pattern = r"^([A-Za-z0-9._-]+)/(\d+(?:_\d+)?)$" if allow_fix_step else r"^([A-Za-z0-9._-]+)/(\d+)$"
    m = re.fullmatch(pattern, ref.strip())
    if not m:
        kind = "<session>/<step> (e.g. s1/2 or s1/2_1)" if allow_fix_step else "<session>/<step> (e.g. s1/1)"
        raise SystemExit(f"{prog_name()}: invalid block reference {ref!r}; expected {kind}")
    return m.group(1), m.group(2)


def next_free_step(sdir: Path, min_step: int = 1) -> int:
    used: set[int] = set()
    if sdir.is_dir():
        for p in sdir.iterdir():
            if p.is_dir():
                m = re.fullmatch(r"(\d+)(?:_\d+)?", p.name)
                if m:
                    used.add(int(m.group(1)))
    candidate = max(min_step, (max(used) + 1) if used else 1)
    while candidate in used:
        candidate += 1
    return candidate


def _rewrite_script_step_header(script_text: str, old_label: str, new_label: str) -> str:
    lines = script_text.splitlines(keepends=True)
    if not lines:
        return script_text
    pat = re.compile(
        rf"^(\s*#\s*(?:run_block|Block|Next-Block)\s*:\s*){re.escape(old_label)}(\s*)$"
    )
    for idx in range(min(3, len(lines))):
        line_body = lines[idx].rstrip("\r\n")
        eol = lines[idx][len(line_body) :]
        m = pat.match(line_body)
        if m:
            lines[idx] = f"{m.group(1)}{new_label}{m.group(2)}{eol}"
            break
    return "".join(lines)


def next_fix_step(step: str, sdir: Path | None = None) -> str:
    base = step.split("_", 1)[0]
    min_next = 1
    if "_" in step:
        _, sub = step.split("_", 1)
        if sub.isdigit():
            min_next = int(sub) + 1
    if sdir is not None and sdir.is_dir():
        max_n = 0
        pat = re.compile(rf"^{re.escape(base)}_(\d+)$")
        for p in sdir.iterdir():
            m = pat.match(p.name)
            if m and p.is_dir():
                max_n = max(max_n, int(m.group(1)))
        return f"{base}_{max(min_next, max_n + 1)}"
    return f"{base}_{min_next}"


_CMP_OP_SYMBOLS: dict[type[ast.cmpop], str] = {
    ast.Eq: "==",
    ast.NotEq: "!=",
    ast.Lt: "<",
    ast.LtE: "<=",
    ast.Gt: ">",
    ast.GtE: ">=",
    ast.Is: "is",
    ast.IsNot: "is not",
    ast.In: "in",
    ast.NotIn: "not in",
}


def _short_repr(val: object, limit: int = 80) -> str:
    r = repr(val)
    if len(r) > limit:
        return r[: limit - 3] + "..."
    return r


def _format_fix_exception(
    exc: BaseException, fix_code: str, fix_path: Path, ns: dict[str, object]
) -> str:
    lineno: int | None = getattr(exc, "lineno", None)
    tb = exc.__traceback__
    while tb is not None:
        if tb.tb_frame.f_code.co_filename == str(fix_path):
            lineno = tb.tb_lineno
        tb = tb.tb_next

    lines = fix_code.splitlines()
    stmt_node: ast.stmt | None = None
    if lineno is not None:
        try:
            tree = ast.parse(fix_code)
            for node in ast.walk(tree):
                if isinstance(node, ast.stmt) and hasattr(node, "lineno"):
                    end_ln = getattr(node, "end_lineno", node.lineno) or node.lineno
                    if node.lineno <= lineno <= end_ln:
                        if stmt_node is None or node.lineno >= stmt_node.lineno:
                            stmt_node = node
        except Exception:
            stmt_node = None

    stmt_str = ""
    if stmt_node is not None:
        seg = ast.get_source_segment(fix_code, stmt_node)
        if seg:
            stmt_str = " ".join(l.strip() for l in seg.splitlines() if l.strip())
    if not stmt_str and lineno is not None and 1 <= lineno <= len(lines):
        stmt_str = lines[lineno - 1].strip()

    actual_part = ""
    if (
        isinstance(exc, AssertionError)
        and isinstance(stmt_node, ast.Assert)
        and isinstance(stmt_node.test, ast.Compare)
        and len(stmt_node.test.ops) == 1
        and len(stmt_node.test.comparators) == 1
    ):
        op_sym = _CMP_OP_SYMBOLS.get(type(stmt_node.test.ops[0]))
        if op_sym:
            try:
                left_expr = ast.Expression(body=stmt_node.test.left)
                right_expr = ast.Expression(body=stmt_node.test.comparators[0])
                ast.fix_missing_locations(left_expr)
                ast.fix_missing_locations(right_expr)
                left_val = eval(compile(left_expr, "<fix_eval>", "eval"), ns)
                right_val = eval(compile(right_expr, "<fix_eval>", "eval"), ns)
                actual_part = f" (actual: {_short_repr(left_val)} {op_sym} {_short_repr(right_val)})"
            except Exception:
                actual_part = ""

    exc_name = type(exc).__name__
    exc_msg = str(exc).strip()
    if lineno is not None and stmt_str:
        loc_str = f"at line {lineno}: {stmt_str}{actual_part}"
        if exc_msg:
            return f"fix raised {exc_name}: {exc_msg} ({loc_str})"
        return f"fix raised {exc_name} {loc_str}"
    if exc_msg:
        return f"fix raised {exc_name}: {exc_msg}"
    return f"fix raised {exc_name}"


def _find_fix_chain_scripts(sdir: Path, base_step: str) -> list[tuple[str, Path]]:
    chain: list[tuple[str, Path]] = []
    base_script = _find_step_script(sdir, base_step)
    if base_script.is_file():
        chain.append((base_step, base_script))
    if sdir.is_dir():
        fix_items: list[tuple[int, str, Path]] = []
        pat = re.compile(rf"^{re.escape(base_step)}_(\d+)$")
        for d in sdir.iterdir():
            m = pat.match(d.name)
            if m and d.is_dir():
                sub_idx = int(m.group(1))
                step_name = f"{base_step}_{sub_idx}"
                sp = _find_step_script(sdir, step_name)
                if sp.is_file():
                    fix_items.append((sub_idx, step_name, sp))
        for _, step_name, p in sorted(fix_items, key=lambda x: x[0]):
            chain.append((step_name, p))
    return chain


def _consecutive_failed_fixes(sdir: Path, base_step: str) -> int:
    if not sdir.is_dir():
        return 0
    indices: set[int] = set()
    pat = re.compile(rf"^{re.escape(base_step)}_(\d+)$")
    for d in sdir.iterdir():
        m = pat.match(d.name)
        if m and d.is_dir():
            indices.add(int(m.group(1)))
    failures = 0
    for idx in sorted(indices):
        stem = f"{base_step}_{idx}"
        st = _step_status(sdir, stem)
        if st == "ABORTED":
            continue
        if st == "END":
            failures = 0
        else:
            failures += 1
    return failures


def write_private(path: Path, content: str, overwrite: bool = False) -> None:
    flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if overwrite else os.O_EXCL)
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


_EMBEDDED_PY_HEREDOC_RE = re.compile(r"\bpython3?(?:\s+[^\n]*?)?<<-?\s*['\"]?([A-Za-z0-9_]+)['\"]?")
_STDIN_TB_LINE_RE = re.compile(r'File "<stdin>", line (\d+)(?:, in ([^\n]+))?')


def _extract_python_heredoc_bodies(script_text: str) -> list[list[str]]:
    bodies: list[list[str]] = []
    eof_token: str | None = None
    strip_tabs = False
    cur_lines: list[str] = []
    for raw in script_text.splitlines():
        if eof_token is not None:
            cmp_line = raw.lstrip("\t") if strip_tabs else raw
            if cmp_line.strip() == eof_token:
                bodies.append(cur_lines)
                eof_token = None
                strip_tabs = False
                cur_lines = []
            else:
                cur_lines.append(cmp_line if strip_tabs else raw)
            continue
        m = _EMBEDDED_PY_HEREDOC_RE.search(raw)
        if m:
            eof_token = m.group(1)
            strip_tabs = "<<-" in raw
            cur_lines = []
    if eof_token is not None and cur_lines:
        bodies.append(cur_lines)
    return bodies


def _resolve_python_stdin_tracebacks(label: str, script_text: str, output_text: str) -> list[str]:
    matches = _STDIN_TB_LINE_RE.findall(output_text)
    if not matches:
        return []
    heredocs = _extract_python_heredoc_bodies(script_text)
    if not heredocs:
        return []
    resolved: list[str] = []
    seen: set[tuple[int, str]] = set()
    for raw_ln, raw_func in matches:
        try:
            lineno = int(raw_ln)
        except ValueError:
            continue
        if lineno < 1:
            continue
        func_name = (raw_func or "").strip()
        chosen_body: list[str] | None = None
        if len(heredocs) == 1:
            if lineno <= len(heredocs[0]):
                chosen_body = heredocs[0]
        else:
            if func_name and func_name != "<module>":
                def_pat = re.compile(rf"^\s*(?:async\s+)?def\s+{re.escape(func_name)}\b")
                for body in reversed(heredocs):
                    if lineno <= len(body) and any(def_pat.match(ln) for ln in body):
                        chosen_body = body
                        break
            if chosen_body is None:
                for body in reversed(heredocs):
                    if lineno <= len(body):
                        chosen_body = body
                        break
        if chosen_body is None:
            continue
        src_line = chosen_body[lineno - 1].strip()
        if not src_line:
            continue
        key = (lineno, src_line)
        if key in seen:
            continue
        seen.add(key)
        resolved.append(f"[{label}] <stdin> line {lineno}: {src_line}")
    return resolved


def not_run_exit(
    label: str,
    sdir: Path,
    step_name: str,
    out_path: Path,
    msg: str,
    rc: int = 2,
    headless: bool = False,
    fix_target: str | None = None,
) -> int:
    step_dir = _step_dir(sdir, step_name)
    step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    line = msg if msg.endswith("\n") else msg + "\n"
    clean_msg = msg.strip()
    prefix = f"[{label}] NOT RUN:"
    detail = clean_msg[len(prefix):].strip() if clean_msg.startswith(prefix) else clean_msg
    detail_lines = detail.splitlines() or [detail]
    err_target = step_dir / "error" if out_path.exists() else out_path
    try:
        write_private(err_target, line, overwrite=True)
    except Exception:
        pass
    is_headless = headless or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    if is_headless:
        sys.stdout.write(line)
        sys.stdout.flush()
        return rc
    body_lines: list[str] = []
    if fix_target:
        body_lines.append(f"Target: {fix_target} -> {label}")
    body_lines.append(f"Reason: {detail_lines[0]}")
    stop_pat = re.compile(rf"^(?:\[{re.escape(label)}\]\s*)?STOP --fix:\s*(.*)$")
    for dline in detail_lines[1:]:
        m_stop = stop_pat.match(dline.strip())
        if m_stop:
            body_lines.append(f"Guard: {m_stop.group(1).strip()}")
        else:
            body_lines.append(f"  {dline}")
    body_lines.append(f"Output: {err_target}")
    can_prompt_clip = (
        not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(err_target) is not None
    )
    if can_prompt_clip:
        offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines, sdir=sdir)
    else:
        full_body = build_box_body_lines(
            err_target, rc=rc, stats=stats_line(err_target), extra_lines=body_lines, label=label, sdir=sdir
        )
        sys.stdout.write(format_info_box("NOT RUN", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines, sdir=sdir)
    return rc


class _ProgressLineFilter:
    def __init__(
        self,
        step_map: dict[int, dict[str, object]],
        total_steps: int,
        marker_prefix: str = "__RB_STEP__:",
        clock: object = None,
    ) -> None:
        self.step_map = step_map
        self.total_steps = total_steps
        self.marker_prefix = marker_prefix
        self.buf = ""
        self._marker_re = re.compile(rf"^{re.escape(marker_prefix)}(\d+)\r?$")
        self._clock = clock if callable(clock) else time.monotonic
        self.active_step: int | None = None
        self._active_started: float | None = None
        self.step_durations: dict[int, float] = {}
        self.step_order: list[int] = []

    def _format_step_banner(self, step_num: int) -> str:
        info = self.step_map.get(step_num)
        if not info:
            return ""
        tag = str(info.get("tag") or "")
        desc = str(info.get("desc") or "").replace("\n", " ").strip()
        prefix = f"[{step_num}/{self.total_steps}]"
        if tag:
            prefix = f"{prefix} [{tag}]"
        max_cols = max(40, _hr_width() - 4)
        avail = max(16, max_cols - len(prefix) - 1)
        if len(desc) > avail:
            desc = desc[: avail - 3] + "..."
        line = f"{prefix} {desc}".rstrip()
        arrow = "▸" if _supports_utf8() else ">"
        if _use_color():
            return f"\x1b[2;36m{arrow} {line}\x1b[0m\n"
        return f"{arrow} {line}\n"

    def _format_step_done(self, step_num: int, elapsed: float, failed: bool = False) -> str:
        if step_num not in self.step_map:
            return ""
        dur_str = format_duration(elapsed)
        mark = ("✗" if failed else "✓") if _supports_utf8() else ("x" if failed else "+")
        line = f"  {mark} [{step_num}/{self.total_steps}] ({dur_str})"
        if _use_color():
            col = "\x1b[2;31m" if failed else "\x1b[2;32m"
            return f"{col}{line}\x1b[0m\n"
        return f"{line}\n"

    def _start_step(self, step_num: int) -> str:
        now = float(self._clock())
        parts: list[str] = []
        if self.active_step is not None and self._active_started is not None:
            elapsed = max(0.0, now - self._active_started)
            self.step_durations[self.active_step] = elapsed
            done_line = self._format_step_done(self.active_step, elapsed)
            if done_line:
                parts.append(done_line)
        self.active_step = step_num
        self._active_started = now
        if step_num not in self.step_order:
            self.step_order.append(step_num)
        banner = self._format_step_banner(step_num)
        if banner:
            parts.append(banner)
        return "".join(parts)

    def feed_events(self, text: str) -> list[tuple[str, str]]:
        self.buf += text
        events: list[tuple[str, str]] = []
        while "\n" in self.buf:
            line, rest = self.buf.split("\n", 1)
            self.buf = rest
            m = self._marker_re.match(line)
            if m:
                prog = self._start_step(int(m.group(1)))
                if prog:
                    events.append(("prog", prog))
            else:
                events.append(("out", line + "\n"))
        if self.buf:
            if not (
                self.marker_prefix.startswith(self.buf)
                or self.buf.startswith(self.marker_prefix)
            ):
                events.append(("out", self.buf))
                self.buf = ""
        return events

    def feed(self, text: str) -> tuple[str, str]:
        out_parts: list[str] = []
        prog_parts: list[str] = []
        for kind, chunk in self.feed_events(text):
            if kind == "prog":
                prog_parts.append(chunk)
            else:
                out_parts.append(chunk)
        return "".join(out_parts), "".join(prog_parts)

    def flush(self, rc: int = 0) -> tuple[str, str]:
        rem_out = ""
        prog_parts: list[str] = []
        if self.buf:
            rem = self.buf
            self.buf = ""
            m = self._marker_re.match(rem)
            if m:
                prog = self._start_step(int(m.group(1)))
                if prog:
                    prog_parts.append(prog)
            else:
                rem_out = rem
        if self.active_step is not None and self._active_started is not None:
            elapsed = max(0.0, float(self._clock()) - self._active_started)
            self.step_durations[self.active_step] = elapsed
            done_line = self._format_step_done(self.active_step, elapsed, failed=(rc != 0))
            if done_line:
                prog_parts.append(done_line)
            self._active_started = None
        return rem_out, "".join(prog_parts)

    def operation_timings(self) -> list[dict[str, object]]:
        timings: list[dict[str, object]] = []
        for step_num in self.step_order:
            if step_num not in self.step_durations:
                continue
            info = self.step_map.get(step_num) or {}
            timings.append(
                {
                    "step": step_num,
                    "tag": str(info.get("tag") or ""),
                    "desc": str(info.get("desc") or "").replace("\n", " ").strip(),
                    "duration_ms": int(round(self.step_durations[step_num] * 1000.0)),
                }
            )
        return timings


def _prepare_progress_script(
    script_text: str,
    step_dir: Path,
    step_lines: list[dict[str, object]],
    shell_bin: str,
    is_ps: bool,
    work_dir: Path,
) -> Path | None:
    if not step_lines:
        return None
    inst_text = instrument_script_for_progress(
        script_text, step_lines=step_lines, is_powershell=is_ps
    )
    if inst_text == script_text:
        return None
    ext = ".ps1" if is_ps else ".sh"
    fd, tmp_name = tempfile.mkstemp(prefix=".progress_", suffix=ext, dir=step_dir)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(inst_text)
        os.chmod(tmp_path, 0o600)
        if is_ps:
            ps_check = (
                "$err = $null; "
                "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
                "if ($err) { exit 1 }"
            )
            chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(tmp_path)]
        else:
            chk_cmd = [shell_bin, "-n", str(tmp_path)]
        chk = subprocess.run(
            chk_cmd,
            cwd=work_dir,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if chk.returncode != 0:
            tmp_path.unlink(missing_ok=True)
            return None
        return tmp_path
    except Exception:
        tmp_path.unlink(missing_ok=True)
        return None


def _iter_child_streams(out_fd, err_fd):
    """Yield (is_err, text) chunks read concurrently from two child descriptors."""
    q: queue.Queue = queue.Queue()

    def _reader(fd, is_err):
        while True:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if not chunk:
                break
            q.put((is_err, chunk))
        q.put((is_err, None))

    threads = [
        threading.Thread(target=_reader, args=(fd, flag), daemon=True)
        for fd, flag in ((out_fd, False), (err_fd, True))
    ]
    for th in threads:
        th.start()
    pending = len(threads)
    while pending:
        is_err, chunk = q.get()
        if chunk is None:
            pending -= 1
            continue
        yield is_err, chunk.decode("utf-8", "replace")
    for th in threads:
        th.join()


def _validate_step_script_syntax(
    label: str,
    script_path: Path,
    out_path: Path,
    work_dir: Path,
    shell_bin: str,
    is_ps: bool,
    sdir: Path,
    headless: bool = False,
    footer_on_fail: str | None = None,
) -> int:
    if is_ps:
        ps_check = (
            "$err = $null; "
            "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
            "if ($err) { foreach ($e in $err) { [Console]::Error.WriteLine($e.ToString()) }; exit 1 }"
        )
        chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(script_path)]
    else:
        chk_cmd = [shell_bin, "-n", str(script_path)]
    chk = subprocess.run(
        chk_cmd,
        cwd=work_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if chk.returncode == 0:
        return 0
    start_line = f"[{label}] START\n\n"
    msg = chk.stdout or "syntax check failed\n"
    end_line = f"[{label}] END (syntax error, exit {chk.returncode})\n"
    if footer_on_fail:
        end_line += footer_on_fail if footer_on_fail.endswith("\n") else footer_on_fail + "\n"
    full_output = start_line + msg + end_line
    write_private(out_path, full_output, overwrite=True)
    if headless:
        sys.stdout.write(full_output)
        sys.stdout.flush()
        return chk.returncode
    err_lines = msg.rstrip("\n").splitlines() or ["syntax check failed"]
    box_lines = [
        f"Exit: {chk.returncode}",
        f"Script: {script_path}",
        f"Output: {out_path}",
        f"Error: {err_lines[0]}",
        *(f"  {eline}" for eline in err_lines[1:]),
    ]
    can_prompt_clip = (
        not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(out_path) is not None
    )
    if can_prompt_clip:
        offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines, sdir=sdir)
    else:
        full_body = build_box_body_lines(
            out_path, rc=chk.returncode, stats=stats_line(out_path), extra_lines=box_lines, label=label, sdir=sdir
        )
        sys.stdout.write(format_info_box("SYNTAX ERROR", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines, sdir=sdir)
    return chk.returncode


def run_script(
    label: str,
    script_path: Path,
    out_path: Path,
    header_lines: list[str] | None = None,
    cleanup_on_abort: list[Path] | None = None,
    auto_yes: bool = False,
    sandbox_override: str | None = None,
    footer_on_fail: str | None = None,
    renumbered_from: str | None = None,
) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    step_dir = script_path.parent
    sdir = step_dir.parent
    work_dir = get_work_dir(sdir)
    sandbox_mode = get_sandbox_mode(sdir, override=sandbox_override)
    shell_bin, _ = get_setting("shell")
    is_ps = _is_powershell(shell_bin)
    script_text = script_path.read_text(encoding="utf-8")
    exec_cmd = (
        [shell_bin, "-NoProfile", "-File", str(script_path)]
        if is_ps
        else [shell_bin, str(script_path)]
    )

    rc_syn = _validate_step_script_syntax(
        label,
        script_path,
        out_path,
        work_dir,
        shell_bin,
        is_ps,
        sdir,
        headless=headless,
        footer_on_fail=footer_on_fail,
    )
    if rc_syn != 0:
        return rc_syn

    aborted_marker = step_dir / "aborted"
    summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
    summary_obj["sandbox"] = sandbox_mode
    approved, abort_reason = confirm_execution(
        label, script_text, summary=summary_obj, script_path=script_path, auto_yes=headless
    )
    if not approved:
        write_private(aborted_marker, "aborted\n", overwrite=True)
        if abort_reason == "USER_ABORTED":
            return 130
        reason_str = abort_reason or f"aborted by user (re-run with: {prog_name()} --retry {label})"
        return not_run_exit(
            label, sdir, step_dir.name, out_path, f"[{label}] NOT RUN: {reason_str}", rc=130, headless=headless
        )
    aborted_marker.unlink(missing_ok=True)

    if script_path.is_file():
        updated_text = script_path.read_text(encoding="utf-8")
        if updated_text != script_text:
            script_text = updated_text
            rc_syn = _validate_step_script_syntax(
                label,
                script_path,
                out_path,
                work_dir,
                shell_bin,
                is_ps,
                sdir,
                headless=headless,
                footer_on_fail=footer_on_fail,
            )
            if rc_syn != 0:
                return rc_syn
            summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
            summary_obj["sandbox"] = sandbox_mode

    start_line = f"[{label}] START\n"
    log_chunks: list[str] = [start_line]
    err_chunks: list[str] = []

    def _emit(text: str, is_err: bool) -> None:
        if is_err:
            err_chunks.append(text)
            log_chunks.append(text)
            sys.stdout.write(text)
            sys.stdout.flush()
            return
        if progress_filter is not None:
            events = progress_filter.feed_events(text)
            for kind, chunk in events:
                if kind == "out":
                    log_chunks.append(chunk)
                sys.stdout.write(chunk)
            if events:
                sys.stdout.flush()
        else:
            log_chunks.append(text)
            sys.stdout.write(text)
            sys.stdout.flush()
    for h in header_lines or []:
        log_chunks.append(h)
    log_chunks.append("\n")
    if headless:
        sys.stdout.write("".join(log_chunks))
    elif header_lines:
        sys.stdout.write("".join(header_lines) + "\n")
    sys.stdout.flush()

    tty_in = None
    master_fd = None
    slave_fd = None
    err_master_fd = None
    err_slave_fd = None
    if HAS_PTY and sys.stdout.isatty() and not no_clipboard() and not headless:
        try:
            tty_in = open("/dev/tty", "rb", buffering=0)
            master_fd, slave_fd = pty.openpty()
            attrs = termios.tcgetattr(slave_fd)
            attrs[1] &= ~termios.ONLCR
            termios.tcsetattr(slave_fd, termios.TCSANOW, attrs)
            err_master_fd, err_slave_fd = pty.openpty()
            termios.tcsetattr(err_slave_fd, termios.TCSANOW, attrs)
        except OSError:
            if tty_in is not None:
                tty_in.close()
                tty_in = None
            if master_fd is not None:
                os.close(master_fd)
                master_fd = None
            if slave_fd is not None:
                os.close(slave_fd)
                slave_fd = None
            if err_master_fd is not None:
                os.close(err_master_fd)
                err_master_fd = None
            if err_slave_fd is not None:
                os.close(err_slave_fd)
                err_slave_fd = None

    step_lines = list(summary_obj.get("operation_steps") or [])
    use_progress = (
        not headless
        and not in_run_block()
        and sys.stdout.isatty()
        and get_setting("progress")[0] != "false"
        and bool(step_lines)
    )
    tmp_progress_path: Path | None = None
    progress_filter: _ProgressLineFilter | None = None
    if use_progress:
        tmp_progress_path = _prepare_progress_script(
            script_text, step_dir, step_lines, shell_bin, is_ps, work_dir
        )
        if tmp_progress_path is not None:
            step_map = {int(s["step"]): s for s in step_lines if s.get("step")}
            progress_filter = _ProgressLineFilter(step_map, len(step_lines))
            exec_cmd = (
                [shell_bin, "-NoProfile", "-File", str(tmp_progress_path)]
                if is_ps
                else [shell_bin, str(tmp_progress_path)]
            )

    bundle_file = sdir / "0"
    bundle_snapshot = bundle_file.read_bytes() if bundle_file.is_file() else None
    child_env = scrub_child_env({**os.environ, "IN_RUN_BLOCK": "1"}, sandbox_mode)
    exec_cmd = build_sandbox_exec(exec_cmd, work_dir=work_dir, base_dir=ensure_base(), sandbox_mode=sandbox_mode)
    exec_started = time.monotonic()
    try:
        if (
            master_fd is not None
            and slave_fd is not None
            and err_master_fd is not None
            and err_slave_fd is not None
        ):
            try:
                proc = subprocess.Popen(
                    exec_cmd,
                    cwd=work_dir,
                    stdin=tty_in if tty_in is not None else slave_fd,
                    stdout=slave_fd,
                    stderr=err_slave_fd,
                    env=child_env,
                    close_fds=True,
                )
                os.close(slave_fd)
                slave_fd = None
                os.close(err_slave_fd)
                err_slave_fd = None
                for is_err, text in _iter_child_streams(master_fd, err_master_fd):
                    _emit(text, is_err)
                rc = proc.wait()
            finally:
                if slave_fd is not None:
                    os.close(slave_fd)
                if err_slave_fd is not None:
                    os.close(err_slave_fd)
                if master_fd is not None:
                    os.close(master_fd)
                if err_master_fd is not None:
                    os.close(err_master_fd)
                if tty_in is not None:
                    tty_in.close()
        else:
            proc = subprocess.Popen(
                exec_cmd,
                cwd=work_dir,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=child_env,
            )
            assert proc.stdout is not None and proc.stderr is not None
            for is_err, text in _iter_child_streams(proc.stdout.fileno(), proc.stderr.fileno()):
                _emit(text, is_err)
            proc.stdout.close()
            proc.stderr.close()
            rc = proc.wait()
        duration_s = max(0.0, time.monotonic() - exec_started)
        if progress_filter is not None:
            rem_out, rem_prog = progress_filter.flush(rc=rc)
            if rem_out:
                log_chunks.append(rem_out)
                sys.stdout.write(rem_out)
                if not rem_out.endswith("\n"):
                    log_chunks.append("\n")
                    sys.stdout.write("\n")
            if rem_prog:
                sys.stdout.write(rem_prog)
            if rem_out or rem_prog:
                sys.stdout.flush()
    finally:
        if tmp_progress_path is not None:
            tmp_progress_path.unlink(missing_ok=True)
    if bundle_snapshot is not None:
        if not bundle_file.is_file() or bundle_file.read_bytes() != bundle_snapshot:
            write_private(bundle_file, bundle_snapshot.decode("utf-8", "replace"), overwrite=True)
            warn_msg = f"\n[{label}] SECURITY WARNING: block attempted to modify {bundle_file.name} (reverted)\n"
            log_chunks.append(warn_msg)
            sys.stdout.write(warn_msg)
            sys.stdout.flush()
    if log_chunks and not log_chunks[-1].endswith("\n"):
        log_chunks.append("\n")
        sys.stdout.write("\n")
    stdin_diag_lines: list[str] = []
    if rc != 0:
        clean_so_far = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks[1:]))).replace("\r\n", "\n")
        stdin_diag_lines = _resolve_python_stdin_tracebacks(label, script_text, clean_so_far)
        for diag in stdin_diag_lines:
            log_chunks.append(diag + "\n")
    dur_str = format_duration(duration_s)
    duration_ms = int(round(duration_s * 1000.0))
    op_timings = progress_filter.operation_timings() if progress_filter is not None else []
    failed_step = (
        progress_filter.active_step
        if (rc != 0 and progress_filter is not None)
        else None
    )
    write_step_meta(
        step_dir,
        duration_ms=duration_ms,
        exit_code=rc,
        operations=op_timings,
        failed_step=failed_step,
        renumbered_from=renumbered_from,
    )
    end_detail = f"exit {rc}, {dur_str}" if rc != 0 else dur_str
    end_line = f"\n[{label}] END ({end_detail})\n"
    if rc != 0 and footer_on_fail:
        end_line += footer_on_fail if footer_on_fail.endswith("\n") else footer_on_fail + "\n"
    log_chunks.append(end_line)
    full_output = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks))).replace("\r\n", "\n")
    write_private(out_path, full_output)
    err_path = step_dir / "err"
    err_text = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(err_chunks))).replace("\r\n", "\n")
    if err_text.strip():
        write_private(err_path, err_text, overwrite=True)
    else:
        err_path.unlink(missing_ok=True)
    clip_target = resolve_clipboard_target(out_path, full_output)
    if headless:
        if stdin_diag_lines:
            sys.stdout.write("".join(d + "\n" for d in stdin_diag_lines))
        sys.stdout.write(end_line)
        sys.stdout.flush()
    elif in_run_block() or not sys.stdout.isatty() or clipboard_mode() != "prompt" or clipboard_command(clip_target) is None:
        end_body = build_box_body_lines(
            clip_target,
            rc=rc,
            stats=stats_line(clip_target),
            label=label,
            sdir=sdir,
            duration_s=duration_s,
            op_timings=op_timings,
            failed_step=failed_step,
        )
        sys.stdout.write("\n" + format_info_box("END", end_body) + "\n")
        sys.stdout.flush()
    if not headless:
        offer_clipboard_copy(
            label,
            out_path,
            ok=(rc == 0),
            rc=rc,
            duration_s=duration_s,
            op_timings=op_timings,
            failed_step=failed_step,
            sdir=sdir,
        )
    return rc


TRAILING_FENCE_RE = re.compile(r"(?:\r?\n)+(?:RUN_(?:BLOCK|FIX)\s*)?`{3,}\s*$")
SPLIT_HEADER_RE = re.compile(
    r"^\s*(?:`{3,}[A-Za-z0-9_-]*\s*\n)?\s*(?:[A-Za-z0-9_./-]+\s+)?run_block\b[^\n]*<<\s*['\"]?(RUN_(?:BLOCK|FIX))['\"]?\s*$"
)
FENCE_LINE_RE = re.compile(r"^`{3,}[A-Za-z0-9_-]*\s*$")


def _reassemble_split_payload(payload: str) -> tuple[str, str | None]:
    """Reconstruct payloads split by chat Markdown fences when inner triple backticks appear."""
    norm = payload.replace("\r\n", "\n")
    lines = norm.split("\n")

    first_nonempty = -1
    for idx, line in enumerate(lines):
        if line.strip():
            first_nonempty = idx
            break
    if first_nonempty == -1:
        return payload, None

    header_line = lines[first_nonempty]
    m = SPLIT_HEADER_RE.match(header_line)
    if not m:
        cleaned = TRAILING_FENCE_RE.sub("", norm)
        c_lines = cleaned.split("\n")
        # Also strip orphan Markdown fence lines when the local shell consumed the outer
        # `run_block ... <<'RUN_BLOCK'` header before passing stdin.
        stripped_orphan = [ln for ln in c_lines if not FENCE_LINE_RE.match(ln)]
        joined_orphan = "\n".join(stripped_orphan)
        out = (joined_orphan + "\n") if joined_orphan and not joined_orphan.endswith("\n") else joined_orphan
        return out, None

    delim = m.group(1)
    body_lines = lines[first_nonempty + 1 :]
    end_idx = -1
    for idx in range(len(body_lines) - 1, -1, -1):
        stripped = body_lines[idx].strip()
        if stripped == delim or re.fullmatch(rf"{re.escape(delim)}\s*`{{3,}}", stripped):
            end_idx = idx
            break

    if end_idx == -1:
        return (
            payload,
            f"unclosed {delim} heredoc on stdin (missing closing '{delim}' terminator — check for split Markdown fences)",
        )

    inner = body_lines[:end_idx]
    rebuilt: list[str] = []
    i = 0
    while i < len(inner):
        cur = inner[i]
        # A split caused by inner triple backticks turns a single line or fence boundary into:
        #   <prefix>        (or standalone closing ```)
        #   ```<lang>       (chat UI reopening the next code block)
        # Strip standalone Markdown fence lines introduced by chat renderer splitting.
        if FENCE_LINE_RE.match(cur):
            i += 1
            continue
        rebuilt.append(cur)
        i += 1

    joined = "\n".join(rebuilt)
    out = (joined + "\n") if joined and not joined.endswith("\n") else joined
    return out, None


def cmd_normal(
    ref: str, payload: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    payload, split_err = _reassemble_split_payload(payload)
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, step = parse_ref(ref, allow_fix_step=False)
    step_num = int(step)
    if step_num < 1:
        raise SystemExit(f"{prog_name()}: step number must be >= 1")
    base = ensure_base()
    _warn_if_state_oversized(base)
    sdir = base / session
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_override)
    label = f"{session}/{step}"
    step_dir = _step_dir(sdir, step)
    script_path = _find_step_script(sdir, step)
    out_path = step_dir / "out"
    if split_err:
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: {split_err}", headless=headless)

    aborted_marker = step_dir / "aborted"
    renumbered_from: str | None = None

    overwrite = aborted_marker.exists()
    if overwrite:
        out_path.unlink(missing_ok=True)
        (step_dir / "meta.json").unlink(missing_ok=True)
        aborted_marker.unlink(missing_ok=True)
        for orig_p in (step_dir / "block.orig.sh", step_dir / "block.orig.ps1", step_dir / "out.orig"):
            orig_p.unlink(missing_ok=True)
    elif script_path.exists() or out_path.exists():
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            next_num = next_free_step(sdir, min_step=step_num + 1)
            next_label = f"{session}/{next_num}"
            existing_lines = [f"Next: {next_label}"]
            if script_path.exists():
                existing_lines.append(f"Script: {script_path}")
            if out_path.exists():
                existing_lines.append(f"Output: {out_path}")
            step_hdr = format_session_header_lines(
                label=label, sdir=sdir, sandbox_mode=sandbox_override
            )
            choice = prompt_yes_no_box(
                "STEP ALREADY EXISTS",
                [*step_hdr, "", *existing_lines],
                f"Step {label} already exists. r(enumber) to {next_label} or R(estart)?",
                default_yes=False,
                yes_status=f"✓ Overwriting {label}.",
                no_status=f"✗ Keeping existing {label}.",
                script_path=script_path if script_path.exists() else None,
                out_path=out_path if out_path.exists() else None,
                renumber_label=next_label,
                renumber_status=f"✓ Renumbering {label} -> {next_label}.",
            )
            if choice == "renumber":
                renumbered_from = label
                payload = _rewrite_script_step_header(payload, label, next_label)
                step = str(next_num)
                step_num = next_num
                label = next_label
                step_dir = _step_dir(sdir, step)
                script_path = _find_step_script(sdir, step)
                out_path = step_dir / "out"
                aborted_marker = step_dir / "aborted"
                overwrite = False
            elif choice:
                overwrite = True
                out_path.unlink(missing_ok=True)
                (step_dir / "meta.json").unlink(missing_ok=True)
                for orig_p in (step_dir / "block.orig.sh", step_dir / "block.orig.ps1", step_dir / "out.orig"):
                    orig_p.unlink(missing_ok=True)
            else:
                return 2
        if not overwrite and renumbered_from is None:
            return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: step already exists — output: {out_path}", headless=headless)
    if step_num > 1 and renumbered_from is None and not _find_step_script(sdir, str(step_num - 1)).exists():
        prev_label = f"{session}/{step_num - 1}"
        allow_skip = False
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            step_hdr = format_session_header_lines(
                label=label, sdir=sdir, sandbox_mode=sandbox_override
            )
            allow_skip = prompt_yes_no_box(
                "MISSING PREVIOUS STEP",
                [*step_hdr, "", f"Missing: {prev_label}"],
                f"Run {label} anyway?",
                default_yes=False,
                yes_status=f"✓ Proceeding with {label} (skipped {prev_label}).",
                no_status=f"✗ Canceled {label} (run {prev_label} first).",
            )
            if not allow_skip:
                return 2
        if not allow_skip:
            return not_run_exit(
                label,
                sdir,
                step,
                out_path,
                f"[{label}] NOT RUN: previous step {prev_label} has not been run yet",
                headless=headless,
            )
    if not payload.strip():
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: empty script on stdin", headless=headless)

    step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_private(script_path, payload, overwrite=overwrite)
    return run_script(
        label,
        script_path,
        out_path,
        cleanup_on_abort=[script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
        renumbered_from=renumbered_from,
    )


def cmd_fix(
    ref: str, fix_code: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    fix_code, split_err = _reassemble_split_payload(fix_code)
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, target = parse_ref(ref, allow_fix_step=True)
    target_ref = f"{session}/{target}"
    base_step = target.split("_", 1)[0]
    next_seq_ref = f"{session}/{int(base_step) + 1}"
    sdir = ensure_base() / session
    new_step = next_fix_step(target, sdir=sdir)
    label = f"{session}/{new_step}"
    new_step_dir = _step_dir(sdir, new_step)
    fix_path = new_step_dir / "fix.py"
    out_path = new_step_dir / "out"
    if split_err:
        return not_run_exit(
            label, sdir, new_step, out_path, f"[{label}] NOT RUN: {split_err}", headless=headless, fix_target=target_ref
        )

    chain = _find_fix_chain_scripts(sdir, base_step)
    if not chain:
        missing_script = _find_step_script(sdir, target)
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            f"[{label}] NOT RUN: target script {missing_script} does not exist",
            headless=headless,
            fix_target=target_ref,
        )

    max_attempts = int(get_setting("max_fix_attempts")[0])
    prior_failures = _consecutive_failed_fixes(sdir, base_step)
    if prior_failures >= max_attempts:
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            (
                f"[{label}] NOT RUN: STOP --fix — reached max consecutive failed --fix attempts "
                f"({prior_failures}/{max_attempts}) for {session}/{base_step}; "
                f"emit a fresh {next_seq_ref} block instead"
            ),
            headless=headless,
            fix_target=target_ref,
        )

    reach_limit = (prior_failures + 1) >= max_attempts
    stop_directive = (
        f"[{label}] STOP --fix: reached {prior_failures + 1}/{max_attempts} failed --fix attempts "
        f"for {session}/{base_step}; switch to a fresh {next_seq_ref} block instead."
    )

    def _fail_not_run(reason: str) -> int:
        msg = f"[{label}] NOT RUN: {reason}"
        if reach_limit:
            msg += f"\n{stop_directive}"
        return not_run_exit(label, sdir, new_step, out_path, msg, headless=headless, fix_target=target_ref)

    if not fix_code.strip():
        return _fail_not_run("empty fix on stdin")

    ast_ok, ast_err = validate_fix_ast(fix_code)
    if not ast_ok:
        return _fail_not_run(f"unsafe construct in --fix ({ast_err})")

    direct_script = _find_step_script(sdir, target)
    if direct_script.is_file():
        primary = (target, direct_script)
    else:
        primary = chain[-1]

    candidates: list[tuple[str, Path]] = [primary]
    for cand_step, cand_path in reversed(chain):
        if all(cand_step != c[0] for c in candidates):
            candidates.append((cand_step, cand_path))

    chosen_step: str | None = None
    chosen_script: Path | None = None
    chosen_orig: str = ""
    chosen_new: str = ""
    primary_err: str | None = None

    for idx, (cand_step, cand_script) in enumerate(candidates):
        cand_orig = cand_script.read_text(encoding="utf-8")
        ns: dict[str, object] = {
            "__builtins__": dict(SAFE_FIX_BUILTINS),
            "text": cand_orig,
            "re": re,
        }
        try:
            exec(compile(fix_code, str(fix_path), "exec"), ns)
        except Exception as exc:
            if idx == 0:
                primary_err = _format_fix_exception(exc, fix_code, fix_path, ns)
            continue
        cand_new = ns.get("text")
        if not isinstance(cand_new, str):
            if idx == 0:
                primary_err = "fix did not leave a string in 'text'"
            continue
        if cand_new == cand_orig:
            if idx == 0:
                primary_err = f"fix made no changes to {cand_script}"
            continue
        chosen_step = cand_step
        chosen_script = cand_script
        chosen_orig = cand_orig
        chosen_new = cand_new
        break

    if chosen_step is None or chosen_script is None:
        return _fail_not_run(primary_err or f"fix made no changes to {primary[1]}")

    ext = chosen_script.suffix or _script_ext()
    new_step_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    script_path = new_step_dir / f"block{ext}"
    write_private(fix_path, fix_code)
    write_private(script_path, chosen_new)
    diff = "".join(
        difflib.unified_diff(
            chosen_orig.splitlines(keepends=True),
            chosen_new.splitlines(keepends=True),
            fromfile=f"{chosen_step}/{chosen_script.name}",
            tofile=f"{new_step}/block{ext}",
        )
    )
    header = [f"[{label}] patched {chosen_step}/{chosen_script.name} -> {new_step}/block{ext}:\n", diff]
    return run_script(
        label,
        script_path,
        out_path,
        header_lines=header,
        cleanup_on_abort=[fix_path, script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
        footer_on_fail=stop_directive if reach_limit else None,
    )


def _step_sort_key(stem: str) -> tuple[int, int]:
    if "_" in stem:
        b, s = stem.split("_", 1)
        return (int(b) if b.isdigit() else 0, int(s) if s.isdigit() else 0)
    return (int(stem) if stem.isdigit() else 0, 0)


def _step_status(sdir: Path, stem: str) -> str:
    step_d = _step_dir(sdir, stem)
    if (step_d / "aborted").exists():
        return "ABORTED"
    for candidate in (step_d / "out", step_d / "error"):
        if candidate.is_file():
            txt = candidate.read_text(encoding="utf-8", errors="replace")
            label = f"{sdir.name}/{stem}"
            matches = re.findall(rf"^\[{re.escape(label)}\]\s+(END|SUCCESS|FAILED|NOT RUN)([^\n]*)", txt, flags=re.MULTILINE)
            if matches:
                kind, rest = matches[-1]
                return (kind + rest.split("—")[0]).strip()
            return "DONE"
    return "SAVED"


def _find_latest_step(session: str | None = None) -> tuple[str, str]:
    base = ensure_base()
    if session:
        sdirs = [base / session] if (base / session).is_dir() else []
    else:
        sdirs = sorted(
            [p for p in base.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    for sdir in sdirs:
        scripts = [p.parent.name for p in _iter_session_scripts(sdir)]
        if scripts:
            return sdir.name, scripts[-1]
    raise SystemExit(f"{prog_name()}: no saved blocks found in {base}")


def cmd_list(session: str | None = None) -> int:
    base = ensure_base()
    _warn_if_state_oversized(base)
    if not session:
        sdirs = sorted([p for p in base.iterdir() if p.is_dir()], key=lambda p: (_session_mtime(p), p.name))
        if not sdirs:
            sys.stdout.write(f"No sessions in {base} (0 B)\n")
            return 0
        sys.stdout.write(f"Sessions in {base}:\n")
        total_bytes = 0
        for sdir in sdirs:
            scripts = [p.parent.name for p in _iter_session_scripts(sdir)]
            has_bundle = (sdir / "0").is_file()
            sz = _dir_size_bytes(sdir)
            total_bytes += sz
            if scripts:
                last = f"{sdir.name}/{scripts[-1]} ({_step_status(sdir, scripts[-1])})"
            elif has_bundle:
                last = f"{sdir.name}/0 (BUNDLE)"
            else:
                last = "empty"
            sys.stdout.write(f"  {sdir.name:<8}  {len(scripts):>3} block(s)  {_human_size(sz):>9}   last: {last}\n")
        sys.stdout.write(f"Total storage: {_human_size(total_bytes)} ({len(sdirs)} session(s))\n")
        session = sdirs[-1].name
        sys.stdout.write(f"\nRecent blocks in {session}:\n")
    else:
        sdir = base / session
        if not sdir.is_dir():
            raise SystemExit(f"{prog_name()}: session {session!r} not found in {base}")
        sys.stdout.write(f"Blocks in {session} ({_human_size(_dir_size_bytes(sdir))}):\n")
    sdir = base / session
    if (sdir / "0").is_file():
        ref0 = f"{session}/0"
        sys.stdout.write(f"  {ref0:<10}  {'BUNDLE':<24}  Session context bundle (0)\n")
    script_paths = _iter_session_scripts(sdir)
    for sp in script_paths[-15:]:
        stem = sp.parent.name
        st = _step_status(sdir, stem)
        sh_text = sp.read_text(encoding="utf-8", errors="replace")
        summary = summarize_script_actions(sh_text, work_dir=get_work_dir(sdir))
        rows = summary.get("rows") or []
        desc = "; ".join(f"{k}: {v}" for k, v in rows[:2]) if rows else ""
        if len(desc) > 56:
            desc = desc[:53] + "..."
        ref = f"{session}/{stem}"
        sys.stdout.write(f"  {ref:<10}  {st:<24}  {desc}\n")
    return 0


def cmd_show(ref: str | None = None) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    if step == "0":
        bundle_path = sdir / "0"
        if bundle_path.is_file():
            orig_bundle = _orig_file_backup_path(bundle_path)
            b_suffix = f" (edited) (original: {orig_bundle})" if orig_bundle.is_file() else ""
            sys.stdout.write(f"=== [{session}/0] Bundle: {bundle_path}{b_suffix} ===\n")
            sys.stdout.write(bundle_path.read_text(encoding="utf-8", errors="replace"))
            return 0
        raise SystemExit(f"{prog_name()}: bundle {session}/0 not found ({bundle_path})")
    step_dir = _step_dir(sdir, step)
    script_path = _find_step_script(sdir, step)
    out_path = step_dir / "out"
    err_path = step_dir / "error"
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    orig_path = _orig_backup_path(script_path)
    status_str = _step_status(sdir, step)
    script_edited = f" (edited) (original: {orig_path})" if orig_path.is_file() else ""
    sys.stdout.write(f"=== [{session}/{step}] Script: {script_path} ({status_str}){script_edited} ===\n")
    sys.stdout.write(script_path.read_text(encoding="utf-8", errors="replace"))
    if out_path.is_file():
        out_orig = _orig_file_backup_path(out_path)
        out_edited = f" (edited) (original: {out_orig})" if out_orig.is_file() else ""
        sys.stdout.write(f"\n=== [{session}/{step}] Output: {out_path}{out_edited} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
    if err_path.is_file():
        sys.stdout.write(f"\n=== [{session}/{step}] Error: {err_path} ===\n")
        sys.stdout.write(err_path.read_text(encoding="utf-8", errors="replace"))
    return 0


def cmd_retry(
    ref: str | None = None, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
